<view class="ranking-board">
  <view class="page-header">
    <view class="page-title-group">
      <text class="page-title">{{heading}}</text>
      <text class="page-subtitle">{{subtitle}}</text>
    </view>
    <view class="ranking-progress" aria-label="排行进度">
      <text class="ranking-progress__value">{{rankedCount}}/{{totalCount}}</text>
      <text class="ranking-progress__label">已排</text>
      <view class="ranking-progress__track"><view class="ranking-progress__fill" style="width:{{progressPercent}}%"></view></view>
    </view>
  </view>

  <view class="title-card">
    <input class="title-input" value="{{rankingTitle}}" maxlength="24" confirm-type="done" bindinput="onTitleInput" />
    <text class="title-hint">给这张榜单取个标题</text>
  </view>

  <view class="tier-list">
    <view
      wx:for="{{tiers}}"
      wx:key="id"
      class="tier-row tier-row--{{item.id}} ranking-drop-zone {{dragOverTierId === item.id ? 'tier-row--over' : ''}}"
      data-drop-tier="{{item.id}}"
    >
      <view class="tier-label" style="background:{{item.color}}">
        <text class="tier-label__main">{{item.label}}</text>
        <text class="tier-label__count">{{item.items.length}} 部</text>
      </view>
      <scroll-view class="tier-items" scroll-x="{{!dragItemId}}" enhanced show-scrollbar="{{false}}">
        <view class="tier-items__inner">
          <view wx:if="{{!item.items.length}}" class="tier-placeholder">长按封面拖到这里</view>
          <view
            wx:for="{{item.items}}"
            wx:for-item="coverItem"
            wx:key="id"
            class="tier-cover {{dragItemId === coverItem.id ? 'tier-cover--dragging' : ''}}"
            data-id="{{coverItem.id}}"
            bindtap="onRankedItemTap"
            bind:longpress="onDragStart"
            bind:touchmove="onDragMove"
            bind:touchend="onDragEnd"
            bind:touchcancel="onDragCancel"
          >
            <image
              wx:if="{{coverItem.cover && !coverErrorIds[coverItem.id]}}"
              class="tier-cover__image"
              src="{{coverItem.cover}}"
              mode="aspectFill"
              lazy-load
              data-id="{{coverItem.id}}"
              binderror="onCoverError"
            />
            <view wx:else class="tier-cover__image tier-cover__image--fallback" style="background:{{coverItem.coverFallback.color}}">{{coverItem.coverFallback.char}}</view>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{item.items.length > ui.scrollHintThreshold}}" class="tier-scroll-hint" aria-hidden="true">→</view>
    </view>
  </view>

  <view class="pool-card ranking-drop-zone {{dragOverTierId === '__pool__' ? 'pool-card--over' : ''}}" data-drop-tier="__pool__">
    <view class="section-heading">
      <view>
        <text class="section-title">待排番剧</text>
        <text class="section-caption">{{unrankedItems.length}} 部 · 横向滑动浏览，长按拖入档位</text>
      </view>
      <text class="section-hint">点封面可查看番名</text>
    </view>
    <view wx:if="{{unrankedItems.length > ui.scrollHintThreshold}}" class="pool-scroll-hint" aria-hidden="true">
      <text class="pool-scroll-hint__fade"></text><text class="pool-scroll-hint__arrow">→</text><text>左右滑动</text>
    </view>
    <scroll-view wx:if="{{unrankedItems.length}}" class="pool-strip" scroll-x="{{!dragItemId}}" enhanced show-scrollbar="{{false}}">
      <view class="pool-strip__inner">
        <view
          wx:for="{{unrankedItems}}"
          wx:key="id"
          class="pool-cover {{dragItemId === item.id ? 'pool-cover--dragging' : ''}}"
          data-id="{{item.id}}"
          bindtap="onRankedItemTap"
          bind:longpress="onDragStart"
          bind:touchmove="onDragMove"
          bind:touchend="onDragEnd"
          bind:touchcancel="onDragCancel"
        >
          <image
            wx:if="{{item.cover && !coverErrorIds[item.id]}}"
            class="pool-cover__image"
            src="{{item.cover}}"
            mode="aspectFill"
            lazy-load
            data-id="{{item.id}}"
            binderror="onCoverError"
          />
          <view wx:else class="pool-cover__image pool-cover__image--fallback" style="background:{{item.coverFallback.color}}">{{item.coverFallback.char}}</view>
        </view>
      </view>
    </scroll-view>
    <text wx:else class="pool-empty">所有番剧都已放入档位，长按封面仍可换档</text>
  </view>

  <view wx:if="{{dragHint}}" class="drag-hint">{{dragHint}}</view>

  <view class="bottom-actions">
    <button class="outline-button" bindtap="onClear">清空档位</button>
    <button class="primary-button" bindtap="onExport">导出排行图</button>
  </view>

  <view wx:if="{{selectedItem}}" class="picker-mask" catchtap="onClosePicker">
    <view class="picker-sheet" catchtap="preventTap">
      <view class="picker-sheet__head">
        <view class="picker-preview">
          <image
            wx:if="{{selectedItem.cover && !coverErrorIds[selectedItem.id]}}"
            class="picker-preview__image"
            src="{{selectedItem.cover}}"
            mode="aspectFill"
            lazy-load
            data-id="{{selectedItem.id}}"
            binderror="onCoverError"
          />
          <view wx:else class="picker-preview__image picker-preview__image--fallback" style="background:{{selectedItem.coverFallback.color}}">{{selectedItem.coverFallback.char}}</view>
        </view>
        <view class="picker-name-group">
          <text class="picker-name">{{selectedItem.name}}</text>
          <text class="picker-hint">当前：{{selectedTierLabel}} · 选择要放入的档位</text>
        </view>
        <text class="picker-close" catchtap="onClosePicker">×</text>
      </view>
      <view class="picker-options">
        <view wx:for="{{tiers}}" wx:key="id" class="picker-option picker-option--{{item.id}} {{selectedItem.tierId === item.id ? 'picker-option--selected' : ''}}" data-tier-id="{{item.id}}" bindtap="onChooseTier">
          <text>{{item.label}}</text><text class="picker-option__count">{{item.items.length}} 部</text>
        </view>
        <view class="picker-option picker-option--pool {{!selectedItem.tierId ? 'picker-option--selected' : ''}}" data-tier-id="" bindtap="onChooseTier">
          <view class="picker-option__name"><text>待排区</text><text class="picker-option__subname">移回待排区</text></view><text class="picker-option__count">{{unrankedItems.length}} 部</text>
        </view>
      </view>
    </view>
  </view>
</view>

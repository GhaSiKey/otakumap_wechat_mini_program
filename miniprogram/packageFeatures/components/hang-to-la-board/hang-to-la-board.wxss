.ranking-board { color: #11295c; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
.page-header, .section-heading, .bottom-actions, .picker-sheet__head { display: flex; align-items: center; }
.page-header { margin-bottom: 16rpx; }
.page-title-group { flex: 1; min-width: 0; }
.page-title { display: block; font-size: 38rpx; font-weight: 700; letter-spacing: 1rpx; }
.page-subtitle { display: block; margin-top: 4rpx; color: #66708a; font-size: 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ranking-progress { flex: 0 0 auto; margin-left: 12rpx; text-align: right; }
.ranking-progress__value { display: block; color: #11295c; font-size: 25rpx; font-weight: 700; line-height: 1.1; }
.ranking-progress__label { display: block; margin-top: 3rpx; color: #8b93a5; font-size: 17rpx; }
.ranking-progress__track { width: 84rpx; height: 5rpx; margin-top: 6rpx; overflow: hidden; border-radius: 999rpx; background: #dce7fb; }
.ranking-progress__fill { height: 100%; border-radius: inherit; background: #477bd9; transition: width 180ms ease; }
.title-card, .pool-card, .tier-row { border: 1rpx solid rgba(17,41,92,.08); border-radius: 20rpx; box-sizing: border-box; box-shadow: 0 10rpx 26rpx rgba(17,41,92,.07); }
.title-card { margin-bottom: 14rpx; padding: 13rpx 20rpx 11rpx; background: rgba(255,255,255,.88); }
.title-input { height: 52rpx; color: #11295c; font-size: 29rpx; font-weight: 700; }
.title-hint { display: block; margin-top: 2rpx; color: #9ba3b8; font-size: 18rpx; }
.tier-list { display: flex; flex-direction: column; gap: 10rpx; }
.tier-row { position: relative; min-height: 116rpx; display: flex; overflow: hidden; border: 2rpx solid transparent; background: rgba(255,255,255,.86); transition: border-color 160ms ease, transform 160ms ease; }
.tier-row--over { border-color: #477bd9; transform: translateY(-2rpx); }
.tier-scroll-hint { position: absolute; z-index: 2; top: 0; right: 0; bottom: 0; width: 40rpx; display: flex; align-items: center; justify-content: center; color: rgba(71,123,217,.78); font-size: 28rpx; pointer-events: none; background: linear-gradient(90deg, transparent, rgba(248,247,243,.9) 65%); }
.tier-label { width: 112rpx; min-height: 116rpx; flex-shrink: 0; padding: 14rpx 12rpx; box-sizing: border-box; color: #fff; display: flex; flex-direction: column; justify-content: center; }
.tier-label__main { font-size: 28rpx; font-weight: 700; }.tier-label__count { margin-top: 5rpx; opacity: .82; font-size: 18rpx; }
.tier-items { flex: 1; height: 116rpx; min-width: 0; }.tier-items__inner { height: 100%; min-width: 100%; padding: 10rpx 14rpx; box-sizing: border-box; display: flex; align-items: center; gap: 10rpx; white-space: nowrap; }.tier-placeholder { color: #a7afbf; font-size: 19rpx; white-space: nowrap; }
.tier-row--hang .tier-items { background: #fff3f0; }.tier-row--top .tier-items { background: #fffaf0; }.tier-row--human .tier-items { background: #f1f5ff; }.tier-row--npc .tier-items { background: #f7f5ff; }.tier-row--la .tier-items { background: #f3f4f7; }
.tier-cover, .pool-cover { flex: 0 0 auto; overflow: hidden; border: 2rpx solid rgba(17,41,92,.13); border-radius: 13rpx; background: #fff; box-shadow: 0 4rpx 9rpx rgba(17,41,92,.12); transition: opacity 120ms ease, transform 120ms ease; }.tier-cover { width: 70rpx; height: 92rpx; }.pool-cover { width: 70rpx; height: 92rpx; }.tier-cover--dragging, .pool-cover--dragging { opacity: .42; transform: scale(.94); }.tier-cover__image, .pool-cover__image { width: 100%; height: 100%; display: block; }
.tier-cover__image--fallback, .pool-cover__image--fallback, .picker-preview__image--fallback { display: flex; align-items: center; justify-content: center; color: #fff; font-size: 27rpx; font-weight: 700; }
.pool-card { margin-top: 14rpx; padding: 16rpx 18rpx 14rpx; background: rgba(255,255,255,.88); }.pool-card--over { border-color: #477bd9; box-shadow: 0 0 0 4rpx rgba(71,123,217,.12), 0 10rpx 26rpx rgba(17,41,92,.1); transform: translateY(-2rpx); }
.drag-hint { position: fixed; z-index: 25; right: 50%; bottom: calc(88rpx + env(safe-area-inset-bottom) + 10rpx); transform: translateX(50%); padding: 8rpx 18rpx; border-radius: 999rpx; color: #fff; font-size: 18rpx; white-space: nowrap; background: rgba(17,41,92,.88); box-shadow: 0 6rpx 18rpx rgba(17,41,92,.2); pointer-events: none; }
.section-heading { justify-content: space-between; margin-bottom: 10rpx; }.section-title { display: block; font-size: 27rpx; font-weight: 700; }.section-caption, .section-hint { display: block; margin-top: 4rpx; color: #8b93a5; font-size: 18rpx; }.section-hint { margin-top: 0; margin-left: 12rpx; white-space: nowrap; }
.pool-scroll-hint { height: 26rpx; display: flex; align-items: center; justify-content: flex-end; gap: 5rpx; color: #8b93a5; font-size: 17rpx; }.pool-scroll-hint__fade { width: 46rpx; height: 20rpx; margin-right: -20rpx; border-radius: 50%; background: linear-gradient(90deg, transparent, rgba(242,118,112,.22)); }.pool-scroll-hint__arrow { color: #f27670; font-size: 27rpx; line-height: 1; }.pool-strip { width: 100%; height: 98rpx; }.pool-strip__inner { height: 100%; min-width: 100%; padding: 2rpx 2rpx 4rpx; box-sizing: border-box; display: flex; align-items: center; gap: 10rpx; white-space: nowrap; }.pool-empty { display: block; padding: 10rpx 0 2rpx; color: #9ba3b8; font-size: 19rpx; text-align: center; }
.bottom-actions { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; gap: 12rpx; padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(17,41,92,.08); background: rgba(248,247,243,.96); backdrop-filter: blur(12px); }.outline-button, .primary-button { flex: 1; height: 64rpx; margin: 0; border-radius: 17rpx; display: flex; align-items: center; justify-content: center; font-size: 23rpx; line-height: 1; }.outline-button { color: #66708a; border: 1rpx solid rgba(17,41,92,.12); background: rgba(255,255,255,.8); }.primary-button { color: #fff; border: 0; background: #f27670; box-shadow: 0 8rpx 18rpx rgba(242,118,112,.22); }
.picker-mask { position: fixed; z-index: 30; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(12,18,35,.48); }.picker-sheet { width: 100%; padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 26rpx 26rpx 0 0; background: #fff; box-shadow: 0 -8rpx 30rpx rgba(17,41,92,.2); }.picker-sheet__head { align-items: center; }.picker-preview { width: 76rpx; height: 96rpx; flex: 0 0 auto; overflow: hidden; border-radius: 12rpx; box-shadow: 0 4rpx 10rpx rgba(17,41,92,.12); }.picker-preview__image { width: 100%; height: 100%; display: block; }.picker-name-group { flex: 1; min-width: 0; margin-left: 16rpx; }.picker-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #11295c; font-size: 27rpx; font-weight: 700; }.picker-hint { display: block; margin-top: 6rpx; color: #8b93a5; font-size: 19rpx; }.picker-close { width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; color: #8b93a5; font-size: 42rpx; font-weight: 300; }
.picker-options { margin-top: 18rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }.picker-option { min-height: 60rpx; padding: 0 14rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: space-between; color: #253456; font-size: 21rpx; }.picker-option__count { color: rgba(37,52,86,.58); font-size: 18rpx; }.picker-option--selected { box-shadow: inset 0 0 0 3rpx rgba(71,123,217,.7); font-weight: 700; }.picker-option__name { display: flex; flex-direction: column; }.picker-option__subname { margin-top: 3rpx; color: #7f8ba4 !important; font-size: 16rpx !important; font-weight: 400; }.picker-option--hang { background: #fff0ed; }.picker-option--top { background: #fff7df; }.picker-option--human { background: #edf3ff; }.picker-option--npc { background: #f1edff; }.picker-option--la, .picker-option--pool { background: #edf0f5; }
.outline-button::after, .primary-button::after { border: none; }
@media (prefers-color-scheme: dark) {
  .ranking-board { color: #f4f7ff; }.page-subtitle, .section-caption, .section-hint, .title-hint, .pool-empty, .tier-placeholder { color: rgba(255,255,255,.56); }.title-card, .pool-card, .tier-row { border-color: rgba(255,255,255,.1); background: #171d2c; }.title-input, .picker-name { color: #f4f7ff; }.ranking-progress__value { color: #f4f7ff; }.ranking-progress__track { background: rgba(154,181,237,.24); }.ranking-progress__fill { background: #9ab5ed; }.tier-row--hang .tier-items { background: #30232d; }.tier-row--top .tier-items { background: #332c22; }.tier-row--human .tier-items { background: #202b46; }.tier-row--npc .tier-items { background: #2b2740; }.tier-row--la .tier-items { background: #252934; }.tier-cover, .pool-cover { border-color: rgba(255,255,255,.18); }.tier-scroll-hint { color: rgba(154,181,237,.88); background: linear-gradient(90deg, transparent, rgba(23,29,44,.94) 65%); }.drag-hint { background: rgba(244,247,255,.94); color: #11295c; }.bottom-actions { border-color: rgba(255,255,255,.1); background: rgba(0,0,0,.94); }.outline-button { color: rgba(255,255,255,.74); border-color: rgba(255,255,255,.14); background: #171d2c; }.picker-sheet { background: #171d2c; }.picker-close { color: rgba(255,255,255,.58); }.picker-option { color: #eff4ff; }.picker-option__count { color: rgba(255,255,255,.56); }.picker-option__subname { color: rgba(255,255,255,.52) !important; }.picker-option--hang { background: #3c2930; }.picker-option--top { background: #3d3426; }.picker-option--human { background: #243252; }.picker-option--npc { background: #322d4c; }.picker-option--la, .picker-option--pool { background: #292e3a; }
}

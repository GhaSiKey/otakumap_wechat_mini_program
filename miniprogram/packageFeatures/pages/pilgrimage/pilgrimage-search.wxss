.pilgrimage-search-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--td-bg-color-page);
}

.discovery-hero {
  position: relative;
  height: 240rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--pilgrimage-sky-surface);
}

.discovery-hero__image,
.discovery-hero__fade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.discovery-hero__image {
  opacity: var(--pilgrimage-hero-image-opacity);
}

.discovery-hero__fade {
  background: var(--pilgrimage-hero-fade);
}

.discovery-hero__copy {
  position: relative;
  z-index: 1;
  width: 76%;
  padding: 44rpx 0 0 28rpx;
}

.discovery-hero__title {
  white-space: nowrap;
  font-size: 34rpx;
  line-height: 1.38;
  font-weight: 700;
  color: var(--pilgrimage-hero-text);
}

.discovery-hero__subtitle {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--td-text-color-secondary);
}

.search-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 24rpx 0 0;
  padding: 6rpx;
  border-radius: 20rpx;
  background: var(--td-bg-color-container);
  box-shadow: var(--td-shadow-2);
}

.search-box__input {
  flex: 1 1 auto;
  min-width: 0;
}

.search-box__input t-search {
  display: block;
  width: 100%;
}

.search-box__submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 80rpx;
  flex: 0 0 132rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  color: #fff;
  background: var(--td-brand-color);
  box-shadow: 0 6rpx 16rpx rgba(0, 82, 217, 0.18);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.search-box__submit--hover {
  background: var(--td-brand-color-active);
  transform: scale(0.98);
}

.search-box__submit .t-icon {
  flex-shrink: 0;
  margin-right: 4rpx;
}

@media screen and (max-width: 340px) {
  .search-box {
    gap: 4rpx;
    padding: 4rpx;
  }

  .search-box__submit {
    width: 116rpx;
    flex-basis: 116rpx;
    padding: 0 10rpx;
    font-size: 24rpx;
  }
}

.subject-section,
.result-section {
  margin-top: 32rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 14rpx;
  padding: 0 6rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--td-text-color-primary);
}

.section-caption {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--td-text-color-placeholder);
}

.section-count,
.cache-note {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--td-text-color-brand);
}

.subject-rail,
.recent-rail {
  width: 100%;
  white-space: nowrap;
}

.subject-card {
  display: inline-block;
  width: 184rpx;
  margin-right: 16rpx;
  vertical-align: top;
}

.subject-card:last-child,
.recent-item:last-child {
  margin-right: 0;
}

.subject-card__poster-wrap {
  position: relative;
  height: 246rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: var(--pilgrimage-sky-surface);
}

.subject-card__poster,
.subject-card__fallback {
  width: 100%;
  height: 100%;
}

.subject-card__fallback,
.recent-item__fallback,
.result-item__fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pilgrimage-hero-text);
  background: var(--pilgrimage-sky-surface);
  font-weight: 700;
}

.subject-card__fallback {
  font-size: 48rpx;
}

.subject-card__favorite {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: var(--pilgrimage-favorite-color);
  background: var(--pilgrimage-map-control-bg);
  box-shadow: var(--pilgrimage-map-control-shadow);
}

.subject-card__name {
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 25rpx;
  line-height: 1.4;
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.subject-card__meta {
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 21rpx;
  color: var(--td-text-color-placeholder);
}

.recent-item {
  display: inline-flex;
  align-items: center;
  width: 272rpx;
  padding: 12rpx;
  margin-right: 12rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: 18rpx;
  background: var(--td-bg-color-container);
  vertical-align: top;
}

.recent-item__poster,
.recent-item__fallback {
  width: 64rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
}

.recent-item__fallback {
  font-size: 28rpx;
}

.recent-item__name {
  margin-left: 14rpx;
  overflow: hidden;
  white-space: normal;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.state-box {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  padding: 24rpx;
}

.state-box--empty {
  min-height: 260rpx;
}

.initial-guide {
  padding: 48rpx 32rpx;
  text-align: center;
  border: 1rpx dashed var(--pilgrimage-sky-border);
  border-radius: 22rpx;
  background: var(--pilgrimage-sky-surface);
}

.initial-guide__icon {
  color: var(--td-text-color-brand);
}

.initial-guide__title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--td-text-color-primary);
}

.initial-guide__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--td-text-color-secondary);
}

.result-list {
  overflow: hidden;
  border-radius: 18rpx;
  background: var(--td-bg-color-container);
}

.result-item {
  display: flex;
  align-items: center;
  min-height: 136rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--td-border-level-1-color);
  transition: opacity 0.16s ease, background-color 0.16s ease;
}

.result-item:last-child {
  border-bottom: 0;
}

.result-item:active {
  background: var(--td-bg-color-container-active);
}

.result-item--loading {
  opacity: 0.66;
}

.result-item__cover,
.result-item__fallback {
  width: 82rpx;
  height: 110rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
}

.result-item__fallback {
  font-size: 31rpx;
}

.result-item__content {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.result-item__name {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 27rpx;
  line-height: 1.4;
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.result-item__meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--td-text-color-placeholder);
}

.result-item__hint {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--td-text-color-brand);
}

.result-item__action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  flex-shrink: 0;
  color: var(--td-text-color-placeholder);
}

.source-footnote {
  margin-top: 32rpx;
  padding: 0 24rpx;
  text-align: center;
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--td-text-color-placeholder);
}

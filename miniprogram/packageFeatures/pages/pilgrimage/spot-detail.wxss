.spot-detail-page {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--td-bg-color-page);
}

.detail-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.detail-state--message {
  flex-direction: column;
  padding: 40rpx;
  box-sizing: border-box;
}

.detail-state__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.media-frame {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--td-bg-color-component);
}

.media-frame--compact {
  height: 248rpx;
}

.media-frame__image {
  display: block;
  width: 100%;
  height: 100%;
}

.media-frame__status {
  position: absolute;
  inset: 0;
}

.media-frame__loading,
.media-frame__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--pilgrimage-sky-surface);
}

.media-frame__empty {
  flex-direction: column;
  gap: 18rpx;
  font-size: 24rpx;
  color: var(--td-text-color-placeholder);
}

.media-frame__empty--error {
  color: var(--td-text-color-secondary);
}

.media-frame__preview {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--td-text-color-primary);
  background: var(--pilgrimage-map-control-bg);
  box-shadow: var(--pilgrimage-map-control-shadow);
}

.place-intro {
  padding: 26rpx 10rpx 20rpx;
  border-bottom: 1rpx solid var(--td-border-level-1-color);
}

.place-intro__name {
  font-size: 38rpx;
  line-height: 1.32;
  font-weight: 700;
  color: var(--td-text-color-primary);
}

.place-intro__original {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
}

.place-meta {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--td-text-color-secondary);
}

.place-meta--accent {
  color: var(--td-text-color-brand);
}

.place-meta__divider {
  color: var(--td-text-color-placeholder);
}

.source-panel,
.etiquette-panel {
  display: flex;
  align-items: center;
  padding: 18rpx;
  margin-top: 18rpx;
  border: 1rpx solid var(--pilgrimage-sky-border);
  border-radius: 20rpx;
  background: var(--pilgrimage-sky-surface);
}

.source-panel__icon,
.etiquette-panel__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 50%;
  color: var(--td-text-color-brand);
  background: var(--td-brand-color-light);
}

.source-panel__content {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.source-panel__label {
  font-size: 21rpx;
  color: var(--td-text-color-placeholder);
}

.source-panel__name {
  margin-top: 3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.source-panel__copy {
  display: flex;
  align-items: center;
  gap: 7rpx;
  flex-shrink: 0;
  margin-left: 14rpx;
  font-size: 23rpx;
  color: var(--td-text-color-link);
}

.detail-actions {
  display: flex;
  flex-direction: column;
  width: 100%;
  margin-top: 20rpx;
}

.detail-actions__primary {
  display: block;
  width: 100%;
}

.detail-actions__button {
  width: 100%;
}

.detail-actions__back {
  display: flex;
  align-items: center;
  align-self: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 64rpx;
  padding: 0 24rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--td-text-color-link);
}

.etiquette-panel {
  align-items: flex-start;
}

.etiquette-panel__icon {
  margin-right: 16rpx;
}

.etiquette-panel__title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--td-text-color-primary);
}

.etiquette-panel__text {
  margin-top: 7rpx;
  font-size: 23rpx;
  line-height: 1.58;
  color: var(--td-text-color-secondary);
}

.same-episode {
  margin-top: 28rpx;
}

.same-episode__heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 14rpx;
}

.same-episode__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--td-text-color-primary);
}

.same-episode__count {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder);
}

.same-episode__rail {
  width: 100%;
  white-space: nowrap;
}

.same-card {
  display: inline-block;
  width: 232rpx;
  margin-right: 18rpx;
  overflow: hidden;
  vertical-align: top;
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: 18rpx;
  background: var(--td-bg-color-container);
}

.same-card:last-child {
  margin-right: 0;
}

.same-card__image {
  width: 100%;
  height: 136rpx;
  background: var(--td-bg-color-component);
}

.same-card__image--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--td-text-color-placeholder);
}

.same-card__name {
  margin: 12rpx 12rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.same-card__time {
  margin: 6rpx 12rpx 14rpx;
  font-size: 22rpx;
  color: var(--td-text-color-brand);
}

.detail-footnote {
  padding: 28rpx 20rpx 0;
  text-align: center;
  font-size: 21rpx;
  line-height: 1.6;
  color: var(--td-text-color-placeholder);
}

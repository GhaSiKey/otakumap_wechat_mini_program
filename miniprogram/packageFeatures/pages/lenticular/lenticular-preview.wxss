.preview-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fullscreen-image {
  width: 100%;
  height: 100%;
}

/* ─── 光栅双图叠加 ─── */
.lenticular-stack {
  position: relative;
  width: 100%;
  height: 100%;
}

.lenticular-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.lenticular-front {
  z-index: 1;
}

/* 返回按钮 */
.back-btn {
  position: fixed;
  /* top 由 JS 动态设置，与胶囊按钮对齐 */
  left: 24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

/* 调试指示器 */
.debug-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 5;
}

.debug-ball-container {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200rpx;
  height: 200rpx;
  margin-left: -100rpx;
  margin-top: -100rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
}

.debug-ball {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24rpx;
  height: 24rpx;
  margin-left: -12rpx;
  margin-top: -12rpx;
  background: #07c160;
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(7, 193, 96, 0.6);
  transition: transform 50ms linear;
}

.debug-text {
  position: absolute;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
  font-family: monospace;
  background: rgba(0, 0, 0, 0.5);
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  white-space: pre-line;
}

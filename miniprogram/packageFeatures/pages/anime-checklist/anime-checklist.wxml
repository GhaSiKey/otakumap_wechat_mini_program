<view class="page">
  <view class="hero-card">
    <view class="hero-copy">
      <text class="eyebrow">MY WATCHLIST</text>
      <text class="hero-title">番剧追踪</text>
      <text class="hero-subtitle">把每一集的进度，留在自己的时间线上</text>
    </view>
    <view class="hero-ring">
      <text class="hero-percent">{{summary.progress}}%</text>
      <text class="hero-percent-label">完成度</text>
    </view>
    <view class="summary-grid">
      <view class="summary-item"><text class="summary-value">{{summary.total}}</text><text class="summary-label">全部</text></view>
      <view class="summary-item"><text class="summary-value">{{summary.watching}}</text><text class="summary-label">追踪中</text></view>
      <view class="summary-item"><text class="summary-value">{{summary.done}}</text><text class="summary-label">已看完</text></view>
    </view>
  </view>

  <view class="add-panel">
    <view class="search-entry" bind:tap="onOpenSearch">
      <t-icon name="search" size="40rpx" />
      <view class="search-entry-copy"><text class="search-entry-title">搜索番剧自动添加</text><text class="search-entry-hint">真实封面 · 集数 · 放送信息</text></view>
      <t-icon name="chevron-right" size="36rpx" />
    </view>
    <view class="manual-entry">
      <t-input value="{{inputValue}}" placeholder="{{copy.MANUAL_PLACEHOLDER}}" clearable confirm-type="done" bind:change="onInputChange" bind:enter="onAddAnime" />
      <view class="manual-add" bind:tap="onAddAnime"><t-icon name="add" size="40rpx" /></view>
    </view>
  </view>

  <view class="toolbar" wx:if="{{summary.total}}">
    <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
      <view class="filters">
        <view wx:for="{{filters}}" wx:key="key" class="filter {{activeFilter === item.key ? 'filter--active' : ''}}" data-filter="{{item.key}}" bind:tap="onFilterChange">{{item.label}}<text class="filter-count" wx:if="{{item.count}}">{{item.count}}</text></view>
      </view>
    </scroll-view>
    <text wx:if="{{isEditMode}}" class="drag-hint">{{copy.DRAG_HINT}}</text><view class="toolbar-action" bind:tap="onToggleEditMode"><t-icon name="{{isEditMode ? 'check' : 'edit-1'}}" size="32rpx" /><text>{{isEditMode ? '完成' : '排序'}}</text></view>
  </view>

  <view wx:if="{{!summary.total}}" class="empty-state">
    <view class="empty-illustration">✦</view><text class="empty-title">{{copy.EMPTY}}</text><text class="empty-hint">{{copy.EMPTY_HINT}}</text><view class="empty-cta" bind:tap="onOpenSearch">搜索一部番剧</view>
  </view>

  <view wx:elif="{{!filteredList.length}}" class="empty-filter"><text>{{copy.FILTER_EMPTY}}</text></view>

  <view wx:else class="anime-list">
    <view wx:for="{{filteredList}}" wx:key="id" class="anime-card {{item.status === 'done' ? 'anime-card--done' : ''}} {{draggingId === item.id ? 'anime-card--dragging' : ''}} {{dragOverId === item.id ? 'anime-card--drag-over' : ''}}" data-id="{{item.id}}" bind:longpress="onDragStart" catch:touchmove="onDragMove" catch:touchend="onDragEnd" catch:touchcancel="onDragEnd">
      <view class="cover-wrap">
        <image wx:if="{{item.cover && !item.coverError}}" class="cover" src="{{item.cover}}" mode="aspectFill" data-id="{{item.id}}" binderror="onCoverError" />
        <view wx:else class="cover-fallback">{{item.initial}}</view>
        <view wx:if="{{item.status === 'done'}}" class="done-mark" bind:tap="onToggleWatched" data-id="{{item.id}}"><t-icon name="check" size="24rpx" /></view>
      </view>
      <view class="card-body">
        <view class="card-heading"><text class="anime-name">{{item.name}}</text><t-tag size="small" variant="light" theme="{{item.status === 'done' ? 'success' : item.status === 'watching' ? 'primary' : 'default'}}">{{item.statusLabel}}</t-tag></view>
        <view class="meta-line"><text wx:if="{{item.year}}">{{item.year}}</text><text wx:if="{{item.year && item.totalEp}}"> · </text><text>{{item.totalEp ? item.totalEp + ' 集' : copy.UNKNOWN_EP}}</text><text wx:if="{{item.airLabel}}"> · {{item.airLabel}}</text></view>
        <view class="progress-row"><view class="progress-track"><view class="progress-fill" style="width: {{item.progressPercent || 0}}%;"></view></view><text class="progress-text">{{item.totalEp ? item.currentEp + '/' + item.totalEp : '第 ' + item.currentEp + ' 集'}}</text></view>
        <view class="card-actions" wx:if="{{!isEditMode}}">
          <view class="stepper" bind:tap="onAdjustProgress" data-id="{{item.id}}" data-delta="-1"><t-icon name="remove" size="28rpx" /></view>
          <view class="advance-btn" bind:tap="onMarkDone" data-id="{{item.id}}"><t-icon name="{{item.status === 'done' ? 'play-circle-stroke' : 'check'}}" size="30rpx" /><text>{{item.status === 'done' ? copy.REOPEN : copy.MARK_DONE}}</text></view>
          <view class="stepper" bind:tap="onAdjustProgress" data-id="{{item.id}}" data-delta="1"><t-icon name="add" size="28rpx" /></view>
        </view>
        <view class="sort-actions" wx:else><view bind:tap="onMoveUp" data-id="{{item.id}}"><t-icon name="chevron-up" size="32rpx" /></view><view bind:tap="onMoveDown" data-id="{{item.id}}"><t-icon name="chevron-down" size="32rpx" /></view><view class="delete-link" bind:tap="onDeleteAnime" data-id="{{item.id}}">删除</view></view>
      </view>
    </view>
  </view>
</view>


<view wx:if="{{showSearch}}" class="sheet-mask" bind:tap="onCloseSearch"><view class="search-sheet" catch:tap="noop">
  <view class="sheet-handle"></view><view class="sheet-header"><text class="sheet-title">{{copy.SEARCH_TITLE}}</text><view bind:tap="onCloseSearch"><t-icon name="close" size="38rpx" /></view></view>
  <text class="sheet-hint">{{copy.SEARCH_HINT}}</text>
  <view class="sheet-search"><t-icon class="sheet-search__icon" name="search" size="34rpx" /><t-input value="{{searchKeyword}}" placeholder="{{copy.SEARCH_PLACEHOLDER}}" clearable confirm-type="search" bind:change="onSearchChange" bind:enter="onSearch" /><view class="sheet-search__submit" aria-role="button" aria-label="搜索" bind:tap="onSearch"><t-icon name="search" size="30rpx" /><text>{{copy.SEARCH_SUBMIT}}</text></view></view>
  <view wx:if="{{searchLoading}}" class="sheet-state"><t-loading theme="circular" size="36rpx" text="搜索中…" /></view>
  <view wx:elif="{{!searchResults.length}}" class="sheet-state">{{searchHint}}</view>
  <scroll-view wx:else scroll-y class="search-results">
    <view wx:for="{{searchResults}}" wx:key="sourceId" class="search-result" data-index="{{index}}" bind:tap="onPickAnime"><image class="result-cover" src="{{item.cover}}" mode="aspectFill" /><view class="result-info"><text class="result-name">{{item.name}}</text><text class="result-meta">{{item.year || copy.YEAR_UNKNOWN}} · {{item.totalEp ? item.totalEp + ' 集' : copy.UNKNOWN_EP}}</text></view><view class="result-action {{item.added ? 'result-action--added' : ''}}" aria-role="button" aria-label="{{item.added ? copy.ADDED : copy.SEARCH_ACTION}}"><t-icon wx:if="{{item.added}}" name="check" size="24rpx" /><text>{{item.added ? copy.ADDED : copy.SEARCH_ACTION}}</text></view></view>
  </scroll-view>
</view></view>

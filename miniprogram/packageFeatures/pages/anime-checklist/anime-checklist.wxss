page { background: var(--td-bg-color-page, #f6f7fb); color: var(--td-text-color-primary, #242424); }
view, text { box-sizing: border-box; }
.page { padding: 24rpx 28rpx 64rpx; }
.hero-card { position: relative; padding: 34rpx 32rpx 28rpx; border-radius: 28rpx; overflow: hidden; color: #fff; background: linear-gradient(135deg, #29275f 0%, #5146ad 55%, #8b68d8 100%); box-shadow: 0 18rpx 42rpx rgba(62, 53, 135, .24); }
.hero-card::after { content: ''; position: absolute; width: 260rpx; height: 260rpx; right: -80rpx; top: -120rpx; border-radius: 50%; background: rgba(255,255,255,.13); }
.hero-copy { display: flex; flex-direction: column; position: relative; z-index: 1; }
.eyebrow { font-size: 20rpx; letter-spacing: 4rpx; opacity: .72; }
.hero-title { margin-top: 8rpx; font-size: 52rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-subtitle { margin-top: 10rpx; font-size: 24rpx; opacity: .76; }
.hero-ring { position: absolute; top: 44rpx; right: 36rpx; width: 132rpx; height: 132rpx; border: 7rpx solid rgba(255,255,255,.32); border-top-color: #fff; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 1; transform: rotate(18deg); }
.hero-percent, .hero-percent-label { transform: rotate(-18deg); }.hero-percent { font-size: 30rpx; font-weight: 700; }.hero-percent-label { margin-top: 2rpx; font-size: 20rpx; opacity: .78; }
.summary-grid { display: flex; margin-top: 44rpx; gap: 12rpx; position: relative; z-index: 1; }.summary-item { flex: 1; padding: 16rpx 0 4rpx; border-top: 1rpx solid rgba(255,255,255,.24); display: flex; flex-direction: column; }.summary-value { font-size: 34rpx; font-weight: 700; }.summary-label { margin-top: 4rpx; font-size: 22rpx; opacity: .72; }
.add-panel { margin-top: 20rpx; padding: 16rpx; border-radius: 22rpx; background: var(--td-bg-color-container, #fff); box-shadow: 0 8rpx 24rpx rgba(36,37,48,.05); }.search-entry { display: flex; align-items: center; padding: 18rpx 16rpx; border-radius: 16rpx; color: var(--td-brand-color, #5146ad); background: var(--td-brand-color-light, #f0efff); }.search-entry-copy { flex: 1; margin: 0 14rpx; display: flex; flex-direction: column; }.search-entry-title { font-size: 28rpx; font-weight: 600; }.search-entry-hint { margin-top: 4rpx; font-size: 21rpx; color: var(--td-text-color-secondary, #777); }.manual-entry { display: flex; align-items: center; margin-top: 10rpx; padding-left: 8rpx; border-radius: 14rpx; background: var(--td-bg-color-secondarycontainer, #f5f5f5); }.manual-entry t-input { flex: 1; }.manual-add { width: 72rpx; height: 72rpx; margin-right: 6rpx; display: flex; align-items: center; justify-content: center; color: #fff; border-radius: 14rpx; background: var(--td-brand-color, #5146ad); }
.toolbar { margin: 26rpx 4rpx 14rpx; display: flex; align-items: center; }.filter-scroll { flex: 1; white-space: nowrap; }.filters { display: inline-flex; gap: 12rpx; }.filter { padding: 13rpx 22rpx; border-radius: 999rpx; color: var(--td-text-color-secondary, #777); font-size: 24rpx; background: var(--td-bg-color-container, #fff); }.filter--active { color: var(--td-brand-color, #5146ad); font-weight: 600; background: var(--td-brand-color-light, #eeecff); }.filter-count { margin-left: 7rpx; font-size: 20rpx; opacity: .75; }.toolbar-action { display: flex; align-items: center; gap: 5rpx; margin-left: 12rpx; padding: 10rpx 0 10rpx 10rpx; color: var(--td-brand-color, #5146ad); font-size: 23rpx; }
.anime-list { display: flex; flex-direction: column; gap: 16rpx; }
.anime-card { display: flex; padding: 18rpx; min-height: 224rpx; border-radius: 22rpx; background: var(--td-bg-color-container, #fff); box-shadow: 0 6rpx 20rpx rgba(36,37,48,.05); transition: transform .2s ease, opacity .2s ease; }
.anime-card:active { transform: scale(.985); }
.anime-card--done { opacity: .82; }
.cover-wrap { position: relative; width: 132rpx; height: 188rpx; flex-shrink: 0; overflow: hidden; border-radius: 14rpx; background: linear-gradient(145deg, var(--td-brand-color-light, #eceaff), var(--td-bg-color-component, #eee)); }
.cover, .cover-fallback { width: 100%; height: 100%; }
.cover-fallback { display: flex; align-items: center; justify-content: center; color: var(--td-brand-color, #5146ad); font-size: 54rpx; font-weight: 700; }
.done-mark { position: absolute; right: 8rpx; top: 8rpx; width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; color: #fff; border-radius: 50%; background: var(--td-success-color, #2ba471); }
.card-body { min-width: 0; flex: 1; margin-left: 18rpx; display: flex; flex-direction: column; }
.card-heading { display: flex; align-items: flex-start; gap: 10rpx; }
.anime-name { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 600; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.meta-line { margin-top: 10rpx; color: var(--td-text-color-secondary, #777); font-size: 22rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.progress-row { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx; }
.progress-track { flex: 1; height: 10rpx; overflow: hidden; border-radius: 999rpx; background: var(--td-bg-color-component, #eceef2); }
.progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--td-brand-color, #5146ad), var(--td-brand-color-7, #8b68d8)); }
.progress-text { min-width: 84rpx; text-align: right; color: var(--td-text-color-secondary, #777); font-size: 21rpx; }
.card-actions { margin-top: auto; padding-top: 16rpx; display: flex; align-items: center; gap: 10rpx; }
.stepper { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; color: var(--td-brand-color, #5146ad); border-radius: 12rpx; background: var(--td-brand-color-light, #f0efff); }
.advance-btn { flex: 1; min-width: 0; height: 52rpx; display: flex; align-items: center; justify-content: center; gap: 7rpx; color: var(--td-brand-color, #5146ad); border-radius: 12rpx; background: var(--td-brand-color-light, #f0efff); font-size: 23rpx; }
.sort-actions { margin-top: auto; padding-top: 16rpx; display: flex; align-items: center; gap: 14rpx; color: var(--td-brand-color, #5146ad); }
.sort-btn { width: 72rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; background: var(--td-brand-color-light, #f0efff); transition: background .15s ease, transform .15s ease; }
.sort-btn:active { background: var(--td-brand-color-2, #d9d4ff); transform: scale(.94); }
.delete-link { margin-left: auto; color: var(--td-error-color, #e34d59); font-size: 23rpx; }
.drag-hint { margin-left: 10rpx; color: var(--td-text-color-secondary, #777); font-size: 20rpx; white-space: nowrap; }
.anime-card--dragging { opacity: .72; transform: scale(.98); box-shadow: 0 12rpx 28rpx rgba(36,37,48,.16); }
.anime-card--drag-over { box-shadow: inset 0 0 0 3rpx var(--td-brand-color, #5146ad), 0 6rpx 20rpx rgba(36,37,48,.05); }
.empty-state, .empty-filter { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 130rpx 36rpx; text-align: center; color: var(--td-text-color-secondary, #777); }.empty-illustration { width: 108rpx; height: 108rpx; display: flex; align-items: center; justify-content: center; color: var(--td-brand-color, #5146ad); font-size: 60rpx; border-radius: 32rpx; background: var(--td-brand-color-light, #f0efff); }.empty-title { margin-top: 24rpx; color: var(--td-text-color-primary, #242424); font-size: 32rpx; font-weight: 600; }.empty-hint { margin-top: 10rpx; font-size: 24rpx; }.empty-cta { margin-top: 28rpx; padding: 16rpx 28rpx; color: #fff; border-radius: 999rpx; background: var(--td-brand-color, #5146ad); font-size: 25rpx; }.empty-filter { padding: 90rpx 0; font-size: 25rpx; }
.sheet-mask { position: fixed; inset: 0; z-index: 10; display: flex; align-items: flex-end; background: rgba(0,0,0,.45); }.search-sheet { width: 100%; max-height: 82vh; padding: 18rpx 28rpx 34rpx; border-radius: 30rpx 30rpx 0 0; background: var(--td-bg-color-container, #fff); }.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 18rpx; border-radius: 999rpx; background: var(--td-text-color-placeholder, #bbb); }.sheet-header { display: flex; align-items: center; justify-content: space-between; }.sheet-title { font-size: 34rpx; font-weight: 700; }.sheet-hint { display: block; margin-top: 6rpx; color: var(--td-text-color-secondary, #777); font-size: 22rpx; }.sheet-search { margin-top: 18rpx; padding: 6rpx; display: flex; align-items: center; gap: 10rpx; border-radius: 16rpx; background: var(--td-bg-color-secondarycontainer, #f5f5f5); }.sheet-search t-input { flex: 1; min-width: 0; --td-input-border-color: transparent; --td-input-bg-color: transparent; }.sheet-search__submit { width: 128rpx; height: 72rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; gap: 6rpx; color: #fff; border-radius: 12rpx; background: var(--td-brand-color, #5146ad); font-size: 25rpx; font-weight: 600; }.sheet-search__submit:active { opacity: .82; transform: scale(.98); }.sheet-state { padding: 52rpx 0; text-align: center; color: var(--td-text-color-secondary, #777); font-size: 24rpx; }.search-results { max-height: 52vh; margin-top: 14rpx; }.search-result { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid var(--td-border-level-1-color, #eee); }.result-cover { width: 76rpx; height: 100rpx; flex-shrink: 0; border-radius: 10rpx; background: var(--td-bg-color-component, #eee); }.result-info { flex: 1; min-width: 0; margin-left: 16rpx; display: flex; flex-direction: column; }.result-name { font-size: 27rpx; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.result-meta { margin-top: 8rpx; color: var(--td-text-color-secondary, #777); font-size: 22rpx; }.result-action { margin-left: 16rpx; padding: 10rpx 18rpx; display: inline-flex; align-items: center; gap: 5rpx; color: var(--td-brand-color, #5146ad); border-radius: 999rpx; background: var(--td-brand-color-light, #f0efff); font-size: 22rpx; }.result-action--added { color: var(--td-success-color, #2ba471); background: var(--td-success-color-1, #e3f9e9); }
@media (prefers-reduced-motion: reduce) { .anime-card { transition: none; } }

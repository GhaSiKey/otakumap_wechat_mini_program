<view class="page {{showTilePicker ? 'picker-open' : 'picker-closed'}}">
  <view class="page-header">
    <view class="brand-mark">✿</view>
    <view class="page-title-group">
      <text class="page-title">日麻点数</text>
      <text class="page-subtitle">输入牌面，自动拆解役种与支付</text>
    </view>
    <view class="header-help" bindtap="togglePanel" data-panel="help">?</view>
  </view>

  <view class="summary-card">
    <view class="choice-block">
      <view class="choice-heading"><text class="summary-label">场风</text><text class="choice-current">{{bakaze === 'east' ? '东场' : bakaze === 'south' ? '南场' : bakaze === 'west' ? '西场' : '北场'}}</text></view>
      <view class="segmented-control wind-buttons">
        <view wx:for="{{windOptions}}" wx:key="value" class="wind-button {{bakaze === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onBakazeChange">{{item.label}}</view>
      </view>
    </view>
    <view class="choice-block">
      <view class="choice-heading"><text class="summary-label">自风</text><text class="choice-current">{{jikaze === 'east' ? '东家' : jikaze === 'south' ? '南家' : jikaze === 'west' ? '西家' : '北家'}}</text></view>
      <view class="segmented-control seat-buttons">
        <view wx:for="{{windOptions}}" wx:key="value" class="seat-button {{jikaze === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onJikazeChange">{{item.label}}</view>
      </view>
    </view>
    <view class="win-type">
      <view class="win-type-option {{isTsumo ? 'active' : ''}}" data-value="{{true}}" bindtap="onTsumoChange">自摸</view>
      <view class="win-type-option {{!isTsumo ? 'active' : ''}}" data-value="{{false}}" bindtap="onTsumoChange">荣和</view>
    </view>
  </view>

  <view class="hand-card">
    <view class="card-heading">
      <view>
        <text class="card-title">手牌</text>
        <text class="card-caption">{{getTileCountLabel()}} 张门前牌</text>
      </view>
      <view class="ready-state {{agariTile ? 'ready' : ''}}">{{agariTile ? '已选和牌' : '请选择和牌'}}</view>
    </view>
    <view class="tile-grid">
      <view wx:for="{{handTiles}}" wx:key="index" class="tile tile-{{item.suit}} {{item.isRed ? 'red' : ''}}" data-index="{{index}}" bindtap="onRemoveHandTile">
        <text class="tile-value">{{item.suit === 'z' ? honorNames[item.value] : item.value}}</text>
        <text wx:if="{{item.suit !== 'z'}}" class="tile-suit">{{getTileSuitName(item.suit)}}</text>
      </view>
      <view wx:for="{{13 - melds.length * 3 - handTiles.length}}" wx:key="index" class="tile-slot" bindtap="toggleTilePicker"><text>+</text></view>
    </view>
    <view class="agari-row">
      <view class="agari-label"><text>和牌张</text><text class="agari-hint">点击牌面可移除</text></view>
      <view class="agari-action" bindtap="openAgariSelector">
        <view wx:if="{{agariTile}}" class="tile tile-{{agariTile.suit}} {{agariTile.isRed ? 'red' : ''}} tile-agari" catchtap="onRemoveAgariTile">
          <text class="tile-value">{{agariTile.suit === 'z' ? honorNames[agariTile.value] : agariTile.value}}</text>
          <text wx:if="{{agariTile.suit !== 'z'}}" class="tile-suit">{{getTileSuitName(agariTile.suit)}}</text>
        </view>
        <view wx:else class="agari-slot">+</view>
      </view>
    </view>
    <view wx:if="{{errorMessage}}" class="error-banner"><text class="error-icon">!</text><text>{{errorMessage}}</text></view>
  </view>

  <view class="section-card meld-card">
    <view class="section-heading"><view><text class="card-title">副露</text><text class="card-caption">吃、碰、明杠或暗杠</text></view><view class="text-action" bindtap="openMeldEditor" wx:if="{{melds.length < 4}}">+ 添加</view></view>
    <view wx:if="{{melds.length}}" class="meld-list">
      <view wx:for="{{melds}}" wx:key="index" class="meld-item" data-index="{{index}}" bindtap="onRemoveMeld">
        <text class="meld-kind">{{getMeldTypeName(item.type)}}</text>
        <view class="meld-tiles"><view wx:for="{{item.tiles}}" wx:for-item="tile" wx:for-index="tileIndex" wx:key="tileIndex" class="tile tile-sm tile-{{tile.suit}} {{tile.isRed ? 'red' : ''}}"><text class="tile-value">{{tile.suit === 'z' ? honorNames[tile.value] : tile.value}}</text><text wx:if="{{tile.suit !== 'z'}}" class="tile-suit">{{getTileSuitName(tile.suit)}}</text></view></view>
        <text class="remove-hint">移除</text>
      </view>
    </view>
    <view wx:else class="empty-meld" bindtap="openMeldEditor">点击添加副露</view>
  </view>

  <view class="settings-list">
    <view class="settings-panel {{expandedPanel === 'riichi' ? 'expanded' : ''}}">
      <view class="settings-header" bindtap="togglePanel" data-panel="riichi"><view class="settings-icon accent">立</view><view class="settings-copy"><text class="settings-title">立直与特殊状态</text><text class="settings-summary">{{getRiichiActive() ? (isDoubleRiichi ? '双立直' : '立直') : '未设置'}}</text></view><text class="settings-chevron">{{expandedPanel === 'riichi' ? '⌃' : '⌄'}}</text></view>
      <view wx:if="{{expandedPanel === 'riichi'}}" class="settings-body">
        <view class="chip-row"><view class="option-chip {{isRiichi ? 'selected' : ''}}" bindtap="onRiichiChange" data-value="{{!isRiichi}}">立直 <text>+1</text></view><view class="option-chip {{isDoubleRiichi ? 'selected' : ''}}" bindtap="onDoubleRiichiChange" data-value="{{!isDoubleRiichi}}">双立直 <text>+2</text></view><view class="option-chip {{isIppatsu ? 'selected' : ''}} {{!getRiichiActive() ? 'disabled' : ''}}" bindtap="onIppatsuChange" data-value="{{!isIppatsu}}">一发 <text>+1</text></view></view>
        <view class="chip-row"><view class="option-chip {{isRinshan ? 'selected' : ''}} {{!isTsumo ? 'disabled' : ''}}" bindtap="onRinshanChange" data-value="{{!isRinshan}}">岭上开花</view><view class="option-chip {{isChankan ? 'selected' : ''}} {{isTsumo ? 'disabled' : ''}}" bindtap="onChankanChange" data-value="{{!isChankan}}">抢杠</view><view class="option-chip {{isHaitei ? 'selected' : ''}} {{!isTsumo ? 'disabled' : ''}}" bindtap="onHaiteiChange" data-value="{{!isHaitei}}">海底摸月</view><view class="option-chip {{isHoutei ? 'selected' : ''}} {{isTsumo ? 'disabled' : ''}}" bindtap="onHouteiChange" data-value="{{!isHoutei}}">河底捞鱼</view></view>
      </view>
    </view>
    <view class="settings-panel {{expandedPanel === 'honba' ? 'expanded' : ''}}"><view class="settings-header" bindtap="togglePanel" data-panel="honba"><view class="settings-icon">本</view><view class="settings-copy"><text class="settings-title">本场与供托</text><text class="settings-summary">{{honba}} 本场 · {{kyoutaku}} 供托</text></view><text class="settings-chevron">{{expandedPanel === 'honba' ? '⌃' : '⌄'}}</text></view><view wx:if="{{expandedPanel === 'honba'}}" class="settings-body"><view class="counter-row"><view class="counter-item"><text>本场</text><view class="counter"><view class="counter-btn" data-value="{{honba - 1}}" bindtap="onHonbaChange">−</view><text>{{honba}}</text><view class="counter-btn" data-value="{{honba + 1}}" bindtap="onHonbaChange">+</view></view></view><view class="counter-item"><text>供托</text><view class="counter"><view class="counter-btn" data-value="{{kyoutaku - 1}}" bindtap="onKyoutakuChange">−</view><text>{{kyoutaku}}</text><view class="counter-btn" data-value="{{kyoutaku + 1}}" bindtap="onKyoutakuChange">+</view></view></view></view></view></view>
    <view class="settings-panel {{expandedPanel === 'dora' ? 'expanded' : ''}}"><view class="settings-header" bindtap="togglePanel" data-panel="dora"><view class="settings-icon gold">宝</view><view class="settings-copy"><text class="settings-title">宝牌指示牌</text><text class="settings-summary">表 {{doraIndicators.length}} 张 · 里 {{uraIndicators.length}} 张</text></view><text class="settings-chevron">{{expandedPanel === 'dora' ? '⌃' : '⌄'}}</text></view><view wx:if="{{expandedPanel === 'dora'}}" class="settings-body"><view class="indicator-row"><text>表宝牌</text><view class="indicator-tiles"><view wx:for="{{doraIndicators}}" wx:key="index" class="tile tile-sm tile-{{item.suit}}" data-index="{{index}}" bindtap="onRemoveDora"><text class="tile-value">{{item.suit === 'z' ? honorNames[item.value] : item.value}}</text></view><view wx:if="{{doraIndicators.length < 5}}" class="tile-add" bindtap="openDoraSelector">+</view></view></view><view wx:if="{{getRiichiActive()}}" class="indicator-row"><text>里宝牌</text><view class="indicator-tiles"><view wx:for="{{uraIndicators}}" wx:key="index" class="tile tile-sm tile-{{item.suit}}" data-index="{{index}}" bindtap="onRemoveUraDora"><text class="tile-value">{{item.suit === 'z' ? honorNames[item.value] : item.value}}</text></view><view wx:if="{{uraIndicators.length < 5}}" class="tile-add" bindtap="openUraSelector">+</view></view></view></view></view>
  </view>

  <view class="bottom-dock">
    <view class="calculate-row"><button class="calculate-button {{handTiles.length === 13 - melds.length * 3 && agariTile ? 'ready' : ''}}" bindtap="onCalculate">计算点数</button></view>
    <view class="picker-toggle" bindtap="toggleTilePicker"><text>{{selectorMode === 'hand' ? '选择手牌' : selectorMode === 'agari' ? '选择和牌张' : selectorMode === 'dora' ? '选择表宝牌' : '选择里宝牌'}}</text><text>{{showTilePicker ? '收起牌盘' : '展开牌盘'}} {{showTilePicker ? '⌄' : '⌃'}}</text></view>
    <view wx:if="{{selectorMode !== 'hand'}}" class="picker-mode"><text>当前模式：{{selectorMode === 'agari' ? '选择和牌张' : selectorMode === 'dora' ? '选择表宝牌' : '选择里宝牌'}}</text><view bindtap="cancelSelectorMode">取消</view></view>
    <view wx:if="{{showTilePicker}}" class="tile-picker"><view class="picker-tabs"><view wx:for="{{['m','p','s','z']}}" wx:key="*this" class="picker-tab {{currentSuit === item ? 'active' : ''}}" data-suit="{{item}}" bindtap="onSuitChange">{{item === 'm' ? '万子' : item === 'p' ? '筒子' : item === 's' ? '索子' : '字牌'}}</view></view><view class="picker-grid"><view wx:if="{{currentSuit !== 'z'}}" wx:for="{{[1,2,3,4,5,6,7,8,9]}}" wx:key="*this" class="picker-tile tile-{{currentSuit}}" data-suit="{{currentSuit}}" data-value="{{item}}" bindtap="onSelectTile"><text>{{item}}</text><text class="inline-small">{{currentSuit === 'm' ? '万' : currentSuit === 'p' ? '筒' : '索'}}</text></view><view wx:if="{{currentSuit !== 'z' && selectorMode === 'hand'}}" class="picker-tile red-picker" data-suit="{{currentSuit}}" data-value="5" data-red="true" bindtap="onSelectTile"><text>赤5</text><text class="inline-small">赤宝</text></view><view wx:if="{{currentSuit === 'z'}}" wx:for="{{[1,2,3,4,5,6,7]}}" wx:key="*this" class="picker-tile honor-picker" data-suit="z" data-value="{{item}}" bindtap="onSelectTile"><text>{{honorNames[item]}}</text></view></view></view>
  </view>

  <view class="meld-editor {{showMeldEditor ? 'show' : ''}}"><view class="meld-editor-mask" bindtap="cancelMeld"></view><view class="meld-editor-content"><view class="modal-header"><text>添加副露</text><view bindtap="cancelMeld">×</view></view><view class="meld-type-selector"><view wx:for="{{meldTypes}}" wx:key="value" class="meld-type-btn {{editingMeldType === item.value ? 'active' : ''}}" data-type="{{item.value}}" bindtap="onMeldTypeChange">{{item.label}}</view></view><view class="edit-preview"><text>已选 {{editingMeldTiles.length}} / {{editingMeldType === 'kan' || editingMeldType === 'ankan' ? 4 : 3}}</text><view class="meld-tiles"><view wx:for="{{editingMeldTiles}}" wx:key="index" class="tile tile-sm tile-{{item.suit}}" data-index="{{index}}" bindtap="onRemoveEditingMeldTile"><text class="tile-value">{{item.suit === 'z' ? honorNames[item.value] : item.value}}</text></view></view></view><view class="meld-suit-tabs"><view wx:for="{{['m','p','s','z']}}" wx:key="*this" class="picker-tab {{meldSuit === item ? 'active' : ''}}" data-suit="{{item}}" bindtap="onMeldSuitChange">{{item === 'm' ? '万子' : item === 'p' ? '筒子' : item === 's' ? '索子' : '字牌'}}</view></view><view class="picker-grid compact"><view wx:if="{{meldSuit !== 'z'}}" wx:for="{{[1,2,3,4,5,6,7,8,9]}}" wx:key="*this" class="picker-tile tile-{{meldSuit}}" data-suit="{{meldSuit}}" data-value="{{item}}" bindtap="onSelectMeldTile"><text>{{item}}</text></view><view wx:if="{{meldSuit !== 'z'}}" class="picker-tile red-picker" data-suit="{{meldSuit}}" data-value="5" data-red="true" bindtap="onSelectMeldTile"><text>赤5</text></view><view wx:if="{{meldSuit === 'z'}}" wx:for="{{[1,2,3,4,5,6,7]}}" wx:key="*this" class="picker-tile honor-picker" data-suit="z" data-value="{{item}}" bindtap="onSelectMeldTile"><text>{{honorNames[item]}}</text></view></view><view class="modal-actions"><button bindtap="cancelMeld">取消</button><button class="primary" bindtap="confirmMeld">添加副露</button></view></view></view>

  <view wx:if="{{result}}" class="result-sheet {{showResult ? 'show' : ''}}" catchtouchmove="preventMove"><view class="sheet-mask" bindtap="onCloseResult"></view><view class="sheet-content"><view class="sheet-handle"></view><view class="sheet-header"><view><text class="sheet-kicker">计算结果</text><view class="sheet-total"><text>{{result.score.grandTotal}}</text><text class="total-unit">点</text></view><text class="sheet-meta">{{result.score.isTsumo ? '自摸' : '荣和'}} · {{result.totalHan}} 翻 · {{result.fu.rounded}} 符</text></view><text class="limit-label">{{getResultLimitName(result.score.limitName) || '普通和了'}}</text></view><scroll-view scroll-y class="sheet-body"><view class="payment-card"><text class="block-title">支付明细</text><view wx:if="{{result.score.isTsumo && result.score.isParent}}" class="payment-row"><text>三家各付</text><text class="strong">{{result.score.payments.fromEachChild}}</text></view><view wx:elif="{{result.score.isTsumo}}" class="payment-stack"><view class="payment-row"><text>亲家支付</text><text class="strong">{{result.score.payments.fromParent}}</text></view><view class="payment-row"><text>子家各付</text><text class="strong">{{result.score.payments.fromEachChild}}</text></view></view><view wx:else class="payment-row"><text>放铳者支付</text><text class="strong">{{result.score.payments.fromDealer}}</text></view><view wx:if="{{result.score.honbaBonus || result.score.kyoutakuBonus}}" class="payment-extra">本场 +{{result.score.honbaBonus}} · 供托 +{{result.score.kyoutakuBonus}}</view></view><view class="result-block"><text class="block-title">役种（{{result.yakuHan}} 翻）</text><view class="yaku-chips"><view wx:for="{{result.yakuList}}" wx:key="id" class="yaku-chip"><text>{{item.name}}</text><text class="inline-small">{{item.han >= 13 ? '役满' : item.han + '翻'}}</text></view></view><view wx:if="{{result.doraCount.total}}" class="dora-summary">宝牌 +{{result.doraCount.total}} 翻（表 {{result.doraCount.dora}} · 里 {{result.doraCount.uraDora}} · 赤 {{result.doraCount.akaDora}}）</view></view><view class="result-block"><text class="block-title">符数明细</text><view wx:for="{{result.fu.details}}" wx:key="name" class="fu-row"><text>{{item.name}}</text><text class="strong">{{item.fu}} 符</text></view><view class="fu-row total"><text>合计</text><text class="strong">{{result.fu.rounded}} 符</text></view></view></scroll-view><view class="sheet-footer"><button bindtap="onCloseResult">关闭</button></view></view></view>
</view>

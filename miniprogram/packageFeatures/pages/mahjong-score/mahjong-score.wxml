<view class="page">
  <!-- 顶部快捷栏 -->
  <view class="quick-bar">
    <view class="quick-item">
      <text class="quick-label">场风</text>
      <view class="quick-selector">
        <view
          wx:for="{{windOptions}}"
          wx:key="value"
          class="quick-btn {{bakaze === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onBakazeChange"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="quick-divider"></view>
    <view class="quick-item">
      <text class="quick-label">自风</text>
      <view class="quick-selector">
        <view
          wx:for="{{windOptions}}"
          wx:key="value"
          class="quick-btn {{jikaze === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onJikazeChange"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="quick-divider"></view>
    <view class="quick-item">
      <view class="tsumo-toggle">
        <view class="toggle-btn {{isTsumo ? 'active' : ''}}" bindtap="onTsumoChange" data-value="{{true}}">自摸</view>
        <view class="toggle-btn {{!isTsumo ? 'active' : ''}}" bindtap="onTsumoChange" data-value="{{false}}">荣和</view>
      </view>
    </view>
  </view>

  <!-- 牌桌区域 -->
  <view class="table-area">
    <!-- 副露区 -->
    <view class="melds-section" wx:if="{{melds.length > 0 || true}}">
      <view class="section-header">
        <text class="section-title">副露</text>
        <view class="add-meld-btn" bindtap="openMeldEditor" wx:if="{{melds.length < 4}}">+ 添加</view>
      </view>
      <view class="melds-row" wx:if="{{melds.length > 0}}">
        <view class="meld-group" wx:for="{{melds}}" wx:key="index" data-index="{{index}}" bindtap="onRemoveMeld">
          <view class="meld-type">{{getMeldTypeName(item.type)}}</view>
          <view class="meld-tiles">
            <view
              wx:for="{{item.tiles}}"
              wx:for-item="tile"
              wx:key="tileIndex"
              class="tile tile-sm tile-{{tile.suit}} {{tile.isRed ? 'red' : ''}}"
            >
              <text class="tile-value">{{tile.suit === 'z' ? honorNames[tile.value] : tile.value}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="melds-empty" wx:else bindtap="openMeldEditor">
        <text>点击添加副露（吃/碰/杠）</text>
      </view>
    </view>

    <!-- 手牌区 -->
    <view class="hand-section">
      <view class="section-header">
        <text class="section-title">门前手牌</text>
        <text class="section-count">{{handTiles.length}}/{{13 - melds.length * 3}}</text>
      </view>
      <view class="tiles-row">
        <view
          wx:for="{{handTiles}}"
          wx:key="index"
          class="tile tile-{{item.suit}} {{item.isRed ? 'red' : ''}}"
          data-index="{{index}}"
          bindtap="onRemoveHandTile"
        >
          <text class="tile-value">{{item.suit === 'z' ? honorNames[item.value] : item.value}}</text>
          <text class="tile-suit" wx:if="{{item.suit !== 'z'}}">{{getTileSuitName(item.suit)}}</text>
        </view>
        <view class="tile-placeholder" wx:for="{{13 - melds.length * 3 - handTiles.length}}" wx:key="index" wx:if="{{13 - melds.length * 3 - handTiles.length > 0}}">
          <text class="placeholder-text">+</text>
        </view>
      </view>
    </view>

    <!-- 和牌张 -->
    <view class="agari-section">
      <view class="section-header">
        <text class="section-title">和牌</text>
      </view>
      <view class="agari-tile-wrapper" bindtap="openAgariSelector">
        <view wx:if="{{agariTile}}" class="tile tile-{{agariTile.suit}} {{agariTile.isRed ? 'red' : ''}} agari" bindtap="onRemoveAgariTile">
          <text class="tile-value">{{agariTile.suit === 'z' ? honorNames[agariTile.value] : agariTile.value}}</text>
          <text class="tile-suit" wx:if="{{agariTile.suit !== 'z'}}">{{getTileSuitName(agariTile.suit)}}</text>
        </view>
        <view wx:else class="tile-placeholder agari-placeholder">
          <text class="placeholder-text">?</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 折叠设置区 -->
  <view class="settings-area">
    <!-- 立直与特殊状态 -->
    <view class="collapse-panel {{expandedPanel === 'riichi' ? 'expanded' : ''}}">
      <view class="panel-header" bindtap="togglePanel" data-panel="riichi">
        <text class="panel-title">立直 & 特殊状态</text>
        <view class="panel-tags">
          <text class="tag" wx:if="{{isRiichi}}">立直</text>
          <text class="tag" wx:if="{{isDoubleRiichi}}">双立</text>
          <text class="tag" wx:if="{{isIppatsu}}">一发</text>
          <text class="tag" wx:if="{{isRinshan}}">岭上</text>
          <text class="tag" wx:if="{{isChankan}}">抢杠</text>
          <text class="tag" wx:if="{{isHaitei}}">海底</text>
        </view>
        <text class="panel-arrow">{{expandedPanel === 'riichi' ? '▲' : '▼'}}</text>
      </view>
      <view class="panel-body" wx:if="{{expandedPanel === 'riichi'}}">
        <view class="chip-group">
          <view class="chip {{isRiichi ? 'active' : ''}}" bindtap="onRiichiChange" data-value="{{!isRiichi}}">立直</view>
          <view class="chip {{isDoubleRiichi ? 'active' : ''}}" bindtap="onDoubleRiichiChange" data-value="{{!isDoubleRiichi}}">双立直</view>
          <view class="chip {{isIppatsu ? 'active' : ''}} {{!isRiichi && !isDoubleRiichi ? 'disabled' : ''}}" bindtap="onIppatsuChange" data-value="{{!isIppatsu}}">一发</view>
        </view>
        <view class="chip-group">
          <view class="chip {{isRinshan ? 'active' : ''}}" bindtap="onRinshanChange" data-value="{{!isRinshan}}">岭上开花</view>
          <view class="chip {{isChankan ? 'active' : ''}}" bindtap="onChankanChange" data-value="{{!isChankan}}">抢杠</view>
          <view class="chip {{isHaitei ? 'active' : ''}}" bindtap="onHaiteiChange" data-value="{{!isHaitei}}">海底/河底</view>
        </view>
      </view>
    </view>

    <!-- 本场与供托 -->
    <view class="collapse-panel {{expandedPanel === 'honba' ? 'expanded' : ''}}">
      <view class="panel-header" bindtap="togglePanel" data-panel="honba">
        <text class="panel-title">本场 & 供托</text>
        <view class="panel-tags">
          <text class="tag" wx:if="{{honba > 0}}">{{honba}}本场</text>
          <text class="tag" wx:if="{{kyoutaku > 0}}">{{kyoutaku}}供托</text>
        </view>
        <text class="panel-arrow">{{expandedPanel === 'honba' ? '▲' : '▼'}}</text>
      </view>
      <view class="panel-body" wx:if="{{expandedPanel === 'honba'}}">
        <view class="number-row">
          <view class="number-field">
            <text class="number-label">本场</text>
            <view class="number-control">
              <view class="num-btn" bindtap="onHonbaChange" data-value="{{honba - 1}}">−</view>
              <text class="num-value">{{honba}}</text>
              <view class="num-btn" bindtap="onHonbaChange" data-value="{{honba + 1}}">+</view>
            </view>
          </view>
          <view class="number-field">
            <text class="number-label">供托</text>
            <view class="number-control">
              <view class="num-btn" bindtap="onKyoutakuChange" data-value="{{kyoutaku - 1}}">−</view>
              <text class="num-value">{{kyoutaku}}</text>
              <view class="num-btn" bindtap="onKyoutakuChange" data-value="{{kyoutaku + 1}}">+</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 宝牌设置 -->
    <view class="collapse-panel {{expandedPanel === 'dora' ? 'expanded' : ''}}">
      <view class="panel-header" bindtap="togglePanel" data-panel="dora">
        <text class="panel-title">宝牌指示牌</text>
        <view class="panel-tags">
          <text class="tag" wx:if="{{doraIndicators.length > 0}}">表{{doraIndicators.length}}</text>
          <text class="tag" wx:if="{{uraIndicators.length > 0}}">里{{uraIndicators.length}}</text>
        </view>
        <text class="panel-arrow">{{expandedPanel === 'dora' ? '▲' : '▼'}}</text>
      </view>
      <view class="panel-body" wx:if="{{expandedPanel === 'dora'}}">
        <view class="dora-row">
          <text class="dora-label">表宝牌</text>
          <view class="dora-tiles">
            <view
              wx:for="{{doraIndicators}}"
              wx:key="index"
              class="tile tile-sm tile-{{item.suit}}"
              data-index="{{index}}"
              bindtap="onRemoveDora"
            >
              <text class="tile-value">{{item.suit === 'z' ? honorNames[item.value] : item.value}}</text>
            </view>
            <view class="tile-add" wx:if="{{doraIndicators.length < 5}}" bindtap="openDoraSelector">+</view>
          </view>
        </view>
        <view class="dora-row" wx:if="{{isRiichi || isDoubleRiichi}}">
          <text class="dora-label">里宝牌</text>
          <view class="dora-tiles">
            <view
              wx:for="{{uraIndicators}}"
              wx:key="index"
              class="tile tile-sm tile-{{item.suit}}"
              data-index="{{index}}"
              bindtap="onRemoveUraDora"
            >
              <text class="tile-value">{{item.suit === 'z' ? honorNames[item.value] : item.value}}</text>
            </view>
            <view class="tile-add" wx:if="{{uraIndicators.length < 5}}" bindtap="openUraSelector">+</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部牌选择器 -->
  <view class="tile-picker">
    <!-- 计算按钮 -->
    <view class="calc-bar">
      <button class="calc-btn" bindtap="onCalculate">计算点数</button>
    </view>
    <!-- 模式提示 -->
    <view class="picker-mode" wx:if="{{selectorMode !== 'hand'}}">
      <text class="mode-text">{{selectorMode === 'agari' ? '选择和牌张' : selectorMode === 'dora' ? '选择表宝牌' : '选择里宝牌'}}</text>
      <view class="mode-cancel" bindtap="cancelSelectorMode">取消</view>
    </view>
    <view class="picker-tabs">
      <view
        wx:for="{{['m', 'p', 's', 'z']}}"
        wx:key="*this"
        class="picker-tab {{currentSuit === item ? 'active' : ''}}"
        data-suit="{{item}}"
        bindtap="onSuitChange"
      >{{item === 'm' ? '万' : item === 'p' ? '筒' : item === 's' ? '索' : '字'}}</view>
    </view>
    <view class="picker-tiles">
      <view wx:if="{{currentSuit !== 'z'}}" class="picker-row">
        <view
          wx:for="{{[1,2,3,4,5,6,7,8,9]}}"
          wx:key="*this"
          class="picker-tile"
          data-suit="{{currentSuit}}"
          data-value="{{item}}"
          bindtap="onSelectTile"
        >
          <text class="picker-value">{{item}}</text>
          <text class="picker-suit">{{currentSuit === 'm' ? '万' : currentSuit === 'p' ? '筒' : '索'}}</text>
        </view>
      </view>
      <view wx:if="{{currentSuit !== 'z' && currentSuit !== ''}}" class="picker-row red-row">
        <view class="picker-tile red" data-suit="{{currentSuit}}" data-value="5" data-red="true" bindtap="onSelectTile">
          <text class="picker-value">5</text>
          <text class="picker-suit red-label">赤</text>
        </view>
      </view>
      <view wx:if="{{currentSuit === 'z'}}" class="picker-row honor-row">
        <view
          wx:for="{{[1,2,3,4,5,6,7]}}"
          wx:key="*this"
          class="picker-tile honor"
          data-suit="z"
          data-value="{{item}}"
          bindtap="onSelectTile"
        >
          <text class="picker-value">{{honorNames[item]}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 副露编辑弹窗 -->
  <view class="meld-editor {{showMeldEditor ? 'show' : ''}}">
    <view class="meld-editor-mask" bindtap="cancelMeld"></view>
    <view class="meld-editor-content">
      <view class="meld-editor-header">
        <text class="meld-editor-title">添加副露</text>
        <view class="meld-editor-close" bindtap="cancelMeld">×</view>
      </view>
      <view class="meld-type-selector">
        <view
          wx:for="{{meldTypes}}"
          wx:key="value"
          class="meld-type-btn {{editingMeldType === item.value ? 'active' : ''}}"
          data-type="{{item.value}}"
          bindtap="onMeldTypeChange"
        >{{item.label}}</view>
      </view>
      <view class="meld-tiles-preview">
        <view class="meld-tiles-label">已选牌（点击可删除）</view>
        <view class="meld-tiles-row">
          <view
            wx:for="{{editingMeldTiles}}"
            wx:key="index"
            class="tile tile-{{item.suit}} {{item.isRed ? 'red' : ''}}"
            data-index="{{index}}"
            bindtap="onRemoveEditingMeldTile"
          >
            <text class="tile-value">{{item.suit === 'z' ? honorNames[item.value] : item.value}}</text>
            <text class="tile-suit" wx:if="{{item.suit !== 'z'}}">{{getTileSuitName(item.suit)}}</text>
          </view>
          <view
            class="tile-placeholder"
            wx:for="{{(editingMeldType === 'kan' || editingMeldType === 'ankan' ? 4 : 3) - editingMeldTiles.length}}"
            wx:key="index"
          >
            <text class="placeholder-text">+</text>
          </view>
        </view>
      </view>
      <!-- 内嵌牌选择器 -->
      <view class="meld-picker">
        <view class="meld-picker-tabs">
          <view
            wx:for="{{['m', 'p', 's', 'z']}}"
            wx:key="*this"
            class="meld-picker-tab {{meldSuit === item ? 'active' : ''}}"
            data-suit="{{item}}"
            bindtap="onMeldSuitChange"
          >{{item === 'm' ? '万' : item === 'p' ? '筒' : item === 's' ? '索' : '字'}}</view>
        </view>
        <view class="meld-picker-tiles">
          <view wx:if="{{meldSuit !== 'z'}}" class="meld-picker-row">
            <view
              wx:for="{{[1,2,3,4,5,6,7,8,9]}}"
              wx:key="*this"
              class="meld-picker-tile"
              data-suit="{{meldSuit}}"
              data-value="{{item}}"
              bindtap="onSelectMeldTile"
            >
              <text class="mp-value">{{item}}</text>
            </view>
          </view>
          <view wx:if="{{meldSuit !== 'z'}}" class="meld-picker-row">
            <view class="meld-picker-tile red" data-suit="{{meldSuit}}" data-value="5" data-red="true" bindtap="onSelectMeldTile">
              <text class="mp-value">赤5</text>
            </view>
          </view>
          <view wx:if="{{meldSuit === 'z'}}" class="meld-picker-row">
            <view
              wx:for="{{[1,2,3,4,5,6,7]}}"
              wx:key="*this"
              class="meld-picker-tile"
              data-suit="z"
              data-value="{{item}}"
              bindtap="onSelectMeldTile"
            >
              <text class="mp-value">{{honorNames[item]}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="meld-editor-actions">
        <button class="meld-cancel-btn" bindtap="cancelMeld">取消</button>
        <button class="meld-confirm-btn" bindtap="confirmMeld">确定</button>
      </view>
    </view>
  </view>

  <!-- 结果弹窗 - 半屏式 -->
  <view class="result-sheet {{showResult ? 'show' : ''}}" catchtouchmove="{{true}}" wx:if="{{result}}">
    <view class="sheet-mask" bindtap="onCloseResult"></view>
    <view class="sheet-content">
      <view class="sheet-header">
        <view class="sheet-handle"></view>
        <view class="result-score">
          <text class="score-label">{{result.score.limitName || (result.score.fu + '符' + result.score.han + '翻')}}</text>
          <text class="score-value">{{result.score.grandTotal}}</text>
          <text class="score-unit">点</text>
        </view>
        <view class="score-detail">
          <text wx:if="{{result.score.isTsumo && result.score.isParent}}">子家每人 {{result.score.payments.allPay}} 点</text>
          <text wx:elif="{{result.score.isTsumo && !result.score.isParent}}">亲 {{result.score.payments.parentPay}} / 子 {{result.score.payments.childPay}}</text>
          <text wx:else>{{result.score.isParent ? '子家' : (result.score.fromParent ? '亲家' : '子家')}}支付</text>
        </view>
      </view>

      <view class="sheet-body">
        <!-- 役种 -->
        <view class="result-block">
          <text class="block-title">役种</text>
          <view class="yaku-chips">
            <view class="yaku-chip" wx:for="{{result.yakuList}}" wx:key="id">
              <text class="yaku-name">{{item.name}}</text>
              <text class="yaku-han">{{item.han >= 13 ? '役满' : item.han + '翻'}}</text>
            </view>
          </view>
        </view>

        <!-- 宝牌 -->
        <view class="result-block" wx:if="{{result.doraCount.total > 0}}">
          <text class="block-title">宝牌 +{{result.doraCount.total}}翻</text>
          <view class="dora-info">
            <text wx:if="{{result.doraCount.dora > 0}}">表{{result.doraCount.dora}}</text>
            <text wx:if="{{result.doraCount.uraDora > 0}}">里{{result.doraCount.uraDora}}</text>
            <text wx:if="{{result.doraCount.akaDora > 0}}">赤{{result.doraCount.akaDora}}</text>
          </view>
        </view>

        <!-- 符数明细 -->
        <view class="result-block" wx:if="{{result.fu.details.length > 1}}">
          <text class="block-title">符数明细</text>
          <view class="fu-details">
            <view class="fu-row" wx:for="{{result.fu.details}}" wx:key="name">
              <text class="fu-name">{{item.name}}</text>
              <text class="fu-val">{{item.fu}}符</text>
            </view>
          </view>
        </view>

        <!-- 本场供托加算 -->
        <view class="result-block" wx:if="{{result.score.honbaBonus > 0 || result.score.kyoutakuBonus > 0}}">
          <text class="block-title">加算</text>
          <view class="bonus-info">
            <text wx:if="{{result.score.honbaBonus > 0}}">本场 +{{result.score.honbaBonus}}</text>
            <text wx:if="{{result.score.kyoutakuBonus > 0}}">供托 +{{result.score.kyoutakuBonus}}</text>
          </view>
        </view>
      </view>

      <view class="sheet-footer">
        <button class="close-btn" bindtap="onCloseResult">关闭</button>
      </view>
    </view>
  </view>
</view>

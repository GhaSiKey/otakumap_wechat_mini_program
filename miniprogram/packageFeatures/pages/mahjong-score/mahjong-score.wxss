/* 日麻点数计算器：夜鸦牌桌主题 */
page {
  --mahjong-bg: #0a0a14;
  --mahjong-surface: rgba(255, 255, 255, 0.06);
  --mahjong-surface-strong: #141428;
  --mahjong-border: rgba(255, 255, 255, 0.1);
  --mahjong-text: #f7efe4;
  --mahjong-muted: rgba(247, 239, 228, 0.58);
  --mahjong-faint: rgba(247, 239, 228, 0.34);
  --mahjong-purple: #9d4edd;
  --mahjong-coral: #ff6b6b;
  --mahjong-teal: #00d4aa;
  --mahjong-gold: #ffd93d;
  --mahjong-danger: #ff7b86;
}

@media (prefers-color-scheme: light) {
  page {
    --mahjong-bg: #f6f4f2;
    --mahjong-surface: rgba(255, 255, 255, 0.9);
    --mahjong-surface-strong: #ffffff;
    --mahjong-border: rgba(30, 25, 38, 0.12);
    --mahjong-text: #241d2b;
    --mahjong-muted: rgba(36, 29, 43, 0.6);
    --mahjong-faint: rgba(36, 29, 43, 0.38);
    --mahjong-purple: #7036a7;
    --mahjong-coral: #e94d59;
    --mahjong-teal: #087f71;
    --mahjong-gold: #a86f00;
    --mahjong-danger: #c53445;
  }
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(env(safe-area-inset-bottom) + 390rpx);
  box-sizing: border-box;
  color: var(--mahjong-text);
  background: var(--mahjong-bg);
  background-image: radial-gradient(circle at 80% 0, rgba(157, 78, 221, 0.14), transparent 42%), radial-gradient(circle at 0 45%, rgba(0, 212, 170, 0.08), transparent 38%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-header, .summary-row, .card-heading, .section-heading, .settings-header, .agari-row, .calculate-row, .picker-toggle, .sheet-header, .payment-row, .fu-row {
  display: flex;
  align-items: center;
}

.page-header {
  margin-bottom: 26rpx;
}

.brand-mark {
  width: 58rpx;
  height: 58rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #17111c;
  background: var(--mahjong-gold);
  font-size: 34rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 217, 61, 0.22);
}

.page-title-group { flex: 1; }
.page-title { display: block; font-family: Georgia, "Songti SC", serif; font-size: 42rpx; font-weight: 600; letter-spacing: 2rpx; }
.page-subtitle { display: block; margin-top: 4rpx; color: var(--mahjong-muted); font-size: 21rpx; }
.header-help { width: 56rpx; height: 56rpx; border: 1rpx solid var(--mahjong-border); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--mahjong-muted); font-size: 30rpx; }

.summary-card, .hand-card, .section-card, .settings-panel {
  background: var(--mahjong-surface);
  border: 1rpx solid var(--mahjong-border);
  border-radius: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.14);
}

.summary-card { padding: 22rpx; margin-bottom: 18rpx; }
.summary-row { justify-content: space-between; }
.wind-group { flex: 1; }
.summary-label { display: block; margin-bottom: 10rpx; color: var(--mahjong-muted); font-size: 22rpx; }
.wind-buttons, .seat-buttons { display: flex; }
.wind-button, .seat-button { min-width: 62rpx; min-height: 62rpx; margin-right: 10rpx; border: 1rpx solid var(--mahjong-border); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--mahjong-muted); font-size: 26rpx; }
.wind-button.active, .seat-button.active { color: var(--mahjong-text); border-color: var(--mahjong-teal); background: rgba(0, 212, 170, 0.22); box-shadow: 0 0 0 5rpx rgba(0, 212, 170, 0.08); }
.seat-group { min-width: 120rpx; margin-left: 12rpx; }
.seat-value { width: 62rpx; height: 62rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--mahjong-text); background: var(--mahjong-purple); font-size: 28rpx; }
.seat-buttons { margin-top: 18rpx; padding-top: 14rpx; border-top: 1rpx solid var(--mahjong-border); }
.seat-button { min-width: 54rpx; min-height: 48rpx; border-radius: 14rpx; margin-right: 8rpx; }
.win-type { display: flex; margin-top: 18rpx; padding: 4rpx; border: 1rpx solid var(--mahjong-border); border-radius: 18rpx; }
.win-type-option { flex: 1; min-height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; color: var(--mahjong-muted); font-size: 28rpx; }
.win-type-option.active { color: #fff; background: var(--mahjong-coral); box-shadow: 0 8rpx 20rpx rgba(255, 107, 107, 0.18); }

.hand-card { padding: 24rpx; margin-bottom: 18rpx; }
.card-heading { justify-content: space-between; margin-bottom: 20rpx; }
.card-title { display: block; font-size: 30rpx; font-weight: 600; }
.card-caption { display: block; margin-top: 6rpx; color: var(--mahjong-muted); font-size: 21rpx; }
.ready-state { padding: 8rpx 14rpx; border-radius: 12rpx; color: var(--mahjong-muted); background: rgba(255,255,255,0.05); font-size: 20rpx; }
.ready-state.ready { color: var(--mahjong-teal); background: rgba(0,212,170,0.13); }
.tile-grid { display: flex; flex-wrap: wrap; min-height: 164rpx; align-content: flex-start; }
.tile, .tile-slot, .agari-slot {
  width: 56rpx;
  height: 78rpx;
  margin: 0 8rpx 10rpx 0;
  border-radius: 10rpx;
  box-sizing: border-box;
}
.tile { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid rgba(0,0,0,0.08); background: #f8f0df; box-shadow: 0 5rpx 0 #b0a694, 0 8rpx 14rpx rgba(0,0,0,0.18); }
.tile:active { transform: translateY(2rpx); box-shadow: 0 3rpx 0 #b0a694, 0 5rpx 10rpx rgba(0,0,0,0.14); }
.tile-value { color: #25202b; font-family: Georgia, "Songti SC", serif; font-size: 30rpx; font-weight: 700; line-height: 1; }
.tile-suit { margin-top: 5rpx; color: #675d64; font-size: 15rpx; line-height: 1; }
.tile-m .tile-value { color: #b33445; }
.tile-p .tile-value { color: #195aa8; }
.tile-s .tile-value { color: #16744d; }
.tile-z .tile-value { color: #26202b; font-size: 25rpx; }
.tile.red { background: #fff0e8; box-shadow: 0 5rpx 0 #d39a82, 0 8rpx 14rpx rgba(180,65,55,0.18); }
.tile.red .tile-value { color: #c63c44; }
.tile-slot { border: 1rpx dashed rgba(247,239,228,0.22); display: flex; align-items: center; justify-content: center; color: var(--mahjong-faint); font-size: 34rpx; }
.agari-row { justify-content: space-between; padding-top: 18rpx; border-top: 1rpx solid var(--mahjong-border); }
.agari-label text { display: block; }
.agari-hint { margin-top: 5rpx; color: var(--mahjong-faint); font-size: 19rpx; }
.agari-action { min-width: 86rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; }
.agari-slot { width: 62rpx; height: 84rpx; margin: 0; border: 1rpx dashed var(--mahjong-gold); display: flex; align-items: center; justify-content: center; color: var(--mahjong-gold); font-size: 34rpx; }
.tile-agari { width: 62rpx; height: 84rpx; margin: 0; box-shadow: 0 0 0 4rpx rgba(255,217,61,0.38), 0 7rpx 0 #b0a694, 0 10rpx 18rpx rgba(0,0,0,0.2); }
.error-banner { display: flex; align-items: center; margin-top: 16rpx; padding: 14rpx 16rpx; border: 1rpx solid rgba(255,123,134,0.36); border-radius: 14rpx; color: var(--mahjong-danger); background: rgba(255,123,134,0.1); font-size: 22rpx; }
.error-icon { width: 34rpx; height: 34rpx; margin-right: 10rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--mahjong-danger); color: #fff; font-weight: 700; }

.section-card { padding: 22rpx; margin-bottom: 18rpx; }
.section-heading { justify-content: space-between; }
.text-action { min-width: 88rpx; min-height: 64rpx; display: flex; align-items: center; justify-content: flex-end; color: var(--mahjong-teal); font-size: 23rpx; }
.empty-meld { margin-top: 18rpx; padding: 24rpx; border: 1rpx dashed var(--mahjong-border); border-radius: 16rpx; text-align: center; color: var(--mahjong-muted); font-size: 22rpx; }
.meld-list { margin-top: 18rpx; }
.meld-item { display: flex; align-items: center; min-height: 96rpx; margin-bottom: 12rpx; padding: 10rpx 12rpx; border-radius: 16rpx; background: rgba(0,0,0,0.13); }
.meld-kind { width: 62rpx; color: var(--mahjong-muted); font-size: 20rpx; }
.meld-tiles { display: flex; flex: 1; }
.tile-sm { width: 42rpx; height: 60rpx; margin-right: 5rpx; border-radius: 7rpx; }
.tile-sm .tile-value { font-size: 22rpx; }
.tile-sm .tile-suit { margin-top: 2rpx; font-size: 11rpx; }
.remove-hint { color: var(--mahjong-faint); font-size: 19rpx; }
.settings-list { margin-bottom: 22rpx; }
.settings-panel { margin-bottom: 12rpx; overflow: hidden; }
.settings-header { min-height: 92rpx; padding: 16rpx 20rpx; box-sizing: border-box; }
.settings-icon { width: 48rpx; height: 48rpx; margin-right: 14rpx; border-radius: 15rpx; display: flex; align-items: center; justify-content: center; color: var(--mahjong-text); background: rgba(255,255,255,0.1); font-family: Georgia, serif; }
.settings-icon.accent { color: #fff; background: var(--mahjong-purple); }
.settings-icon.gold { color: #291f04; background: var(--mahjong-gold); }
.settings-copy { flex: 1; }
.settings-title { display: block; font-size: 26rpx; }
.settings-summary { display: block; margin-top: 4rpx; color: var(--mahjong-muted); font-size: 20rpx; }
.settings-chevron { color: var(--mahjong-muted); font-size: 30rpx; }
.settings-body { padding: 0 20rpx 20rpx; border-top: 1rpx solid var(--mahjong-border); }
.chip-row { display: flex; flex-wrap: wrap; padding-top: 16rpx; }
.option-chip { min-height: 58rpx; margin: 0 10rpx 10rpx 0; padding: 0 18rpx; border: 1rpx solid var(--mahjong-border); border-radius: 18rpx; display: flex; align-items: center; color: var(--mahjong-muted); font-size: 22rpx; }
.option-chip text { margin-left: 8rpx; color: var(--mahjong-faint); font-size: 18rpx; }
.option-chip.selected { border-color: var(--mahjong-teal); color: var(--mahjong-teal); background: rgba(0,212,170,0.12); }
.option-chip.disabled { opacity: .4; }
.counter-row { display: flex; padding-top: 18rpx; }
.counter-item { flex: 1; display: flex; align-items: center; justify-content: space-between; margin-right: 16rpx; color: var(--mahjong-muted); font-size: 23rpx; }
.counter { display: flex; align-items: center; border: 1rpx solid var(--mahjong-border); border-radius: 14rpx; overflow: hidden; color: var(--mahjong-text); }
.counter text { width: 44rpx; text-align: center; }
.counter-btn { width: 58rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; color: var(--mahjong-text); background: rgba(255,255,255,0.06); font-size: 30rpx; }
.indicator-row { display: flex; align-items: center; padding-top: 18rpx; color: var(--mahjong-muted); font-size: 22rpx; }
.indicator-row > text { width: 110rpx; }
.indicator-tiles { display: flex; flex-wrap: wrap; align-items: center; }
.tile-add { width: 42rpx; height: 60rpx; border: 1rpx dashed var(--mahjong-border); border-radius: 7rpx; display: flex; align-items: center; justify-content: center; color: var(--mahjong-faint); font-size: 28rpx; }

.bottom-dock { position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; padding: 12rpx 24rpx calc(env(safe-area-inset-bottom) + 12rpx); background: rgba(10,10,20,0.96); border-top: 1rpx solid var(--mahjong-border); box-sizing: border-box; }
@media (prefers-color-scheme: light) { .bottom-dock { background: rgba(246,244,242,0.97); } }
.calculate-row { padding-bottom: 10rpx; }
.calculate-button { width: 100%; height: 76rpx; border: 0; border-radius: 18rpx; color: var(--mahjong-muted); background: rgba(255,255,255,0.1); font-size: 28rpx; }
.calculate-button.ready { color: #fff; background: var(--mahjong-coral); box-shadow: 0 10rpx 25rpx rgba(255,107,107,0.22); }
.picker-toggle { justify-content: space-between; min-height: 54rpx; color: var(--mahjong-muted); font-size: 20rpx; }
.picker-mode { display: flex; justify-content: space-between; padding: 10rpx 0; color: var(--mahjong-gold); font-size: 21rpx; }
.picker-mode view { color: var(--mahjong-muted); }
.tile-picker { padding-top: 8rpx; }
.picker-tabs, .meld-suit-tabs { display: flex; border-bottom: 1rpx solid var(--mahjong-border); }
.picker-tab { flex: 1; min-height: 54rpx; display: flex; align-items: center; justify-content: center; color: var(--mahjong-muted); font-size: 21rpx; }
.picker-tab.active { color: var(--mahjong-teal); border-bottom: 4rpx solid var(--mahjong-teal); }
.picker-grid { display: flex; flex-wrap: wrap; justify-content: center; padding-top: 12rpx; }
.picker-tile { width: 58rpx; height: 68rpx; margin: 0 5rpx 8rpx; border-radius: 9rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #24202b; background: #f8f0df; box-shadow: 0 4rpx 0 #b0a694; font-family: Georgia, serif; }
.picker-tile text { font-size: 28rpx; font-weight: 700; line-height: 1; }
.picker-tile small { margin-top: 4rpx; color: #6d6265; font-size: 13rpx; }
.picker-tile:active { transform: translateY(2rpx); }
.picker-tile.tile-m text { color: #b33445; }
.picker-tile.tile-p text { color: #195aa8; }
.picker-tile.tile-s text { color: #16744d; }
.picker-tile.red-picker { background: #ffe7de; }
.picker-tile.red-picker text { color: #c63c44; font-size: 22rpx; }
.picker-tile.honor-picker text { color: #26202b; font-size: 24rpx; }

.meld-editor, .result-sheet { position: fixed; z-index: 100; inset: 0; visibility: hidden; opacity: 0; transition: opacity .2s ease; }
.meld-editor.show, .result-sheet.show { visibility: visible; opacity: 1; }
.meld-editor-mask, .sheet-mask { position: absolute; inset: 0; background: rgba(0,0,0,0.68); }
.meld-editor-content, .sheet-content { position: absolute; left: 24rpx; right: 24rpx; bottom: 20rpx; max-height: calc(100vh - 80rpx); overflow: hidden; border: 1rpx solid var(--mahjong-border); border-radius: 28rpx; color: var(--mahjong-text); background: var(--mahjong-surface-strong); transform: translateY(30rpx); transition: transform .24s ease; }
.meld-editor.show .meld-editor-content, .result-sheet.show .sheet-content { transform: translateY(0); }
.modal-header { display: flex; justify-content: space-between; padding: 24rpx; border-bottom: 1rpx solid var(--mahjong-border); font-size: 30rpx; }
.modal-header view { color: var(--mahjong-muted); font-size: 38rpx; }
.meld-type-selector { display: flex; padding: 18rpx 22rpx 4rpx; }
.meld-type-btn { flex: 1; min-height: 56rpx; margin-right: 8rpx; border: 1rpx solid var(--mahjong-border); border-radius: 13rpx; display: flex; align-items: center; justify-content: center; color: var(--mahjong-muted); font-size: 21rpx; }
.meld-type-btn.active { color: var(--mahjong-teal); border-color: var(--mahjong-teal); background: rgba(0,212,170,0.12); }
.edit-preview { padding: 16rpx 22rpx; color: var(--mahjong-muted); font-size: 20rpx; }
.edit-preview .meld-tiles { margin-top: 12rpx; min-height: 62rpx; }
.meld-editor-content .picker-grid { padding: 14rpx 18rpx; }
.meld-editor-content .picker-tile { width: 50rpx; height: 60rpx; }
.modal-actions { display: flex; padding: 12rpx 22rpx 22rpx; }
.modal-actions button, .sheet-footer button { flex: 1; height: 72rpx; margin: 0 6rpx; border: 1rpx solid var(--mahjong-border); border-radius: 16rpx; color: var(--mahjong-muted); background: transparent; font-size: 25rpx; }
.modal-actions button.primary, .sheet-footer button { color: #fff; border: 0; background: var(--mahjong-coral); }

.sheet-content { left: 0; right: 0; bottom: 0; max-height: 86vh; border-radius: 30rpx 30rpx 0 0; }
.sheet-handle { width: 90rpx; height: 8rpx; margin: 14rpx auto 4rpx; border-radius: 8rpx; background: var(--mahjong-faint); }
.sheet-header { justify-content: space-between; padding: 18rpx 28rpx 20rpx; }
.sheet-kicker { display: block; color: var(--mahjong-muted); font-size: 21rpx; }
.sheet-total { display: block; margin-top: 6rpx; font-family: Georgia, serif; font-size: 66rpx; font-weight: 700; letter-spacing: 2rpx; }
.sheet-meta { display: block; margin-top: 4rpx; color: var(--mahjong-muted); font-size: 21rpx; }
.limit-label { padding: 12rpx 16rpx; border: 1rpx solid rgba(255,217,61,0.42); border-radius: 12rpx; color: var(--mahjong-gold); background: rgba(255,217,61,0.1); font-size: 22rpx; }
.sheet-body { max-height: 58vh; padding: 0 24rpx; box-sizing: border-box; }
.payment-card, .result-block { margin-bottom: 16rpx; padding: 18rpx; border: 1rpx solid var(--mahjong-border); border-radius: 18rpx; background: rgba(0,0,0,0.12); }
.block-title { display: block; margin-bottom: 14rpx; font-size: 24rpx; font-weight: 600; }
.payment-row { justify-content: space-between; min-height: 48rpx; color: var(--mahjong-muted); font-size: 22rpx; }
.payment-row strong, .fu-row strong { color: var(--mahjong-text); font-size: 25rpx; }
.payment-extra, .dora-summary { margin-top: 10rpx; color: var(--mahjong-gold); font-size: 19rpx; }
.yaku-chips { display: flex; flex-wrap: wrap; }
.yaku-chip { margin: 0 8rpx 8rpx 0; padding: 9rpx 12rpx; border-radius: 10rpx; color: var(--mahjong-teal); background: rgba(0,212,170,0.12); font-size: 20rpx; }
.fu-row { justify-content: space-between; min-height: 44rpx; color: var(--mahjong-muted); font-size: 21rpx; }
.fu-row.total { margin-top: 8rpx; padding-top: 10rpx; border-top: 1rpx solid var(--mahjong-border); color: var(--mahjong-text); }
.sheet-footer { display: flex; padding: 12rpx 24rpx calc(env(safe-area-inset-bottom) + 16rpx); }

.inline-small { margin-left: 6rpx; color: var(--mahjong-muted); font-size: 17rpx; }
.strong { color: var(--mahjong-text); font-size: 25rpx; }
.total-unit { margin-left: 8rpx; align-self: flex-end; padding-bottom: 10rpx; font-size: 24rpx; }

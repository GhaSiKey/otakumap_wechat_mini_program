/* 日麻点数计算器样式 - 霓虹夜鸦主题 */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a14 0%, #141428 100%);
  padding: 24rpx;
  box-sizing: border-box;
}

/* ==================== 卡片 ==================== */

.card {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  backdrop-filter: blur(10px);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #9d4edd;
  padding: 8rpx 16rpx;
}

.card-body {
  padding: 24rpx 28rpx;
}

/* ==================== 表单元素 ==================== */

.row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.row:last-child {
  margin-bottom: 0;
}

.field {
  flex: 1;
}

.label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}

/* 风牌选择器 */
.wind-selector {
  display: flex;
  gap: 12rpx;
}

.wind-btn {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  transition: all 0.3s ease;
}

.wind-btn.active {
  background: rgba(157, 78, 221, 0.3);
  border-color: #9d4edd;
  color: #ffffff;
  box-shadow: 0 0 10rpx rgba(157, 78, 221, 0.5);
}

/* 切换按钮组 */
.toggle-group {
  display: flex;
  gap: 12rpx;
}

.toggle-btn {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  transition: all 0.3s ease;
}

.toggle-btn.active {
  background: rgba(0, 212, 255, 0.2);
  border-color: #00d4ff;
  color: #00d4ff;
}

/* 数字输入 */
.number-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.num-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  font-size: 36rpx;
  color: #ffffff;
}

.num-value {
  min-width: 60rpx;
  text-align: center;
  font-size: 32rpx;
  color: #00d4ff;
  font-weight: 600;
}

/* 复选框 */
.checkbox-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.checkbox-row:last-child {
  margin-bottom: 0;
}

.checkbox-row.indent {
  margin-left: 48rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.checkbox.checked {
  background: #9d4edd;
  border-color: #9d4edd;
}

.checkbox-inner {
  width: 20rpx;
  height: 20rpx;
  background: transparent;
  border-radius: 4rpx;
}

.checkbox.checked .checkbox-inner {
  background: #ffffff;
}

.checkbox-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* ==================== 牌 ==================== */

.tile-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hand-tiles {
  min-height: 100rpx;
}

.tile {
  width: 60rpx;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  position: relative;
  transition: all 0.2s ease;
}

.tile-m {
  background: linear-gradient(135deg, #1e3a5f 0%, #2d4a6f 100%);
  border: 1rpx solid rgba(255, 217, 61, 0.3);
}

.tile-m .tile-value,
.tile-m .tile-suit {
  color: #ffd93d;
}

.tile-p {
  background: linear-gradient(135deg, #3d1e1e 0%, #4d2e2e 100%);
  border: 1rpx solid rgba(255, 107, 157, 0.3);
}

.tile-p .tile-value,
.tile-p .tile-suit {
  color: #ff6b9d;
}

.tile-s {
  background: linear-gradient(135deg, #1e3d2f 0%, #2e4d3f 100%);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
}

.tile-s .tile-value,
.tile-s .tile-suit {
  color: #00d4ff;
}

.tile-z {
  background: linear-gradient(135deg, #2d2d3d 0%, #3d3d4d 100%);
  border: 1rpx solid rgba(255, 217, 61, 0.3);
}

.tile-z .tile-value {
  color: #ffd93d;
  font-size: 32rpx;
}

.tile-red {
  background: linear-gradient(135deg, #4a1a1a 0%, #6a2a2a 100%) !important;
  border-color: rgba(255, 71, 87, 0.5) !important;
  box-shadow: 0 0 10rpx rgba(255, 71, 87, 0.3);
}

.tile-red .tile-value,
.tile-red .tile-suit {
  color: #ff4757 !important;
}

.tile-value {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.tile-suit {
  font-size: 18rpx;
  margin-top: 4rpx;
  opacity: 0.8;
}

.tile-add {
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx dashed rgba(255, 255, 255, 0.3);
}

.add-icon {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.5);
}

.tile-agari {
  box-shadow: 0 0 15rpx rgba(157, 78, 221, 0.5);
  border-color: #9d4edd !important;
}

.red-mark {
  position: absolute;
  top: 2rpx;
  right: 4rpx;
  font-size: 16rpx;
  color: #ff4757;
}

/* ==================== 宝牌区 ==================== */

.dora-section {
  margin-bottom: 24rpx;
}

.dora-section:last-child {
  margin-bottom: 0;
}

/* ==================== 手牌区 ==================== */

.hand-section {
  margin-bottom: 24rpx;
}

.agari-section {
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

/* ==================== 计算按钮 ==================== */

.calculate-btn {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #9d4edd 0%, #7b2cbf 100%);
  border-radius: 48rpx;
  margin: 32rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(157, 78, 221, 0.4);
}

.btn-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 4rpx;
}

/* ==================== 弹窗 ==================== */

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.modal.show {
  visibility: visible;
  opacity: 1;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.modal-content {
  position: relative;
  width: 100%;
  max-height: 80vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #0f0f1a 100%);
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.5);
}

.modal-body {
  padding: 24rpx 32rpx 48rpx;
  max-height: 60vh;
  overflow-y: auto;
}

/* 牌选择器 */
.tile-group {
  margin-bottom: 32rpx;
}

.tile-group:last-child {
  margin-bottom: 0;
}

.group-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 16rpx;
}

.tile-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* ==================== 结果弹窗 ==================== */

.result-modal .modal-body {
  padding-bottom: 64rpx;
}

.result-score {
  text-align: center;
  padding: 32rpx 0;
  margin-bottom: 32rpx;
  background: rgba(157, 78, 221, 0.1);
  border-radius: 16rpx;
}

.score-limit {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffd93d;
  margin-bottom: 8rpx;
}

.score-fu-han {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.score-total {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #00d4ff;
  text-shadow: 0 0 20rpx rgba(0, 212, 255, 0.5);
}

.score-payment {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
}

.result-section {
  margin-bottom: 32rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 16rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.yaku-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.yaku-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
}

.yaku-name {
  font-size: 30rpx;
  color: #ffffff;
}

.yaku-han {
  font-size: 28rpx;
  color: #9d4edd;
  font-weight: 600;
}

.dora-detail {
  display: flex;
  gap: 24rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.fu-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.fu-item {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.fu-value {
  color: #00d4ff;
}

/* 追番小结页 —— 卡片式五块，亮暗走 TDesign --td-* 变量 */

/* 身份色变量定义在 page 真实根节点（教训：定义在 .page 会让子树/弹层继承断裂）。
   本页无弹层，但仍照 board-history 约定放 page，保持一致。 */
page {
  --sb-color-me: #0052d9;
  --sb-color-peer: #834ec2;
  /* 身份色的 R,G,B 分量（与上面 hex 同色，供 rgba() 调透明度用）。
     头部 hero 卡的渐变底用半透明身份色：叠亮卡=浅蓝浅紫，叠暗卡自动变暗，亮暗都成立。 */
  --sb-me-rgb: 0, 82, 217;
  --sb-peer-rgb: 131, 78, 194;
  /* 火苗色（单一色源）：连击/火苗自成一套暖色视觉语言，与身份蓝/紫解耦。
     以 R,G,B 分量存，供 rgba() 调透明度复用（背景微染/投影/脉冲/辉光同色）。
     暗色不覆写：火在暗处本就更亮，同色即可；半透明背景会自动叠底层深卡，亮暗都成立。 */
  --sb-fire-rgb: 237, 123, 47;
  background: var(--td-bg-color-page, #f5f5f5);
  /* 入场动效参数（集中管理，避免散落）：卡片上浮时长/缓动、逐卡步进、柱子生长步进 */
  --sb-in-dur: 0.7s; /* 单卡上浮时长（放慢：0.5→0.7） */
  --sb-in-ease: cubic-bezier(0.22, 0.61, 0.36, 1); /* ease-out 收尾，入场不回弹 */
  --sb-in-step: 0.12s; /* 逐卡递延步进（放慢：0.07→0.12，节奏更从容） */
  --sb-bar-step: 0.06s; /* 柱子逐列递延步进（放慢：0.04→0.06） */
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 卡片外壳 */
.card {
  background: var(--td-bg-color-container, #fff);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 区块小标题 */
.sec-title {
  font-size: 26rpx;
  color: var(--td-text-color-secondary, #888);
  margin-bottom: 20rpx;
}
.sec-title--weak {
  font-size: 24rpx;
  color: var(--td-text-color-placeholder, #bbb);
}

/* 身份色应用 */
.identity--me {
  background: var(--sb-color-me);
}
.identity--peer {
  background: var(--sb-color-peer);
}
.identity-fg--me .ep-num {
  color: var(--sb-color-me);
}
.identity-fg--peer .ep-num {
  color: var(--sb-color-peer);
}
/* ① 头部 hero 卡：整卡蓝→紫渐变底（半透明身份色叠卡，亮暗自适应），巨号天数成焦点 */
.head {
  text-align: center;
  padding: 48rpx 32rpx 40rpx;
  /* 左上偏「我」蓝、右下偏「TA」紫的对角渐变，象征两人相连；透明度低，不抢巨号数字 */
  background:
    linear-gradient(
      135deg,
      rgba(var(--sb-me-rgb), 0.14) 0%,
      rgba(var(--sb-me-rgb), 0.06) 42%,
      rgba(var(--sb-peer-rgb), 0.08) 58%,
      rgba(var(--sb-peer-rgb), 0.16) 100%
    ),
    var(--td-bg-color-container, #fff);
}
.head-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.dot {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 圆点浮在渐变底上，加与身份色同色的柔投影强化立体，呼应「相连」 */
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}
.identity--me.dot { box-shadow: 0 6rpx 16rpx rgba(var(--sb-me-rgb), 0.35); }
.identity--peer.dot { box-shadow: 0 6rpx 16rpx rgba(var(--sb-peer-rgb), 0.35); }
/* 连线：由灰细线改蓝→紫渐变，视觉上「相连」而非「断开」 */
.dot-link {
  width: 72rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, var(--sb-color-me), var(--sb-color-peer));
  margin: 0 -8rpx;
  z-index: 0;
}
/* 巨号天数：前缀小字 + 超大数字（焦点）+ 单位小字，基线对齐 */
.head-days {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 10rpx;
}
.head-days__label {
  font-size: 30rpx;
  color: var(--td-text-color-secondary, #888);
}
.head-days__num {
  font-size: 88rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--td-text-color-primary, #222);
  font-variant-numeric: tabular-nums;
}
.head-days__unit {
  font-size: 30rpx;
  color: var(--td-text-color-secondary, #888);
}
/* 副信息：起始日 · 一起追了 N 部番，弱化不抢数字 */
.head-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--td-text-color-placeholder, #bbb);
}

/* ② 变化区 MAIN —— 推得最猛的番清单 */
.ri-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.ri-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
/* 封面：竖版番剧比例，与门面番卡同一套色块/首字兜底 */
.ri-cover {
  width: 72rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--td-bg-color-component, #e7e7e7);
}
.ri-cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}
.ri-main {
  flex: 1;
  min-width: 0;
}
.ri-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #222);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ri-eps {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
/* 双人集数：数字吃身份色（identity-fg--me/peer 里的 .ri-ep），话字统一灰 */
.ri-ep {
  font-size: 32rpx;
  font-weight: 700;
}
.identity-fg--me.ri-ep {
  color: var(--sb-color-me);
}
.identity-fg--peer.ri-ep {
  color: var(--sb-color-peer);
}
.ri-ep-unit {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
}
/* 合计 + 环比方向同一行，左合计右方向 */
.change-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--td-component-stroke, #eee);
}
.change-total {
  font-size: 26rpx;
  color: var(--td-text-color-secondary, #888);
}
.change-momentum {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #333);
}
.change-lead {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
  margin-top: 12rpx;
}

/* ② 空窗召回 */
.recall {
  text-align: center;
  padding: 44rpx 32rpx;
}
.recall-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #333);
  margin-bottom: 12rpx;
}
.recall-text {
  font-size: 26rpx;
  color: var(--td-text-color-secondary, #888);
}

/* 图表标题行：左标题 + 右上角翻周控件 */
.chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.chart-head__title {
  margin-bottom: 0; /* 标题在 flex 行内，取消 sec-title 的下间距 */
}
/* 翻周控件：‹ 周标签 ›，标签定宽避免「本周/上周/M月D日」切换时抖动 */
.week-nav {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.week-nav__btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
  color: var(--td-text-color-primary, #333);
  background: var(--td-bg-color-component, #f0f0f0);
}
.week-nav__btn--off {
  color: var(--td-text-color-disabled, #ccc);
  opacity: 0.5;
}
.week-nav__label {
  min-width: 120rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
}
/* 横滑翻周容器：swiper 需显式定高（内容高度 = 汇总行 + 柱区 + 轴标） */
.week-swiper {
  height: 300rpx;
}
.week-swiper__item {
  box-sizing: border-box;
}
/* 当周汇总：几部番·几话，左对齐弱化，不抢柱子 */
.week-summary {
  text-align: left;
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
  margin-bottom: 16rpx;
}

/* 每日追番柱状图（双色堆叠柱，纯 view + 高度百分比，无 canvas 无三方库） */
.chart-plot {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  height: 200rpx;
  padding-top: 8rpx;
}
.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}
/* 柱容器：定高，段从底部往上堆（我在下、TA 叠其上） */
.chart-bar-wrap {
  width: 100%;
  max-width: 40rpx;
  height: 170rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: stretch;
}
.chart-seg {
  width: 100%;
}
/* 圆角只加在最顶那段（有 TA 时是紫段、否则是「我」段），柱底贴基线保持直角 */
.chart-seg--top {
  border-radius: 8rpx 8rpx 0 0;
}
.chart-seg--me {
  background: var(--sb-color-me);
}
.chart-seg--peer {
  background: var(--sb-color-peer);
}
/* 零柱：极浅基线，示意「这天没追」而非缺列 */
.chart-bar-zero {
  width: 100%;
  height: 4rpx;
  align-self: flex-end;
  background: var(--td-component-border, #ddd);
  border-radius: 4rpx;
}
/* 轴标：仅周X（去掉日期数字后单行居中）；周末用对方色加重区分 */
.chart-axis {
  display: flex;
  justify-content: center;
  line-height: 1.25;
  margin-top: 10rpx;
}
.chart-axis__wd {
  font-size: 22rpx;
  color: var(--td-text-color-secondary, #888);
}
.chart-axis--weekend .chart-axis__wd {
  color: var(--sb-color-peer);
  font-weight: 600;
}
/* 未来日（本周还没到）：轴标弱化，与已过日区分「还没追」而非「没追」 */
.chart-axis--future .chart-axis__wd {
  color: var(--td-text-color-placeholder, #bbb);
  opacity: 0.5;
}
.chart-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 20rpx;
}
.chart-lg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--td-text-color-secondary, #888);
}
.chart-lg__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}
.chart-empty {
  text-align: center;
  font-size: 24rpx;
  color: var(--td-text-color-placeholder, #bbb);
  padding: 32rpx 0;
}

/* ③ 名场面三徽章 */
.badges {
  display: flex;
  justify-content: space-between;
}
.badge {
  flex: 1;
  text-align: center;
  padding: 8rpx;
}
.badge-icon {
  font-size: 44rpx;
  line-height: 1.2;
}
.badge-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #333);
  margin: 8rpx 0 4rpx;
}
.badge-label {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder, #bbb);
}
/* 徽章副标题：挂到具体番/日期，两行内收窄不撑破三列布局 */
.badge-sub {
  font-size: 20rpx;
  color: var(--td-text-color-placeholder, #bbb);
  margin-top: 6rpx;
  line-height: 1.3;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ④ 累计：本命番 Hero */
.hero {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 20rpx;
  border-radius: 16rpx;
  /* 双人身份色淡渐变底，呼应「你俩的本命」 */
  background: linear-gradient(120deg, var(--td-brand-color-1, #f2f3ff), var(--td-bg-color-container, #fff));
  margin-bottom: 24rpx;
}
.hero-cover {
  width: 120rpx;
  height: 160rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  background: var(--td-bg-color-component, #e7e7e7);
}
.hero-cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 56rpx;
  font-weight: 600;
}
.hero-main {
  flex: 1;
  min-width: 0;
}
.hero-tag {
  display: inline-block;
  font-size: 20rpx;
  color: var(--td-brand-color, #0052d9);
  background: var(--td-brand-color-1, #f2f3ff);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-bottom: 10rpx;
}
.hero-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--td-text-color-primary, #222);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-eps {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
  margin-bottom: 4rpx;
}
.hero-pair {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder, #bbb);
}

/* 三统计格（累计 + 个人共用） */
.stat-grid {
  display: flex;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--td-text-color-primary, #222);
}
.stat-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--td-text-color-secondary, #888);
  margin-left: 4rpx;
}
.stat-label {
  font-size: 22rpx;
  color: var(--td-text-color-secondary, #888);
  margin-top: 6rpx;
}
/* ⑤ 个人连续追番火苗（Duolingo 式打卡钩子）。
   暖色系不吃身份蓝——「火苗/连击」自成一套视觉语言，与追番进度的蓝/紫解耦。
   火色用 TDesign 警示色阶（--td-warning-color 橙），亮暗自动切换，无硬编码色值。 */
.streak {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}
/* 点亮态：半透明火色微染底（替代 --td-warning-color-1）。
   TDesign 暗色只覆写了 warning-color-5，warning-color-1 暗色下仍是近白 #fff1e9 会成刺眼白块；
   改用 rgba 火色叠底：亮色叠白卡≈原浅橙观感不变，暗色叠深卡=暖色微染，一值适配亮暗。 */
.streak--on {
  background: rgba(var(--sb-fire-rgb), 0.1);
}
.streak--on .streak-flame {
  font-size: 80rpx; /* 与超大天数呼应，火苗压得住场 */
  filter: drop-shadow(0 0 8rpx rgba(var(--sb-fire-rgb), 0.5));
}
/* 熄灭态：灰底、火苗去色缩小，引导重新点火 */
.streak--off {
  background: var(--td-bg-color-component, #f0f0f0);
}
.streak--off .streak-flame {
  font-size: 48rpx;
  filter: grayscale(1) opacity(0.5);
}
/* 紧迫态（宽限内今天还没追）：脉冲呼吸，制造「别断」的心理压力 */
.streak--urgent {
  animation: streakPulse 1.6s ease-in-out infinite;
}
@keyframes streakPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(var(--sb-fire-rgb), 0); }
  50% { box-shadow: 0 0 0 6rpx rgba(var(--sb-fire-rgb), 0.18); }
}
.streak-flame {
  flex-shrink: 0;
  line-height: 1;
}
.streak-main {
  flex: 1;
  min-width: 0;
}
/* 左侧标签「连续追番」：与副行/提示同列，正常文字节奏，不撑行高 */
.streak-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--td-warning-color, #ed7b2f);
  line-height: 1.2;
}
/* 右侧超大天数块：独占卡片右侧空白区，垂直居中，数字与「天」基线对齐 */
.streak-count {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  color: var(--td-warning-color, #ed7b2f);
  line-height: 1;
}
.streak-count__num {
  font-size: 96rpx; /* 超大数字：抽离首行后可放到最大，天数一眼可见 */
  font-weight: 800;
  font-variant-numeric: tabular-nums; /* 等宽数字，位数变化不跳动 */
}
.streak-count__unit {
  font-size: 28rpx;
  font-weight: 600;
}
.streak-sub {
  font-size: 22rpx;
  color: var(--td-text-color-secondary, #888);
  margin-top: 4rpx;
}
.streak-hint {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
  margin-top: 8rpx;
}
/* 熄灭态提示更弱化 */
.streak--off .streak-hint {
  color: var(--td-text-color-placeholder, #bbb);
}

/* ⑤ 个人小结：我最近在推（轻量单行清单，区别于双人「推得最猛」的分列大数字） */
.my-recent {
  margin-bottom: 24rpx;
}
.my-recent__title {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
  margin-bottom: 16rpx;
}
.mr-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.mr-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.mr-cover {
  width: 56rpx;
  height: 76rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: var(--td-bg-color-component, #e7e7e7);
}
.mr-cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.mr-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--td-text-color-primary, #333);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 我方话数：吃身份色（identity-fg--me），与推得最猛同一套色语言 */
.mr-ep {
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.identity-fg--me.mr-ep {
  color: var(--sb-color-me);
}
.my-recent__total {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--td-component-stroke, #eee);
}

/* ⑤ 个人小结：足迹 + 三状态封面组 */
.personal-footprint {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #333);
  margin-bottom: 24rpx;
}
.pg-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.pg-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.pg-label {

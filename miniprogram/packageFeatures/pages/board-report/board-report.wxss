/* footnote */
.footnote {
  text-align: center;
  font-size: 22rpx;
  color: var(--td-text-color-placeholder, #bbb);
  margin-top: 8rpx;
}

/* 失败态 */
.state {
  padding-top: 200rpx;
  text-align: center;
}
.state-text {

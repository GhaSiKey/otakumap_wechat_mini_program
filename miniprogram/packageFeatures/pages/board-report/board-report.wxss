/* 一起追完的番封面色带 */
.done-strip {
  margin-top: 24rpx;
}
.done-strip__title {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
  margin-bottom: 16rpx;
}
.done-strip__covers {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.done-cover {
  width: 88rpx;
  height: 118rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--td-bg-color-component, #e7e7e7);
}
.done-cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
}
/* 溢出角标：+N，与封面等高的灰块 */
.done-more {
  width: 88rpx;
  height: 118rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--td-text-color-secondary, #888);

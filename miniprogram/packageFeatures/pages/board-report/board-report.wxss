  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
.pg-more {
  width: 72rpx;
  height: 96rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--td-text-color-secondary, #888);
  background: var(--td-bg-color-component, #e7e7e7);

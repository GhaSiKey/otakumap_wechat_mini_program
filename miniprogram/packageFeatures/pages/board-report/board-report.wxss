  font-weight: 600;
  color: var(--td-text-color-primary, #444);
}
.pg-covers {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
/* 个人封面块：比累计「一起追完的」略小，弱化收尾不抢视线 */
.pg-cover {
  width: 72rpx;
  height: 96rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: var(--td-bg-color-component, #e7e7e7);

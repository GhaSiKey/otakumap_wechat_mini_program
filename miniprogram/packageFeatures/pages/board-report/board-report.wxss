/* 追番小结页 —— 卡片式五块，亮暗走 TDesign --td-* 变量 */

/* 身份色变量定义在 page 真实根节点（教训：定义在 .page 会让子树/弹层继承断裂）。
   本页无弹层，但仍照 board-history 约定放 page，保持一致。 */
page {
  --sb-color-me: #0052d9;
  --sb-color-peer: #834ec2;
  background: var(--td-bg-color-page, #f5f5f5);
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 卡片外壳 */
.card {
  background: var(--td-bg-color-container, #fff);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 区块小标题 */
.sec-title {
  font-size: 26rpx;
  color: var(--td-text-color-secondary, #888);
  margin-bottom: 20rpx;
}
.sec-title--weak {
  font-size: 24rpx;
  color: var(--td-text-color-placeholder, #bbb);
}

/* 身份色应用 */
.identity--me {
  background: var(--sb-color-me);
}
.identity--peer {
  background: var(--sb-color-peer);
}
.identity-fg--me .ep-num {
  color: var(--sb-color-me);
}
.identity-fg--peer .ep-num {
  color: var(--sb-color-peer);
}
/* ① 头部 */
.head {
  text-align: center;
  padding: 44rpx 32rpx;
}
.head-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.dot {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dot-link {
  width: 64rpx;
  height: 4rpx;
  background: var(--td-component-border, #ddd);
  margin: 0 -8rpx;
  z-index: 0;
}
.head-days {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #222);
}

/* ② 变化区 MAIN —— 推得最猛的番清单 */
.ri-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.ri-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
/* 封面：竖版番剧比例，与门面番卡同一套色块/首字兜底 */
.ri-cover {
  width: 72rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--td-bg-color-component, #e7e7e7);
}
.ri-cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}
.ri-main {
  flex: 1;
  min-width: 0;
}
.ri-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #222);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ri-eps {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
/* 双人集数：数字吃身份色（identity-fg--me/peer 里的 .ri-ep），话字统一灰 */
.ri-ep {
  font-size: 32rpx;
  font-weight: 700;
}
.identity-fg--me.ri-ep {
  color: var(--sb-color-me);
}
.identity-fg--peer.ri-ep {
  color: var(--sb-color-peer);
}
.ri-ep-unit {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
}
/* 合计 + 环比方向同一行，左合计右方向 */
.change-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--td-component-stroke, #eee);
}
.change-total {
  font-size: 26rpx;
  color: var(--td-text-color-secondary, #888);
}
.change-momentum {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #333);
}
.change-lead {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
  margin-top: 12rpx;
}

/* ② 空窗召回 */
.recall {
  text-align: center;
  padding: 44rpx 32rpx;
}
.recall-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #333);
  margin-bottom: 12rpx;
}
.recall-text {
  font-size: 26rpx;
  color: var(--td-text-color-secondary, #888);
}

/* 每日追番柱状图（双色堆叠柱，纯 view + 高度百分比，无 canvas 无三方库） */
.chart-plot {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  height: 200rpx;
  padding-top: 8rpx;
}
.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}
/* 柱容器：定高，段从底部往上堆（我在下、TA 叠其上） */
.chart-bar-wrap {
  width: 100%;
  max-width: 40rpx;
  height: 170rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: stretch;
}
.chart-seg {
  width: 100%;
}
/* 圆角只加在最顶那段（有 TA 时是紫段、否则是「我」段），柱底贴基线保持直角 */
.chart-seg--top {
  border-radius: 8rpx 8rpx 0 0;
}
.chart-seg--me {
  background: var(--sb-color-me);
}
.chart-seg--peer {
  background: var(--sb-color-peer);
}
/* 零柱：极浅基线，示意「这天没追」而非缺列 */
.chart-bar-zero {
  width: 100%;
  height: 4rpx;
  align-self: flex-end;
  background: var(--td-component-border, #ddd);
  border-radius: 4rpx;
}
/* 轴标两行：上行周X（淡）、下行日（略深）；周末整体加重区分 */
.chart-axis {
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.25;
  margin-top: 10rpx;
}
.chart-axis__wd {
  font-size: 18rpx;
  color: var(--td-text-color-placeholder, #bbb);
}
.chart-axis__day {
  font-size: 20rpx;
  color: var(--td-text-color-secondary, #888);
}
.chart-axis--weekend .chart-axis__wd,
.chart-axis--weekend .chart-axis__day {
  color: var(--sb-color-peer);
  font-weight: 600;
}
.chart-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 20rpx;
}
.chart-lg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--td-text-color-secondary, #888);
}
.chart-lg__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}
.chart-empty {
  text-align: center;
  font-size: 24rpx;
  color: var(--td-text-color-placeholder, #bbb);
  padding: 32rpx 0;
}

/* ③ 名场面三徽章 */
.badges {
  display: flex;
  justify-content: space-between;
}
.badge {
  flex: 1;
  text-align: center;
  padding: 8rpx;
}
.badge-icon {
  font-size: 44rpx;
  line-height: 1.2;
}
.badge-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #333);
  margin: 8rpx 0 4rpx;
}
.badge-label {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder, #bbb);
}
/* 徽章副标题：挂到具体番/日期，两行内收窄不撑破三列布局 */
.badge-sub {
  font-size: 20rpx;
  color: var(--td-text-color-placeholder, #bbb);
  margin-top: 6rpx;
  line-height: 1.3;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ④ 累计：本命番 Hero */
.hero {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 20rpx;
  border-radius: 16rpx;
  /* 双人身份色淡渐变底，呼应「你俩的本命」 */
  background: linear-gradient(120deg, var(--td-brand-color-1, #f2f3ff), var(--td-bg-color-container, #fff));
  margin-bottom: 24rpx;
}
.hero-cover {
  width: 120rpx;
  height: 160rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  background: var(--td-bg-color-component, #e7e7e7);
}
.hero-cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 56rpx;
  font-weight: 600;
}
.hero-main {
  flex: 1;
  min-width: 0;
}
.hero-tag {
  display: inline-block;
  font-size: 20rpx;
  color: var(--td-brand-color, #0052d9);
  background: var(--td-brand-color-1, #f2f3ff);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-bottom: 10rpx;
}
.hero-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--td-text-color-primary, #222);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-eps {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
  margin-bottom: 4rpx;
}
.hero-pair {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder, #bbb);
}

/* 三统计格（累计 + 个人共用） */
.stat-grid {
  display: flex;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--td-text-color-primary, #222);
}
.stat-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--td-text-color-secondary, #888);
  margin-left: 4rpx;
}
.stat-label {
  font-size: 22rpx;
  color: var(--td-text-color-secondary, #888);
  margin-top: 6rpx;
}
/* ⑤ 个人小结：我最近在推（轻量单行清单，区别于双人「推得最猛」的分列大数字） */
.my-recent {
  margin-bottom: 24rpx;
}
.my-recent__title {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
  margin-bottom: 16rpx;
}
.mr-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.mr-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.mr-cover {
  width: 56rpx;
  height: 76rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: var(--td-bg-color-component, #e7e7e7);
}
.mr-cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.mr-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--td-text-color-primary, #333);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 我方话数：吃身份色（identity-fg--me），与推得最猛同一套色语言 */
.mr-ep {
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.identity-fg--me.mr-ep {
  color: var(--sb-color-me);
}
.my-recent__total {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--td-component-stroke, #eee);
}

/* ⑤ 个人小结：足迹 + 三状态封面组 */
.personal-footprint {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #333);
  margin-bottom: 24rpx;
}
.pg-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.pg-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.pg-label {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
}
.pg-count {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #444);
}
.pg-covers {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
/* 个人封面块：比累计「一起追完的」略小，弱化收尾不抢视线 */
.pg-cover {
  width: 72rpx;
  height: 96rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: var(--td-bg-color-component, #e7e7e7);
}
.pg-cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
.pg-more {
  width: 72rpx;
  height: 96rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--td-text-color-secondary, #888);
  background: var(--td-bg-color-component, #e7e7e7);
}

/* 一起追完的番封面色带 */
.done-strip {
  margin-top: 24rpx;
}
.done-strip__title {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
  margin-bottom: 16rpx;
}
.done-strip__covers {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.done-cover {
  width: 88rpx;
  height: 118rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--td-bg-color-component, #e7e7e7);
}
.done-cover--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
}
/* 溢出角标：+N，与封面等高的灰块 */
.done-more {
  width: 88rpx;
  height: 118rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--td-text-color-secondary, #888);
  background: var(--td-bg-color-component, #e7e7e7);
}
/* footnote */
.footnote {
  text-align: center;
  font-size: 22rpx;
  color: var(--td-text-color-placeholder, #bbb);
  margin-top: 8rpx;
}

/* 失败态 */
.state {
  padding-top: 200rpx;
  text-align: center;
}
.state-text {
  font-size: 28rpx;
  color: var(--td-text-color-secondary, #888);
}

/* 骨架 */
.sk-card {
  background: var(--td-bg-color-container, #fff);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}
.sk-head {
  height: 200rpx;
}
.sk-change {
  height: 240rpx;
}
.sk-badges {
  height: 180rpx;
}

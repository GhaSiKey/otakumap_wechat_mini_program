/* 骨架 */
.sk-card {
  background: var(--td-bg-color-container, #fff);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}
.sk-head {
  height: 200rpx;
}
.sk-change {
  height: 240rpx;
}
.sk-badges {
  height: 180rpx;
}

/* ============ 入场动效 ============
   原则：只在进页面播一次、动完即静止。全用 transform+opacity（GPU 合成，不触发重排），
   暗模式无影响；参数走 page 上的 --sb-in-* 变量，不散落硬编码。 */

/* 1) 卡片逐张上浮淡入（主菜）：从下方 32rpx 处淡入，按位序 --in-N 错峰 */
.card--in {
  opacity: 0;
  animation: sbCardIn var(--sb-in-dur) var(--sb-in-ease) both;
}
.card--in-1 { animation-delay: calc(var(--sb-in-step) * 0); }
.card--in-2 { animation-delay: calc(var(--sb-in-step) * 1); }
.card--in-3 { animation-delay: calc(var(--sb-in-step) * 2); }
.card--in-4 { animation-delay: calc(var(--sb-in-step) * 3); }
.card--in-5 { animation-delay: calc(var(--sb-in-step) * 4); }
.card--in-6 { animation-delay: calc(var(--sb-in-step) * 5); }
@keyframes sbCardIn {
  from { opacity: 0; transform: translateY(32rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 2) 柱状图逐列「长」上来（点睛）：scaleY 0→1 + transform-origin:bottom，
   不改高度布局（高度仍是 JS 算的百分比），只做视觉生长。按列 --i 错峰，从左往右铺开。
   卡片入场需先播完（延迟叠加卡片位序 3 的 --in-step*2），再开始长柱。 */
.chart-bar-wrap--grow {
  transform: scaleY(0);
  transform-origin: bottom;
  animation: sbBarGrow 0.6s var(--sb-in-ease) both;
  animation-delay: calc(var(--sb-in-step) * 2 + var(--sb-bar-step) * var(--i));
}
@keyframes sbBarGrow {
  from { transform: scaleY(0); }
  to { transform: scaleY(1); }
}

/* 3a) 火苗（点亮态）：入场回弹 pop → 播完接持续摇曳，让火「活着烧」而非僵住，呼应连续不灭。
   两条动画叠加：pop 播一次（both 保持终态），flicker 无限循环，delay 排在 pop 之后无缝接上。
   transform-origin 设在火根，摆动像真火从底部窜。熄灭态火苗不播（死火不动）。 */
.streak--on .streak-flame {
  transform-origin: bottom center;
  animation: sbFlamePop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both,
             sbFlameFlicker 2.6s ease-in-out infinite;
  animation-delay: calc(var(--sb-in-step) * 5), /* pop：跟随 personal 卡（位序 6）入场后 */
                   calc(var(--sb-in-step) * 5 + 0.5s); /* flicker：接在 pop（0.5s）播完之后 */
}
@keyframes sbFlamePop {
  0% { opacity: 0; transform: scale(0.3); }
  100% { opacity: 1; transform: scale(1); }
}
/* 火苗摇曳：非等比 scale（窜动）+ 小幅 rotate（摆动），幅度克制不抽搐 */
@keyframes sbFlameFlicker {
  0%, 100% { transform: scale(1) rotate(0deg); }
  25% { transform: scale(1.06, 0.97) rotate(-2deg); }
  50% { transform: scale(0.98, 1.05) rotate(1.5deg); }
  75% { transform: scale(1.04, 0.99) rotate(-1deg); }
}
/* 3c) 大天数「余温」辉光呼吸（点亮态）：橙色 text-shadow 明暗循环，像数字还带着火的温度。
   复用 --sb-fire-rgb 单一火色源，暗色下火色不变、深底上辉光更醒目。 */
.streak--on .streak-count__num {
  animation: sbEmberGlow 2.6s ease-in-out infinite;
  animation-delay: calc(var(--sb-in-step) * 5); /* 与火苗同步，personal 卡入场后 */
}
@keyframes sbEmberGlow {
  0%, 100% { text-shadow: 0 0 8rpx rgba(var(--sb-fire-rgb), 0.25); }
  50% { text-shadow: 0 0 22rpx rgba(var(--sb-fire-rgb), 0.55); }
}
/* 3b) 头部巨号天数：数字单独放大浮现（焦点强调），前后缀随整块淡入。
   数字延迟略晚于卡片入场，形成「卡片先到、数字后弹」的节奏。 */
.head-days__num {
  animation: sbCountPop 0.6s var(--sb-in-ease) both;
  animation-delay: calc(var(--sb-in-step) * 2);
}
@keyframes sbCountPop {
  0% { opacity: 0; transform: scale(0.7); }
  70% { transform: scale(1.08); } /* 轻微过冲，再回落，弹性收尾 */
  100% { opacity: 1; transform: scale(1); }
}
/* 副信息随后淡入，垫在数字之后 */
.head-sub {
  animation: sbFadeUp 0.5s var(--sb-in-ease) both;
  animation-delay: calc(var(--sb-in-step) * 3);
}
@keyframes sbFadeUp {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

page { background: #f8f7f3; }
.page { min-height: 100vh; box-sizing: border-box; padding: 22rpx 24rpx calc(142rpx + env(safe-area-inset-bottom)); background: radial-gradient(circle at 100% 0, rgba(242,118,112,.12), transparent 34%), #f8f7f3; }
.state { min-height: 70vh; display: flex; align-items: center; justify-content: center; color: #66708a; font-size: 25rpx; }
.state--error { color: #e34d59; }
.export-canvas { position: fixed; top: -1600px; left: -1600px; opacity: 0; pointer-events: none; }
@media (prefers-color-scheme: dark) {
  page, .page { background: #000; }
  .state { color: rgba(255,255,255,.56); }
  .state--error { color: #e34d59; }
}

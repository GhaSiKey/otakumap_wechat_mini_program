<view class="page" wx:if="{{vm}}">

  <!-- ============ 成员条 ============ -->
  <view class="member-bar">
    <view class="member member--tappable" bindtap="onEditProfileTap">
      <!-- 头像区：可点设置角标常驻（不随头像/首字母分支消失），保住「点这里改资料」的可发现性 -->
      <view class="m-avatar-wrap">
        <!-- 头像失败兜底：不开云存储时对方常读不到 cloud:// 头像，image binderror 回退首字母色块 -->
        <image
          wx:if="{{vm.me.avatar && !meAvatarError}}"
          class="m-avatar-img"
          src="{{vm.me.avatar}}"
          mode="aspectFill"
          binderror="onMeAvatarError"
        />
        <view wx:else class="m-fallback identity--me {{vm.me.openid ? '' : 'identity--pending'}}">
          {{vm.me.nickname ? vm.me.nickname[0] : '我'}}
        </view>
        <view class="m-set-badge">+</view>
      </view>
      <text class="m-name">{{vm.me.nickname || '设置我' }}</text>
    </view>
    <!-- 配对后：对方；筹备态：虚位空椅（钩子，非灰置） -->
    <view class="member {{justJoined ? 'member-joined' : ''}}" wx:if="{{vm.peer}}">
      <text class="m-name">{{vm.peer.nickname || 'TA'}}</text>
      <image
        wx:if="{{vm.peer.avatar && !peerAvatarError}}"
        class="m-avatar-img"
        src="{{vm.peer.avatar}}"
        mode="aspectFill"
        binderror="onPeerAvatarError"
      />
      <view wx:else class="m-fallback identity--peer">{{vm.peer.nickname ? vm.peer.nickname[0] : 'TA'}}</view>
    </view>
    <view class="member" wx:else>
      <text class="m-name hint">等 TA 加入</text>
      <view class="ghost-seat">?</view>
    </view>
  </view>

  <!-- ============ 「TA 更新了」信息条（进板结算一次，展示对方在我上次查看后的新动向）============ -->
  <!-- 点击收起。用 TA 身份色 --sb-color-peer 呼应，与「N 部能一起聊」（绿）区分开 -->
  <view wx:if="{{showPeerUpdate}}" class="peer-update" bindtap="onDismissPeerUpdate">
    <text class="peer-update__icon">{{peerUpdateCopy.ICON}}</text>
    <text class="peer-update__text">{{peerUpdateText}}</text>
    <text class="peer-update__close">✕</text>
  </view>

  <!-- ============ 共同话题带（门面核心卖点：N 部能一起聊）============ -->
  <!-- 不再常驻：仅当 commonCount 变大时（又多一部能聊）短暂弹出提醒，3.5s 自动收起。点击滚到分区。 -->
  <view
    wx:if="{{vm.peer && vm.commonCount > 0 && showCommonTalk}}"
    class="common-talk common-talk--flash"
    bindtap="onTapCommonTalk"
  >
    <text class="common-talk__icon">{{commonTalk.ICON}}</text>
    <text class="common-talk__text">又多一部能一起聊，共 {{vm.commonCount}} 部</text>
    <text class="common-talk__arrow">›</text>
  </view>

  <!-- ============ 筹备态邀请横幅（单人，紧凑不挡番单）============ -->
  <view wx:if="{{vm.phase === 'waiting'}}" class="invite-banner">
    <view class="invite-banner__text">
      <view class="invite-banner__title">就等 TA 来一起追</view>
      <view class="invite-banner__sub">先把想追的番堆进来，TA 加入就能看到</view>
    </view>
    <button class="invite-banner__btn" open-type="share">邀请 TA</button>
  </view>

  <!-- ============ 归档态提示 ============ -->
  <t-notice-bar wx:if="{{vm.phase === 'archived'}}" theme="warning" content="这个板已归档，只能查看" />

  <!-- ============ 番单（分区 + 同轴集数轴）============ -->
  <!-- 筹备态也显示番单（能加番、追进度）；双人 UI 靠 it.pair.hasPeer 天然隐藏 -->
  <block>
    <!-- 番单空：引导加番 -->
    <view wx:if="{{vm.sections.length === 0}}" class="list-empty">
      <view class="list-empty__text">{{vm.peer ? '还没加番，点右下角加一部吧' : '先把想追的番加进来'}}</view>
    </view>

    <view class="section" id="section-{{sec.sectionKey}}" wx:for="{{vm.sections}}" wx:key="sectionKey" wx:for-item="sec">
      <view class="section-title">{{sec.title}}</view>

      <view
        class="item-card {{it.itemId === syncItemId ? 'item-card--sync' : ''}}"
        wx:for="{{sec.items}}"
        wx:key="itemId"
        wx:for-item="it"
        data-item-id="{{it.itemId}}"
        bindtap="onItemTap"
      >
        <!-- 左侧封面：撑满卡片高度的竖版展示区。有真图（弹play https 外链）则渲染，
             加载失败 binderror 回退首字色块；无图直接首字色块。
             coverErrorIds 记失败的 itemId，避免每次渲染重试闪烁 -->
        <view class="item-cover-wrap">
          <image
            wx:if="{{it.cover && !coverErrorIds[it.itemId]}}"
            class="item-cover-img"
            src="{{it.cover}}"
            mode="aspectFill"
            lazy-load
            data-item-id="{{it.itemId}}"
            binderror="onItemCoverError"
          />
          <view wx:else class="item-cover-ph" style="background:{{it.coverFallback.color}}">{{it.coverFallback.char}}</view>
        </view>

        <!-- 右侧内容列：番名/状态、进度轴、双人进度说明 -->
        <view class="item-body">
        <!-- 番名 + 状态标签 -->
        <view class="item-head">
          <view class="item-head__main">
            <text class="item-name">{{it.name}}</text>
            <!-- 放送元信息：「放送中 · 12集 · 周六更新」一句灰字，更新日已并入 subtitle 同权重呈现 -->
            <text wx:if="{{it.subtitle}}" class="item-sub">{{it.subtitle}}</text>
          </view>
          <t-tag wx:if="{{statusLabels[it.pair.mine.status]}}" size="small" variant="light" theme="{{statusTagTheme[it.pair.mine.status] || 'default'}}">{{statusLabels[it.pair.mine.status]}}</t-tag>
        </view>

        <!-- 同轴集数轴 -->
        <view class="axis">
          <view class="axis-track"></view>
          <!-- 已走过段：追平时染 success 绿，与合并态 ◉ 呼应，让「一起走到这里」是绿色整体 -->
          <view class="axis-common {{it.pair.isOverlap ? 'axis-common--sync' : ''}}" style="width:{{it.pair.commonPercent}}%"></view>
          <view
            wx:if="{{it.pair.hasPeer}}"
            class="axis-lead"
            style="left:{{it.pair.minePercent < it.pair.peerPercent ? it.pair.minePercent : it.pair.peerPercent}}%;width:{{it.pair.leadWidth}}%"
          ></view>
          <!-- 追平重叠：两游标收拢成一个 ◉ 合并态 + success 光晕（情绪峰值，isOverlap 由 transform 算） -->
          <view wx:if="{{it.pair.isOverlap}}" class="axis-cursor cursor--merged" style="left:{{it.pair.minePercent}}%">
            <view class="cursor-dot cursor-dot--merged">◉</view>
          </view>
          <block wx:else>
            <!-- 我的游标（弃番则灰化：下车了，不再前进） -->
            <view class="axis-cursor cursor--mine" style="left:{{it.pair.minePercent}}%">
              <view class="cursor-dot {{it.pair.mineDropped ? 'cursor-dot--dropped' : 'identity--me'}}">我</view>
            </view>
            <!-- 对方游标 -->
            <view wx:if="{{it.pair.hasPeer}}" class="axis-cursor cursor--peer" style="left:{{it.pair.peerPercent}}%">
              <view class="cursor-dot {{it.pair.peerDropped ? 'cursor-dot--dropped' : 'identity--peer'}}">TA</view>
            </view>
          </block>
          <!-- 有分母：末端「终点桩」标出闭区间终点（有底），与无分母的右端渐隐互斥 -->
          <view wx:if="{{it.pair.hasTotalEp}}" class="axis-goal"></view>
          <!-- 无分母右端渐隐（不知道还有多长） -->
          <view wx:else class="axis-fade"></view>
        </view>

        <!-- 进度摘要：配对态显示双人对比（措辞精确，配色走蓝不走红）；筹备态只显示自己 -->
        <!-- 弃番者不说「还差/领先」（追赶叙事失效），改说「已下车」；本人弃番则「我 已下车」 -->
        <view class="item-diff">
          <text wx:if="{{it.pair.mineDropped}}" class="dropped-txt">我 已下车（第{{it.pair.mine.ep}}话）</text>
          <text wx:else>我 第{{it.pair.mine.ep}}话</text>
          <block wx:if="{{vm.peer}}">
            <text wx:if="{{it.pair.hasPeer && it.pair.peerDropped}}" class="dropped-txt"> · TA 已下车（第{{it.pair.peer.ep}}话）</text>
            <text wx:elif="{{it.pair.hasPeer}}"> · TA 第{{it.pair.peer.ep}}话</text>
            <text wx:else class="hint"> · TA 还没翻牌</text>
            <!-- 追赶/同步文案仅在双方都没弃番时才有意义 -->
            <block wx:if="{{it.pair.hasPeer && !it.pair.eitherDropped}}">
              <text wx:if="{{it.pair.lead === 'even'}}" class="sync"> · 同步 🎉</text>
              <text wx:elif="{{it.pair.lead !== 'none'}}" class="lead-txt"> · {{it.pair.lead === 'mine' ? 'TA 还差 ' + it.pair.diff + ' 话追上' : 'TA 领先 ' + it.pair.diff + ' 话'}}</text>
            </block>
          </block>
        </view>

        <!-- 超出预设提示：某方集数已超过设定的总集数（漏设/特别篇），点击改总集数纠正 -->
        <view
          wx:if="{{it.pair.epExceedsTotal}}"
          class="exceed-hint"
          catchtap="onExceedHintTap"
          data-item-id="{{it.itemId}}"
        >{{totalEpCopy.EXCEED_HINT}}</view>
        </view>
      </view>
    </view>

    <!-- 加番 FAB：筹备态和配对态都能加，仅归档态隐藏（t-fab 抛 click 事件） -->
    <t-fab wx:if="{{vm.phase !== 'archived'}}" icon="add" text="加番" bind:click="onAddTap" />
  </block>


</view>

<!-- 加载骨架屏 -->
<view wx:if="{{loading}}" class="sb-skeleton">
  <view class="skeleton-memberbar"></view>
  <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
    <view class="skeleton-cover"></view>
    <view class="skeleton-body">
      <view class="skeleton-line skeleton-line--title"></view>
      <view class="skeleton-axis"></view>
      <view class="skeleton-line skeleton-line--meta"></view>
    </view>
  </view>
</view>

<!-- ============ 加番弹层 ============ -->
<t-popup visible="{{showAdd}}" placement="bottom" close-on-overlay-click bind:visible-change="onAddVisibleChange">
  <view class="sheet">
    <view class="sheet__handle"></view>
    <view class="sheet__header"><text class="sheet__title">添加番剧</text></view>
    <view class="sheet__body">

      <!-- ① 搜索区（推荐主路径）：未选中显示搜索入口；已选中换成封面预览卡（wx:else 须紧跟 wx:if，中间不能夹注释） -->
      <block wx:if="{{!newItemPicked}}">
        <view class="add-search-block" bindtap="onAddSearchTap">
          <view class="add-search-block__main">
            <t-icon name="search" size="40rpx" />
            <view class="add-search-block__text">
              <view class="add-search-block__title">{{animeBindCopy.SEARCH_TITLE}}</view>
              <view class="add-search-block__sub">{{animeBindCopy.SEARCH_ENTRY}}</view>
            </view>
          </view>
          <t-icon name="chevron-right" size="36rpx" class="add-search-block__arrow" />
        </view>
      </block>
      <view wx:else class="picked-preview">
        <image
          wx:if="{{newItemCover && !newItemCoverError}}"
          class="picked-preview__cover"
          src="{{newItemCover}}"
          mode="aspectFill"
          binderror="onAddCoverError"
        />
        <view wx:else class="picked-preview__cover picked-preview__cover--fallback" style="background:{{newItemFallback.color}}">{{newItemFallback.char}}</view>
        <view class="picked-preview__info">
          <view class="picked-preview__name">{{newItemName}}</view>
          <view class="picked-preview__hint">{{animeBindCopy.PICKED_HINT}}</view>
        </view>
        <view class="picked-preview__reselect" catchtap="onReselectAnime">{{animeBindCopy.RESELECT}}</view>
      </view>

      <!-- ② 手填区：分隔标题随状态走——未选中「或手动填写」（另一条路），已选中「确认信息（可修改）」（带回的可编辑区，非手动） -->
      <view class="add-divider"><text class="add-divider__label">{{newItemPicked ? animeBindCopy.EDIT_TITLE : animeBindCopy.MANUAL_TITLE}}</text></view>

      <t-input placeholder="输入番剧名称" value="{{newItemName}}" maxlength="60" bind:change="onItemNameInput" />

      <!-- 总集数（选填）：自建步进器 −/输入/+，不引 t-stepper（免构建 npm） -->
      <view class="ep-stepper-row">
        <text class="ep-stepper-row__label">{{totalEpCopy.TOTAL_EP_LABEL}}</text>
        <view class="ep-stepper">
          <view class="ep-stepper__btn {{!newItemTotalEp ? 'is-disabled' : ''}}" bindtap="onAddTotalEpDec">−</view>
          <input
            class="ep-stepper__input"
            type="number"
            placeholder="选填"
            value="{{newItemTotalEp}}"
            bind:input="onAddTotalEpInput"
          />
          <view class="ep-stepper__btn" bindtap="onAddTotalEpInc">+</view>
        </view>
      </view>
      <view class="sheet__note ep-stepper-hint">{{totalEpCopy.ADD_HINT}}</view>

      <t-button theme="primary" size="large" block loading="{{adding}}" bindtap="onConfirmAdd">添加</t-button>
    </view>
  </view>
</t-popup>

<!-- ============ P3 进度详情弹层 ============ -->
<t-popup visible="{{showDetail}}" placement="bottom" close-on-overlay-click bind:visible-change="onDetailVisibleChange">
  <view class="sheet detail-panel" wx:if="{{detailItem}}">
    <view class="sheet__handle"></view>

    <!-- 番名：默认展示可点改名；进入编辑态原地切成独立编辑区（不再叠第二层弹窗） -->
    <block wx:if="{{!editingName}}">
      <view class="sheet__header">
        <text class="sheet__title detail-name" bindtap="onEditItemTap">{{detailItem.name}}</text>
        <t-icon name="edit-1" size="36rpx" class="detail-name__edit" bindtap="onEditItemTap" />
      </view>
      <!-- 番剧信息行（放送状态 · 共X集）：常显可点，点开番剧信息编辑弹层。
           未设总集数时显示「未设置」引导补录，而非藏起来（藏了就没有录入入口） -->
      <view class="detail-sub detail-sub--tappable" bindtap="onItemInfoTap">
        <text wx:if="{{detailItem.subtitle}}">{{detailItem.subtitle}}</text>
        <text wx:else class="hint">{{totalEpCopy.TOTAL_EP_LABEL}}{{totalEpCopy.TOTAL_EP_UNSET}}</text>
        <text class="detail-sub__arrow">›</text>
      </view>
    </block>

    <!-- 改名编辑区：标题 + 带边框输入框 + 说明 + 底部按钮行，垂直堆叠 -->
    <view wx:else class="name-edit-panel">
      <view class="name-edit-panel__title">改番名</view>
      <input
        class="name-edit-input"
        value="{{editName}}"
        maxlength="60"
        focus="{{editingName}}"
        placeholder="输入番剧名"
        confirm-type="done"
        bind:input="onEditNameInput"
        bind:confirm="onConfirmEdit"
      />
      <view class="name-edit-panel__note">番名两人共享，改了 TA 也会看到</view>
      <view class="name-edit-panel__actions">
        <view class="name-edit-action name-edit-action--cancel" bindtap="onCancelEditName">取消</view>
        <view class="name-edit-action name-edit-action--save {{savingEdit ? 'is-loading' : ''}}" bindtap="onConfirmEdit">保存</view>
      </view>
    </view>

    <!-- 编辑番名时收起操作区，只留改名，避免视觉噪声 -->
    <view class="sheet__body" wx:if="{{!editingName}}">
      <!-- 左右对峙。编辑入口内嵌到「我」列：点集数改话数、点状态改状态（各带铅笔 icon）。
           TA 列是对方进度、我无权改，纯展示不可点。 -->
      <view class="duel">
        <view class="duel-col">
          <view class="m-fallback big identity--me">我</view>
          <!-- 我的集数：可点改话数 -->
          <view class="duel-ep-wrap duel-editable" bindtap="onEpTap">
            <view class="duel-ep {{epBump ? 'ep-bump' : ''}}">第{{detailItem.pair.mine.ep}}话</view>
            <t-icon name="edit-1" size="24rpx" class="duel-edit-icon" />
            <!-- +1 浮起动画：点「看完这集」时从集数位置浮起上升淡出 -->
            <text wx:if="{{epBump}}" class="ep-plus-fly">+1</text>
          </view>
          <!-- 我的状态：可点改状态 -->
          <view class="duel-status duel-editable" bindtap="onStatusTap">
            <text>{{statusLabels[detailItem.pair.mine.status] || '未设'}}</text>
            <t-icon name="edit-1" size="22rpx" class="duel-edit-icon" />
          </view>
        </view>
        <view class="duel-col" wx:if="{{detailItem.pair.hasPeer}}">
          <view class="m-fallback big identity--peer">TA</view>
          <view class="duel-ep">第{{detailItem.pair.peer.ep}}话</view>
          <view class="duel-status">{{statusLabels[detailItem.pair.peer.status] || '未设'}}</view>
        </view>
        <view class="duel-col" wx:else>
          <view class="ghost-breathing">?</view>
          <view class="duel-ep hint">{{vm.peer ? '还没翻牌' : '等 TA 加入'}}</view>
        </view>
      </view>

      <!-- 主手势：+1（最高频，乐观 UI 无确认） -->
      <t-button theme="primary" size="large" block bindtap="onEpInc">看完一集 +1</t-button>

      <!-- 移出番单（软删，措辞软、不叫删除；低调置底，轻确认防误触） -->
      <view class="detail-remove" bindtap="onRemoveItemTap">移出番单</view>
    </view>
  </view>
</t-popup>

<!-- ============ 设置我的昵称弹层（微信不能自动读取，用户主动设）============ -->
<!-- 头像上传已砍：cloud:// 头像连自己都读不到（云存储要付费开公开读），双方统一昵称首字色块 -->
<t-popup visible="{{showProfile}}" placement="bottom" close-on-overlay-click bind:visible-change="onProfileVisibleChange">
  <view class="sheet">
    <view class="sheet__handle"></view>
    <view class="sheet__header"><text class="sheet__title">设置我的昵称</text></view>
    <view class="sheet__body profile-body">
      <input
        class="nickname-input"
        type="nickname"
        placeholder="输入昵称（或用微信昵称）"
        value="{{profileNickname}}"
        bind:input="onNicknameInput"
        bind:blur="onNicknameInput"
      />
      <t-button theme="primary" size="large" block loading="{{savingProfile}}" bindtap="onSaveProfile">保存</t-button>
      <view class="sheet__note">头像统一用昵称首字色块（双方一致）；昵称双方都能看到</view>
    </view>
  </view>
</t-popup>

<!-- ============ 集数数字输入弹层（长番/无分母：滚轮反人类，改数字键盘直接输入）============ -->
<t-popup visible="{{showEpInput}}" placement="bottom" close-on-overlay-click bind:visible-change="onEpInputVisibleChange">
  <view class="sheet">
    <view class="sheet__handle"></view>
    <view class="sheet__header"><text class="sheet__title">看到第几话</text></view>
    <view class="sheet__body">
      <!-- 不用 focus 自动聚焦：popup 上滑动画期间 focus 易失效/键盘顶起弹层错位，让用户点一下更稳 -->
      <input
        class="ep-number-input"
        type="number"
        placeholder="输入话数，如 183"
        value="{{epInputValue}}"
        bind:input="onEpInputChange"
      />
      <view class="sheet__note" wx:if="{{detailItem && detailItem.totalEp}}">共 {{detailItem.totalEp}} 集，超出会自动截到最后一集</view>
      <t-button theme="primary" size="large" block bindtap="onEpInputConfirm">确定</t-button>
    </view>
  </view>
</t-popup>

<!-- ============ 番剧信息编辑弹层（共享字段：总集数 + 放送状态）============ -->
<!-- 独立 state（showItemInfo/itemInfoTotalEp/itemInfoAirStatus），绝不复用 showEpInput——
     那个写的是「我看到第几话」（个人进度），这里写的是番剧共享元信息，写串会污染进度 -->
<t-popup visible="{{showItemInfo}}" placement="bottom" close-on-overlay-click bind:visible-change="onItemInfoVisibleChange">
  <view class="sheet">
    <view class="sheet__handle"></view>
    <view class="sheet__header"><text class="sheet__title">{{totalEpCopy.INFO_TITLE}}</text></view>
    <view class="sheet__body">
      <!-- 总集数：同款步进器 -->
      <view class="ep-stepper-row">
        <text class="ep-stepper-row__label">{{totalEpCopy.TOTAL_EP_LABEL}}</text>
        <view class="ep-stepper">
          <view class="ep-stepper__btn {{!itemInfoTotalEp ? 'is-disabled' : ''}}" bindtap="onItemInfoTotalEpDec">−</view>
          <input
            class="ep-stepper__input"
            type="number"
            placeholder="选填"
            value="{{itemInfoTotalEp}}"
            bind:input="onItemInfoTotalEpInput"
          />
          <view class="ep-stepper__btn" bindtap="onItemInfoTotalEpInc">+</view>
        </view>
      </view>

      <!-- 放送状态：三选一 tag（放送中/已完结/未定），点选即切 -->
      <view class="ep-stepper-row">
        <text class="ep-stepper-row__label">{{totalEpCopy.AIR_STATUS_LABEL}}</text>
        <view class="air-status-group">
          <view
            wx:for="{{airStatusOptions}}"
            wx:key="value"
            class="air-status-tag {{itemInfoAirStatus === item.value ? 'is-active' : ''}}"
            data-value="{{item.value}}"
            bindtap="onItemInfoAirStatusChange"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="sheet__note">番剧信息两人共享，改了 TA 也会看到</view>
      <t-button theme="primary" size="large" block loading="{{savingItemInfo}}" bindtap="onItemInfoConfirm">保存</t-button>
    </view>
  </view>
</t-popup>

<!-- 集数选择器（短番：从 0 开始能回退到未开追）。必须绑 visible-change：
     点遮罩关闭时组件自降内部 visible，需同步父级 showEpPicker 并弹回详情，否则下钻死路+失步打不开 -->
<t-picker
  visible="{{showEpPicker}}"
  value="{{epPickerValue}}"
  cancel-btn="{{pickerCopy.CANCEL}}"
  confirm-btn="{{pickerCopy.CONFIRM}}"
  bind:confirm="onEpPickerConfirm"
  bind:cancel="onEpPickerCancel"
  bind:visible-change="onEpPickerVisibleChange"
>
  <t-picker-item options="{{epOptions}}"></t-picker-item>
</t-picker>

<!-- 状态选择器（六选一）。同样绑 visible-change 兑现「点遮罩关闭」并弹回详情 -->
<t-action-sheet
  id="statusSheet"
  visible="{{showStatusSheet}}"
  items="{{statusSheetItems}}"
  bind:selected="onStatusSelected"
  bind:cancel="onStatusSheetCancel"
  bind:visible-change="onStatusSheetVisibleChange"
/>


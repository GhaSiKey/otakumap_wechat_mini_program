<view class="page">
  <!-- 加载骨架屏 -->
  <view wx:if="{{loading}}" class="board-list">
    <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton-line skeleton-line--title"></view>
      <view class="skeleton-line skeleton-line--meta"></view>
    </view>
  </view>

  <!-- 空态：一个板都没有 -->
  <view wx:elif="{{boards.length === 0}}" class="empty-wrap">
    <t-empty icon="folder-open" description="{{copy.EMPTY_TITLE}}" />
    <view class="empty-sub">{{copy.EMPTY_SUB}}</view>
    <t-button theme="primary" size="large" bindtap="onCreateTap">{{copy.EMPTY_CTA}}</t-button>
  </view>

  <!-- 板列表：统一大卡（单板不空、多板堆叠自然，一套代码） -->
  <view wx:else class="board-list">
    <view
      wx:for="{{boards}}"
      wx:key="boardId"
      class="board-card {{item.archived ? 'board-card--archived' : ''}} {{item.hasUnread && !item.archived ? 'board-card--unread' : ''}}"
      hover-class="board-card--pressed"
      hover-stay-time="80"
      data-board-id="{{item.boardId}}"
      bindtap="onBoardTap"
    >
      <!-- ① 头部行：双人同轴头像 + 板名 + 未读红点 -->
      <view class="board-card__head">
        <view class="dual-avatar">
          <!-- 我方头像（左，恒有）：有 https 图用图，否则首字色块 -->
          <image
            wx:if="{{item.meAvatar}}"
            class="dual-avatar__img"
            src="{{item.meAvatar}}"
            mode="aspectFill"
          />
          <view
            wx:else
            class="dual-avatar__fallback"
            style="background:{{item.meFallback.color}}"
          >{{item.meFallback.char}}</view>
          <!-- 对方头像（右）：配对后有、未配对为虚位。加载失败回退首字母 -->
          <image
            wx:if="{{item.peerAvatar && !avatarErr[item.boardId]}}"
            class="dual-avatar__img dual-avatar__img--peer"
            src="{{item.peerAvatar}}"
            mode="aspectFill"
            data-board-id="{{item.boardId}}"
            binderror="onPeerAvatarError"
          />
          <view
            wx:elif="{{item.peerFallback}}"
            class="dual-avatar__fallback dual-avatar__fallback--peer"
            style="background:{{item.peerFallback.color}}"
          >{{item.peerFallback.char}}</view>
          <view wx:else class="dual-avatar__ghost">{{copy.GHOST}}</view>
        </view>
        <view class="board-name">
          <text wx:if="{{item.archived}}" class="archived-tag">{{copy.ARCHIVED_PREFIX}}</text>{{item.name}}
        </view>
        <view wx:if="{{item.hasUnread && !item.archived}}" class="unread-dot"></view>
      </view>

      <!-- ② 封面墙：前 N 部番首字色块 + 溢出角标（无番时不渲染，保持卡片紧凑） -->
      <view wx:if="{{item.covers.length}}" class="cover-wall">
        <block wx:for="{{item.covers}}" wx:for-item="cv" wx:key="index">
          <image wx:if="{{cv.cover}}" class="cover-cell" src="{{cv.cover}}" mode="aspectFill" />
          <view wx:else class="cover-cell cover-cell--ph" style="background:{{cv.fallback.color}}">{{cv.fallback.char}}</view>
        </block>
        <view wx:if="{{item.moreText}}" class="cover-more">{{item.moreText}}</view>
      </view>

      <!-- ③ 底部信息行：番数 · 活跃/等待 + 进入箭头 -->
      <view class="board-card__foot">
        <view class="foot-info">
          <text class="foot-count">{{item.itemCountText}}</text>
          <text class="foot-sub {{item.paired ? '' : 'foot-sub--waiting'}}"> · {{item.subline}}</text>
        </view>
        <text class="foot-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 建板 FAB（t-fab 抛 click 事件，不是 tap） -->
  <t-fab wx:if="{{boards.length > 0}}" icon="add" bind:click="onCreateTap" />

  <!-- 建板弹层（统一外壳 .sheet，与 shared-board 各弹层同款）-->
  <t-popup visible="{{showCreate}}" placement="bottom" close-on-overlay-click bind:visible-change="onCreateVisibleChange">
    <view class="sheet">
      <view class="sheet__handle"></view>
      <view class="sheet__header"><text class="sheet__title">{{copy.CREATE_TITLE}}</text></view>
      <view class="sheet__body">
        <t-input
          placeholder="{{copy.CREATE_PLACEHOLDER}}"
          value="{{newBoardName}}"
          maxlength="20"
          bind:change="onBoardNameInput"
        />
        <t-button
          theme="primary"
          size="large"
          block
          loading="{{creating}}"
          bindtap="onConfirmCreate"
        >{{copy.CREATE_CTA}}</t-button>
      </view>
    </view>
  </t-popup>
</view>

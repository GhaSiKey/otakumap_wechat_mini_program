@import "./sheet.wxss";

view, text {
  box-sizing: border-box;
}

/* 本功能专属变量（--sb- 前缀，不污染全局 --td-*）。里程碑辉光/身份色/轴段，亮暗两套。
   ⚠️ 必须定义在 page（真实根节点）而非 .page：t-popup 弹层不在 .page 子树内，
   定义在 .page 上时弹层里的 var(--sb-color-me) 继承不到 → 头像色块背景透明、白字裸在灰底看不见。 */
page {
  background-color: var(--td-bg-color-page, #f5f5f5);
  --sb-success-glow: rgba(43, 164, 113, 0.25); /* 追平辉光（卡片 sbSyncGlow + 游标合并光晕共用） */
  --sb-axis-common: var(--td-brand-color-4, #8eabff); /* 已走过段：提到 brand-4 中蓝，与浅灰 track 拉开对比（原 brand-2 #d9e1ff 糊在一起） */
  --sb-axis-common-sync: var(--td-success-color, #2ba471); /* 追平时已走过段染成 success 绿，与 ◉ 合并态呼应 */
  --sb-color-me: #0052d9; /* 我=品牌蓝 */
  --sb-color-peer: #834ec2; /* TA=紫（非成功绿，绿留给追平/看完奖章） */
  --sb-peer-tint: rgba(131, 78, 194, 0.1); /* 「TA 更新了」信息条底色：紫身份色淡化，与绿色共同话题带区分 */
}

.page {
  min-height: 100vh;
  /* 给底部 t-fab（椭圆大按钮，全面屏还叠安全区偏移）留够，避免压住最后一张番卡。
     t-fab 默认距底 ~64rpx + 高 ~96rpx，全面屏再加 safe-area，故留 240rpx + 安全区 */
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom, 0px));
}

@media (prefers-color-scheme: dark) {
  page {
    --sb-success-glow: rgba(86, 192, 141, 0.4);
    --sb-axis-common: var(--td-brand-color-8, #4582e6); /* 暗模式已走过段：用亮蓝 brand-8 在深轨道上跳出（brand-6 偏深糊在一起） */
    --sb-axis-common-sync: var(--td-success-color, #46bd87);
    --sb-color-me: #4582e6;
    --sb-color-peer: #9560d0; /* 压深（原 #a97be0 白字仅 3.1:1）：游标 22rpx 白字达标 */
    --sb-peer-tint: rgba(149, 96, 208, 0.22); /* 暗模式加深透明度，深底上仍可辨 */
  }
}

/* 成员身份色（消灭 inline 硬编码；游标/fallback 统一走这里） */
.identity--me {
  background: var(--sb-color-me);
}
.identity--peer {
  background: var(--sb-color-peer);
}
.identity--pending {
  background: var(--td-bg-color-component, #e7e7e7);
}

/* ==================== 加载骨架屏 ==================== */
.sb-skeleton {
  padding: 0;
}

.skeleton-memberbar {
  height: 88rpx;
  background: var(--td-bg-color-container, #ffffff);
  margin-bottom: var(--td-spacer-2, 32rpx);
}

.sb-skeleton .skeleton-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 0 var(--td-spacer-2, 32rpx) var(--td-spacer, 16rpx);
  padding: var(--td-spacer-2, 32rpx);
  background: var(--td-bg-color-container, #ffffff);
  border-radius: var(--td-radius-large, 18rpx);
}

/* 骨架封面：与真实卡片 .item-cover-wrap 同尺寸（3:4）/同圆角 */
.skeleton-cover {
  flex-shrink: 0;
  width: 160rpx;
  height: 213rpx;
  border-radius: var(--td-radius-default, 12rpx);
  background: var(--td-bg-color-component, #e7e7e7);
  animation: skeleton-shimmer 1.4s ease-in-out infinite;
}

.skeleton-body {
  flex: 1;
  min-width: 0;
}

.skeleton-line {
  border-radius: var(--td-radius-small, 6rpx);
  background: var(--td-bg-color-component, #e7e7e7);
  animation: skeleton-shimmer 1.4s ease-in-out infinite;
}

.skeleton-line--title {
  width: 40%;
  height: 32rpx;
  margin-bottom: 24rpx;
}

.skeleton-axis {
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-component, #e7e7e7);
  margin: 24rpx 0;
  animation: skeleton-shimmer 1.4s ease-in-out infinite;
}

.skeleton-line--meta {
  width: 55%;
  height: 24rpx;
}

@keyframes skeleton-shimmer {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* ==================== 成员条 ==================== */
.member-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--td-spacer, 16rpx) var(--td-spacer-2, 32rpx);
  background-color: var(--td-bg-color-container, #ffffff);
}

/* ==================== 共同话题带（门面核心卖点，成员条下方居中胶囊）==================== */
.common-talk {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: var(--td-spacer, 16rpx) var(--td-spacer-2, 32rpx) 0;
  padding: 14rpx var(--td-spacer-2, 32rpx);
  background: var(--td-brand-color-light, #f2f3ff);
  border-radius: 999rpx;
}

/* 按需提醒：从顶部滑入淡出（不再常驻，commonCount 变大时才出现） */
.common-talk--flash {
  animation: commonTalkFlashKf 0.35s ease-out;
}

@keyframes commonTalkFlashKf {
  0% { transform: translateY(-16rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.common-talk__icon {
  font-size: 28rpx;
}

.common-talk__text {
  font-size: var(--td-font-size-body-medium, 28rpx);
  font-weight: 600;
  color: var(--td-brand-color, #0052d9);
}

.common-talk__arrow {
  font-size: 32rpx;
  color: var(--td-brand-color, #0052d9);
  opacity: 0.6;
}

/* 「TA 更新了」信息条：进板结算展示对方新动向，点击收起。紫底呼应 TA 身份色 */
.peer-update {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: var(--td-spacer, 16rpx) var(--td-spacer-2, 32rpx) 0;
  padding: 16rpx var(--td-spacer-2, 32rpx);
  background: var(--sb-peer-tint, rgba(131, 78, 194, 0.1));
  border-radius: 16rpx;
  animation: peerUpdateInKf 0.35s ease-out;
}

@keyframes peerUpdateInKf {
  0% { transform: translateY(-16rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.peer-update__icon {
  font-size: 30rpx;
  flex-shrink: 0;
}

.peer-update__text {
  flex: 1;
  font-size: var(--td-font-size-body-medium, 28rpx);
  font-weight: 600;
  color: var(--sb-color-peer, #834ec2);
  /* 单部番名可能长，超出省略，不撑破一行 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.peer-update__close {
  font-size: 24rpx;
  color: var(--td-text-color-placeholder, #bbb);
  flex-shrink: 0;
  padding-left: 8rpx;
}

.member {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.m-name {
  font-size: var(--td-font-size-body-medium, 28rpx);
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
}

.m-fallback {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  flex-shrink: 0;
}

.m-fallback.big {
  width: 96rpx;
  height: 96rpx;
  font-size: 36rpx;
}

/* ==================== 虚位空椅（成员条 + 详情弹层复用）==================== */
.ghost-seat {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx dashed var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
  animation: breathing 2s ease-in-out infinite;
}

.ghost-breathing {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx dashed var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  animation: breathing 2s ease-in-out infinite;
}

@keyframes breathing {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

.m-name.hint {
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

/* ==================== 筹备态邀请横幅（紧凑，不挡番单）==================== */
.invite-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: var(--td-spacer, 16rpx) var(--td-spacer-2, 32rpx) 0;
  padding: var(--td-spacer-2, 32rpx);
  background: var(--td-brand-color-light, #f2f3ff);
  border-radius: var(--td-radius-large, 18rpx);
  gap: var(--td-spacer, 16rpx);
}

.invite-banner__title {
  font-size: var(--td-font-size-body-large, 32rpx);
  font-weight: 600;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
}

.invite-banner__sub {
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
  margin-top: 4rpx;
}

.invite-banner__btn {
  flex-shrink: 0;
  background-color: var(--td-brand-color, #0052d9);
  color: #ffffff;
  font-size: var(--td-font-size-body-medium, 28rpx);
  border-radius: var(--td-radius-default, 12rpx);
  padding: 0 var(--td-spacer-2, 32rpx);
  margin: 0;
}

/* 番单空态引导 */
.list-empty {
  padding: 15vh var(--td-spacer-2, 32rpx);
  text-align: center;
}

.list-empty__text {
  font-size: var(--td-font-size-body-medium, 28rpx);
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

/* ==================== 分区 ==================== */
.section {
  margin-top: var(--td-spacer-2, 32rpx);
  padding: 0 var(--td-spacer-2, 32rpx);
}

.section-title {
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
  margin-bottom: var(--td-spacer, 16rpx);
}

/* ==================== 番剧卡片 ==================== */
.item-card {
  /* position+z-index 建立层叠上下文：把卡内游标 z-index 关进卡片，
     否则游标会逃到根层级盖住 fixed 的加番 FAB（层级 bug 根因） */
  position: relative;
  z-index: 0;
  display: flex;
  align-items: center; /* 封面按固定比例定形，与内容列在垂直方向居中对齐 */
  gap: 24rpx; /* 封面与内容列的间距 */
  background-color: var(--td-bg-color-container, #ffffff);
  border-radius: var(--td-radius-large, 18rpx);
  /* 内边距：封面四周留一圈等距白边，成为「内嵌悬浮海报」而非贴边全出血。
     四角对称，不再有「左圆右直」的割裂感。 */
  padding: 24rpx;
  overflow: hidden; /* 保住卡片圆角 */
  margin-bottom: var(--td-spacer, 16rpx);
}

/* ===== 左侧封面区：内嵌悬浮竖版海报，固定 3:4 比例，四角全圆 =====
   宽高直接写死锁定比例（padding-top 定比会按父宽算、在此 flex 定宽场景反而失真，故用显式宽高）：
   160 × 213 ≈ 3:4 标准动画海报，比原来的窄竖条明显更宽。
   想要横版 4:3 就把宽高对调（但竖版海报会被裁成中间横条，慎用）。 */
.item-cover-wrap {
  position: relative;
  flex-shrink: 0;
  width: 160rpx;
  height: 213rpx;
  border-radius: var(--td-radius-default, 12rpx); /* 封面自身四角圆角 */
  overflow: hidden; /* 裁掉封面图四角，使圆角生效（不影响外侧 box-shadow） */
  background: var(--td-bg-color-component, #e7e7e7); /* 图加载中的占位底，避免透白 */
  /* 悬浮海报的柔和投影：卡片已去阴影，改由封面自己「浮」起来。
     模糊半径控制在卡片 32rpx 内边距内，不会被卡片 overflow 裁掉。 */
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

/* 真封面图：绝对定位铺满封面区，aspectFill 裁切填充（竖版海报最贴合） */
.item-cover-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 无图占位：首字色块铺满封面区，居中大字 */
.item-cover-ph {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 56rpx; /* 封面区放大，首字也随之放大 */
  font-weight: 600;
}

/* ===== 右侧内容列 ===== */
.item-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center; /* 内容较少时在封面高度内垂直居中，避免顶部堆挤 */
}

.item-head {
  display: flex;
  align-items: flex-start; /* tag 顶对齐番名首行，而非居中夹在番名/副标题之间显得错位 */
  gap: 20rpx;
}

/* 状态 tag 不被长番名压扁：flex 行里 t-tag 需固定宽度，否则 __main 撑满后 tag 被挤没 */
.item-head t-tag {
  flex-shrink: 0;
}

.item-head__main {
  flex: 1;
  min-width: 0;
}

.item-name {
  /* display:block 必需：<text> 默认 inline，inline 元素上 text-overflow/nowrap 不生效，
     长番名不会截断而是一路撑破，盖到右侧状态 tag。block 后才在 __main(flex:1,min-width:0) 内省略 */
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 放送元信息「放送中 · 12集 · 周六更新」：单行灰字，更新日并入同权重呈现。
   display:block 使其独占一行落在番名下方，margin-top 与番名拉开间距。 */
.item-sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

/* ==================== 同轴集数轴 ==================== */
.axis {
  position: relative;
  height: 64rpx;
  margin: var(--td-spacer, 16rpx) 0 8rpx;
}

.axis-track {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 10rpx;
  transform: translateY(-50%);
  background: var(--td-bg-color-component, #e7e7e7);
  border-radius: 999rpx;
}

.axis-common {
  position: absolute;
  left: 0;
  top: 50%;
  height: 10rpx;
  transform: translateY(-50%);
  background: var(--sb-axis-common, #8eb3f5);
  border-radius: 999rpx;
}

/* 追平：已走过段染 success 绿，与 ◉ 合并态呼应 */
.axis-common--sync {
  background: var(--sb-axis-common-sync, #2ba471);
}

.axis-lead {
  position: absolute;
  top: 50%;
  height: 10rpx;
  transform: translateY(-50%);
  background: var(--td-brand-color, #0052d9);
  border-radius: 999rpx;
}

.axis-cursor {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  transition: left 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.cursor--mine { z-index: 3; }
.cursor--peer { z-index: 2; }
.cursor--merged { z-index: 4; }

.cursor-dot {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 20rpx;
  border: 3rpx solid var(--td-bg-color-container, #ffffff);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}

/* 弃番游标：灰色实心填充，位置保留但不再是「前进中」的鲜活色，表达「下车了」。
   不用透明度（半透明会透出底下轨道显脏），直接实心灰，白字清晰 */
.cursor-dot--dropped {
  background: var(--td-text-color-placeholder, #bbbbbb);
}

/* 追平合并态 ◉：success 色 + 光晕脉冲，兑现追平仪式感（情绪峰值） */
.cursor-dot--merged {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  background: var(--td-success-color, #2ba471);
  border: 3rpx solid var(--td-bg-color-container, #ffffff);
  box-shadow: 0 0 0 6rpx var(--sb-success-glow, rgba(43, 164, 113, 0.25));
  animation: sbMergedPulse 1.6s ease-in-out infinite;
}

@keyframes sbMergedPulse {
  0%, 100% { box-shadow: 0 0 0 6rpx var(--sb-success-glow, rgba(43, 164, 113, 0.25)); }
  50% { box-shadow: 0 0 0 12rpx var(--sb-success-glow, rgba(43, 164, 113, 0.25)); }
}

.axis-fade {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 25%;
  background: var(--td-bg-color-container, #ffffff);
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 100%);
  mask-image: linear-gradient(90deg, transparent 0%, #000 100%);
}

/* 终点桩：有总集数时轴末端的竖向标记，表达「这是终点，进度有底」。
   放在 track 右端，比 track 略高、圆角小竖条，与游标圆点区分（那是人，这是终点）。 */
.axis-goal {
  position: absolute;
  right: 0;
  top: 50%;
  width: 8rpx;
  height: 24rpx;
  transform: translateY(-50%);
  background: var(--td-text-color-placeholder, #bbbbbb);
  border-radius: 4rpx;
}

/* 超出预设提示：轻量橙字，点击改总集数。不做重色块，避免像报错吓人（多半是特别篇/漏设） */
.exceed-hint {
  display: inline-block;
  margin-top: 8rpx;
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-warning-color, #e37318);
}

/* ==================== 进度摘要 ==================== */
.item-diff {
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

.item-diff .hint {
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

.item-diff .sync {
  color: var(--td-success-color, #2ba471);
}

.item-diff .lead-txt {
  color: var(--td-brand-color, #0052d9);
}

/* 弃番文案：灰化，去追赶感，与游标灰化呼应 */
.item-diff .dropped-txt {
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

/* ==================== 详情弹层（外壳由 .sheet 提供，此处只补内容样式）==================== */
/* 番名可点改名（展示态） */
.detail-name {
  max-width: 70%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-name__edit {
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
  margin-left: 12rpx;
  vertical-align: middle;
}

/* 番名编辑区：独立垂直堆叠面板（替代原挤在标题栏的内联编辑） */
.name-edit-panel {
  display: flex;
  flex-direction: column;
  padding: 8rpx var(--td-spacer-2, 32rpx) 0;
}

.name-edit-panel__title {
  font-size: var(--td-font-size-title-medium, 32rpx);
  font-weight: 600;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  text-align: center;
  margin-bottom: var(--td-spacer-2, 32rpx);
}

/* 带边框底色的输入框，一眼可见是可编辑输入态（对齐 ep-number-input 观感） */
.name-edit-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--td-spacer-2, 32rpx);
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
  border-radius: var(--td-radius-default, 12rpx);
  font-size: var(--td-font-size-body-large, 32rpx);
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  box-sizing: border-box;
}

.name-edit-panel__note {
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
  margin: var(--td-spacer, 16rpx) 4rpx var(--td-spacer-3, 48rpx);
}

/* 底部按钮行：取消（次要）+ 保存（主要），等宽并排 */
.name-edit-panel__actions {
  display: flex;
  gap: var(--td-spacer, 16rpx);
}

.name-edit-action {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--td-radius-default, 12rpx);
  font-size: var(--td-font-size-body-large, 32rpx);
}

.name-edit-action--cancel {
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

.name-edit-action--save {
  background: var(--td-brand-color, #0052d9);
  color: #ffffff;
  font-weight: 600;
}

.name-edit-action.is-loading {
  opacity: 0.5;
}

.detail-sub {
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
  text-align: center;
}

/* 可点的番剧信息行：居中胶囊 + 箭头，点开番剧信息编辑弹层。
   居中而非贴左，与标题拉开垂直间距，不再挤在标题正下方 */
.detail-sub--tappable {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: fit-content;
  margin: 8rpx auto var(--td-spacer-2, 32rpx);
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
}

.detail-sub__arrow {
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

/* ===== 加番弹层：搜索区（推荐主路径，整块可点，右箭头表「会跳转」） ===== */
.add-search-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: var(--td-radius-large, 18rpx);
  background: var(--td-brand-color-light, #f2f3ff);
  border: 2rpx solid var(--td-brand-color-focus, #b5c7ff);
}

.add-search-block__main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--td-brand-color, #0052d9);
}

.add-search-block__title {
  font-size: var(--td-font-size-body-medium, 28rpx);
  font-weight: 600;
  color: var(--td-brand-color, #0052d9);
}

.add-search-block__sub {
  margin-top: 4rpx;
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-brand-color-7, #366ef4);
}

.add-search-block__arrow {
  color: var(--td-brand-color, #0052d9);
}

/* ===== 加番弹层：已选中预览卡（封面缩略图 + 番名 + 重选，所见即所得） ===== */
.picked-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: var(--td-radius-large, 18rpx);
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
}

.picked-preview__cover {
  flex: none;
  width: 96rpx;
  height: 128rpx;
  border-radius: var(--td-radius-default, 12rpx);
  box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, 0.06);
}

/* 封面缺失/加载失败：首字色块兜底（复用番卡同套首字语言） */
.picked-preview__cover--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.picked-preview__info {
  flex: 1;
  min-width: 0;
}

.picked-preview__name {
  font-size: var(--td-font-size-body-large, 32rpx);
  font-weight: 600;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picked-preview__hint {
  margin-top: 6rpx;
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-success-color, #2ba471);
}

.picked-preview__reselect {
  flex: none;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-brand-color, #0052d9);
  background: var(--td-brand-color-light, #f2f3ff);
}

/* ===== 加番弹层：手填区分隔标题（「或手动填写」，左右细线夹中间文字） ===== */
.add-divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: var(--td-spacer-2, 32rpx) 0 var(--td-spacer-1, 16rpx);
}

.add-divider::before,
.add-divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: var(--td-component-stroke, rgba(0, 0, 0, 0.08));
}

.add-divider__label {
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

/* 放送状态三选一 tag（番剧信息弹层） */
.air-status-group {
  display: flex;
  gap: var(--td-spacer-1, 16rpx);
}

.air-status-tag {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
  border: 2rpx solid transparent;
}

/* 选中态：品牌色描边 + 品牌浅底 + 品牌字色 */
.air-status-tag.is-active {
  color: var(--td-brand-color, #0052d9);
  background: var(--td-brand-color-light, #f2f3ff);
  border-color: var(--td-brand-color, #0052d9);
}

.duel {
  display: flex;
  justify-content: center;
  gap: var(--td-spacer-4, 64rpx);
}

.duel-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: var(--td-spacer-2, 32rpx);
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
  border-radius: var(--td-radius-default, 12rpx);
  min-width: 180rpx;
}

/* 集数大字容器：相对定位，给 +1 浮起动画做锚点 */
.duel-ep-wrap {
  position: relative;
  display: flex;
  justify-content: center;
}

.duel-ep {
  font-size: var(--td-font-size-title-large, 36rpx);
  font-weight: 600;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
}

.duel-ep.hint {
  font-size: var(--td-font-size-body-small, 24rpx);
  font-weight: normal;
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

/* +1 触发：集数大字上跳回落，配合成功绿闪一下 */
.duel-ep.ep-bump {
  animation: epBumpKf 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes epBumpKf {
  0% { transform: translateY(0) scale(1); }
  35% { transform: translateY(-14rpx) scale(1.28); color: var(--td-success-color, #2ba471); }
  100% { transform: translateY(0) scale(1); }
}

/* +1 浮起：从集数位置起，向上升 + 放大 + 淡出 */
.ep-plus-fly {
  position: absolute;
  left: 50%;
  top: 0;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--td-success-color, #2ba471);
  pointer-events: none;
  animation: epPlusFlyKf 0.7s ease-out forwards;
}

@keyframes epPlusFlyKf {
  0% { transform: translate(-50%, 0) scale(0.6); opacity: 0; }
  25% { transform: translate(-50%, -20rpx) scale(1.1); opacity: 1; }
  100% { transform: translate(-50%, -72rpx) scale(1); opacity: 0; }
}

.duel-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-brand-color, #0052d9);
}

/* 「我」列可点编辑区（集数/状态）：加内边距扩大点击热区 + 铅笔 icon 暗示可改。
   点下轻微反馈，与 TA 列纯展示区分开。 */
.duel-editable {
  padding: 6rpx 12rpx;
  border-radius: var(--td-radius-default, 12rpx);
}

.duel-editable:active {
  background: var(--td-bg-color-container, #ffffff);
}

/* 集数容器本是浮起动画锚点（relative），可点态下让 icon 贴在集数右侧 */
.duel-ep-wrap.duel-editable {
  align-items: center;
  gap: 4rpx;
}

.duel-edit-icon {
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

/* 移出番单：低调置底文字按钮，弱化处理不抢主操作（不用大红按钮制造删除恐慌） */
.detail-remove {
  text-align: center;
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
  padding: var(--td-spacer, 16rpx) 0;
}

/* ==================== 里程碑动效（复用 anime-checklist 基因，辉光引 --sb- 变量）==================== */
/* 追平/看完：绿奖章辉光 + 微缩放 */
.item-card--sync {
  animation: sbSyncGlow 0.5s ease;
}
@keyframes sbSyncGlow {
  /* 卡片已去阴影，故起止帧回落到 none（否则追平动画后又冒出阴影）；仅中间帧闪一下 success 光晕 */
  0% { transform: scale(1); box-shadow: none; }
  40% { transform: scale(1.03); box-shadow: 0 8rpx 32rpx var(--sb-success-glow, rgba(43, 164, 113, 0.25)); }
  100% { transform: scale(1); box-shadow: none; }
}

/* 对方加入：虚位头像 360° 弹入（复用 bounceIn 基因） */
.member-joined {
  animation: sbBounceIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
@keyframes sbBounceIn {
  0% { transform: scale(1) rotate(0deg); }
  25% { transform: scale(0.4) rotate(120deg); }
  55% { transform: scale(1.3) rotate(300deg); }
  75% { transform: scale(0.9) rotate(350deg); }
  100% { transform: scale(1) rotate(360deg); }
}

/* ==================== 成员条「我」可点设置 ==================== */
.member--tappable {
  position: relative;
}

/* 头像容器：角标定位基准，无论头像/首字母分支角标都常驻 */
.m-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.m-set-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--td-brand-color, #0052d9);
  color: #fff;
  font-size: 24rpx;
  border: 2rpx solid var(--td-bg-color-container, #fff);
  /* flex 居中而非 line-height 对齐：本页 view 全局 border-box，2rpx 边框会吃进内容区，
     line-height 按整盒高算会比内容区高，导致「+」上下错位溢出。flex 居中不受边框影响。 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* ==================== 设置头像昵称弹层（外壳由 .sheet 提供，仅内容居中）==================== */
.profile-body {
  align-items: center;
}

.nickname-input,
.ep-number-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--td-spacer-2, 32rpx);
  margin-bottom: var(--td-spacer-3, 48rpx); /* 与「确定」按钮拉开呼吸，避免贴死 */
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
  border-radius: var(--td-radius-default, 12rpx);
  font-size: var(--td-font-size-body-medium, 28rpx);
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  box-sizing: border-box;
}

/* ==================== 总集数步进器（加番弹层 / 番剧信息弹层共用）==================== */
/* 一行：左标签 + 右步进器（−[input]+），自建不引 t-stepper（免构建 npm） */
.ep-stepper-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: var(--td-spacer-1, 16rpx);
}

.ep-stepper-row__label {
  font-size: var(--td-font-size-body-medium, 28rpx);
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
}

.ep-stepper {
  display: flex;
  align-items: center;
  border-radius: var(--td-radius-default, 12rpx);
  overflow: hidden;
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
}

.ep-stepper__btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  user-select: none;
}

.ep-stepper__btn.is-disabled {
  color: var(--td-text-color-disabled, rgba(0, 0, 0, 0.26));
}

.ep-stepper__input {
  width: 120rpx;
  height: 72rpx;
  text-align: center;
  font-size: var(--td-font-size-body-medium, 28rpx);
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  background: var(--td-bg-color-container, #fff);
}

/* 步进器下方副提示：紧贴步进器，不用 note 的默认大间距 */
.ep-stepper-hint {
  margin-top: var(--td-spacer, 8rpx);
  align-self: flex-start;
}

/* ==================== 成员条头像图（失败回退首字母，见 wxml binderror）==================== */
.m-avatar-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

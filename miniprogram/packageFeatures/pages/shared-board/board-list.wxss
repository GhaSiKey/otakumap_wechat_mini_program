view, text {
  box-sizing: border-box;
}

page {
  background-color: var(--td-bg-color-page, #f5f5f5);
}

.page {
  min-height: 100vh;
  padding: var(--td-spacer-2, 32rpx);
}

/* ==================== 加载骨架屏 ==================== */
.skeleton-card {
  padding: var(--td-spacer-2, 32rpx);
  background-color: var(--td-bg-color-container, #ffffff);
  border-radius: var(--td-radius-large, 18rpx);
  margin-bottom: var(--td-spacer, 16rpx);
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--td-radius-small, 6rpx);
  background: var(--td-bg-color-component, #e7e7e7);
  animation: skeleton-shimmer 1.4s ease-in-out infinite;
}

.skeleton-line--title {
  width: 40%;
  margin-bottom: 20rpx;
}

.skeleton-line--meta {
  width: 60%;
  height: 24rpx;
}

@keyframes skeleton-shimmer {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* ==================== 空态 ==================== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 30vh;
  gap: var(--td-spacer-2, 32rpx);
}

.empty-sub {
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
  margin-top: calc(-1 * var(--td-spacer, 16rpx));
}

/* ==================== 板卡片 ==================== */
.board-list {
  display: flex;
  flex-direction: column;
  gap: var(--td-spacer, 16rpx);
}

.board-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--td-spacer-2, 32rpx);
  background-color: var(--td-bg-color-container, #ffffff);
  border-radius: var(--td-radius-large, 18rpx);
  box-shadow: var(--td-shadow-1, 0 1px 10px rgba(0, 0, 0, 0.05));
}

.board-card--archived {
  box-shadow: none;
  opacity: 0.6;
}

.board-card__main {
  flex: 1;
  min-width: 0;
}

.board-name {
  display: flex;
  align-items: center;
  font-size: var(--td-font-size-title-medium, 32rpx);
  font-weight: 600;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
  margin-bottom: 8rpx;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--td-error-color, #e34d59);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.archived-tag {
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
}

.board-meta {
  font-size: var(--td-font-size-body-small, 24rpx);
  color: var(--td-text-color-secondary, rgba(0, 0, 0, 0.6));
}

.waiting-hint {
  color: var(--td-brand-color, #0052d9);
}

/* ==================== 头像 / 虚位 ==================== */
.board-card__avatar {
  flex-shrink: 0;
  margin-left: var(--td-spacer, 16rpx);
}

.avatar-fallback {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
}

.avatar-ghost {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx dashed var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
  color: var(--td-text-color-placeholder, rgba(0, 0, 0, 0.4));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* ==================== 建板弹层 ==================== */
.create-panel {
  padding: var(--td-spacer-3, 48rpx) var(--td-spacer-2, 32rpx);
  display: flex;
  flex-direction: column;
  gap: var(--td-spacer-2, 32rpx);
}

.create-title {
  font-size: var(--td-font-size-title-large, 36rpx);
  font-weight: 600;
  color: var(--td-text-color-primary, rgba(0, 0, 0, 0.9));
}

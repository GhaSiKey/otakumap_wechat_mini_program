/* 世界杯赔率页样式 · 复刻 H5 worldcup.css
 * 深色 + 金色冠军氛围 + 玻璃拟态。固定深色主题，不随系统切换。
 * H5 的 px 按 ×2 转 rpx；CSS 变量挂在 page；color-mix/backdrop-filter 降级处理。 */

page {
  --bg: #0a0e1a;
  --bg-grad-1: #1a2236;
  --bg-grad-2: #1e1830;
  --bg-orb-1: #c9a24a;
  --bg-orb-2: #3a4d8f;
  --surface: rgba(255, 255, 255, 0.04);
  --surface-2: rgba(255, 255, 255, 0.07);
  --border: rgba(255, 255, 255, 0.10);
  --border-hi: rgba(255, 255, 255, 0.22);
  --text: #e8ecf4;
  --text-dim: #9aa3b5;
  --text-faint: #6b7488;
  --accent: #4f8cff;
  --hot: #ff6b5b;
  --cold: #5bb8ff;
  --draw: #b890ff;
  --green: #38d39f;
  --yellow: #f2c14e;
  --red: #ff6b5b;
  --gold: #e8c477;
  --gold-bright: #ffd98a;
  --gold-deep: #b8932f;
  --radius: 32rpx;
  --radius-sm: 20rpx;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  min-height: 100vh;
  overflow-x: hidden; /* 防止任何 nowrap 内容把整页撑宽 */
}

view, text, scroll-view, image { box-sizing: border-box; }

/* 数字等宽对齐 */
.odd-v, .hhad-v, .orow-cell-b, .bet-odds, .ret-badge,
.cal-md, .cal-day-num, .matrix-td, .matrix-th {
  font-variant-numeric: tabular-nums;
}

/* ── 动态背景 ──
 * 颜色全部走 --bg-* 变量，由 .theme-{key} 覆盖，实现一键换肤。 */
.bg-gradient {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: -2;
  background:
    radial-gradient(ellipse 80% 50% at 50% -10%, rgba(232,196,119,0.10) 0%, transparent 60%),
    radial-gradient(ellipse at 18% 0%, var(--bg-grad-1) 0%, transparent 52%),
    radial-gradient(ellipse at 82% 100%, var(--bg-grad-2) 0%, transparent 52%),
    var(--bg);
}
.bg-orb {
  position: fixed; z-index: -1; border-radius: 50%;
  filter: blur(180rpx); opacity: 0.45; pointer-events: none;
}
.bg-orb-1 { width: 840rpx; height: 840rpx; background: var(--bg-orb-1); top: -280rpx; left: 10%; opacity: 0.22; }
.bg-orb-2 { width: 840rpx; height: 840rpx; background: var(--bg-orb-2); bottom: -240rpx; right: -200rpx; }
.bg-shine {
  position: fixed; top: 0; left: 0; right: 0; height: 640rpx; z-index: -1;
  background: linear-gradient(180deg, rgba(232,196,119,0.07) 0%, transparent 100%);
  pointer-events: none; animation: shineBreath 6s ease-in-out infinite;
}
@keyframes shineBreath { 0%,100% { opacity: 0.6; } 50% { opacity: 1; } }

/* ── 背景色系（换肤）──
 * 默认（深蓝黑）写在 page，其余主题覆盖 --bg / --bg-grad-* / --bg-orb-*。 */
.theme-green {
  --bg: #08140e;
  --bg-grad-1: #103021; --bg-grad-2: #0d2818;
  --bg-orb-1: #c9a24a; --bg-orb-2: #2f6b47;
}
.theme-wine {
  --bg: #160a12;
  --bg-grad-1: #3a1626; --bg-grad-2: #2a1230;
  --bg-orb-1: #c9a24a; --bg-orb-2: #8f3a5d;
}
.theme-purple {
  --bg: #0d0a1f;
  --bg-grad-1: #241a3d; --bg-grad-2: #1a1530;
  --bg-orb-1: #c9a24a; --bg-orb-2: #6a4d9f;
}
.theme-black {
  --bg: #0a0a0a;
  --bg-grad-1: #1a1608; --bg-grad-2: #14140a;
  --bg-orb-1: #c9a24a; --bg-orb-2: #6b5a2a;
}

/* ── 主题切换按钮（调试用）── */
.theme-switch {
  position: fixed; top: 16rpx; right: 24rpx; z-index: 35;
  display: flex; align-items: center; gap: 8rpx;
  padding: 10rpx 20rpx; border-radius: 30rpx;
  background: rgba(0,0,0,0.45); border: 1rpx solid var(--border-hi);
  backdrop-filter: blur(20rpx);
}
.theme-switch-icon { font-size: 28rpx; }
.theme-switch-name { font-size: 22rpx; color: var(--gold-bright); font-weight: 600; }

/* ── 容器 ── */
/* 注意：全局 app.wxss 的 .container 是 flex+align-items:center，会把子元素压成内容宽并居中，
 * 导致比赛卡片只有内容宽（窄）。这里覆盖为 block，让子元素正常撑满父级宽度。 */
.container {
  display: block;
  padding: 36rpx 20rpx 100rpx;
  overflow-x: hidden;
}

/* ── Header ── */
.header {
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 24rpx; padding: 24rpx 0 28rpx;
}
.logo { display: flex; align-items: center; gap: 28rpx; }
.logo-icon {
  font-size: 76rpx; line-height: 1;
  display: inline-block; transform-origin: 50% 80%;
  animation: trophyGlow 4s ease-in-out infinite, trophyShine 3.6s ease-in-out infinite;
}
@keyframes trophyGlow {
  0%,100% { text-shadow: 0 4rpx 16rpx rgba(232,196,119,0.4); }
  50% { text-shadow: 0 4rpx 32rpx rgba(255,217,138,0.9), 0 0 48rpx rgba(255,217,138,0.5); }
}
/* 轻微摆动 + 缩放，像奖杯在闪耀晃动 */
@keyframes trophyShine {
  0%   { transform: rotate(0deg) scale(1); }
  15%  { transform: rotate(-7deg) scale(1.06); }
  30%  { transform: rotate(6deg) scale(1.06); }
  45%  { transform: rotate(-4deg) scale(1.03); }
  60%  { transform: rotate(2deg) scale(1.02); }
  75%  { transform: rotate(0deg) scale(1); }
  100% { transform: rotate(0deg) scale(1); }
}
.logo-text { display: flex; flex-direction: column; }
.logo-title {
  font-size: 50rpx; font-weight: 800;
  background: linear-gradient(120deg, var(--gold-bright) 0%, var(--gold) 45%, var(--gold-deep) 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: var(--gold);
}
.logo-sub {
  font-size: 22rpx; color: var(--gold); opacity: 0.8;
  letter-spacing: 4rpx; font-weight: 600;
}
.header-meta { display: flex; flex-direction: column; gap: 8rpx; align-items: flex-start; }
.meta-stamp { font-size: 24rpx; color: var(--text-dim); }

/* 标题金线 */
.title-rule {
  height: 4rpx; margin: 0 0 44rpx;
  background: linear-gradient(90deg, var(--gold) 0%, rgba(232,196,119,0.25) 30%, transparent 70%);
  border-radius: 4rpx;
}

/* ── 赛程日历 ── */
.calendar {
  margin: 0 0 44rpx; padding: 32rpx 36rpx;
  background: var(--surface); border: 1rpx solid var(--border);
  border-radius: var(--radius);
  overflow: hidden; /* 切断 nowrap 日期条撑宽父级的反馈循环 */
}
.cal-head {
  display: flex; align-items: center; justify-content: space-between;
  gap: 24rpx; margin-bottom: 24rpx; flex-wrap: wrap;
}
.cal-title { font-size: 30rpx; font-weight: 700; color: var(--text); }
.cal-sub { font-size: 24rpx; font-weight: 500; color: var(--text-dim); margin-left: 16rpx; }
.cal-view-toggle {
  display: flex; gap: 8rpx; background: var(--surface-2);
  border-radius: var(--radius-sm); padding: 6rpx;
}
.cal-vt {
  color: var(--text-dim); font-size: 24rpx; padding: 10rpx 24rpx;
  border-radius: 14rpx; transition: all .18s;
}
.cal-vt.active { background: var(--gold); color: #1a1205; font-weight: 700; }

/* 阶段配色：小组赛蓝色系（按轮次深浅），淘汰赛暖色系（随晋级升温） */
.ph-1 { --pc: #4f8cff; }
.gr-1 { --pc: #7eb0ff; }
.gr-2 { --pc: #4f8cff; }
.gr-3 { --pc: #2f63c7; }
.ph-2 { --pc: #38d39f; }
.ph-3 { --pc: #8ad94f; }
.ph-4 { --pc: #f2c14e; }
.ph-5 { --pc: #ff9b4a; }
.ph-6 { --pc: #b890ff; }
.ph-7 { --pc: #ffd98a; }

.cal-legend { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; margin-bottom: 24rpx; }
.cal-leg { font-size: 22rpx; color: var(--text-dim); padding-left: 28rpx; position: relative; }
.cal-leg::before {
  content: ''; position: absolute; left: 0; top: 50%;
  transform: translateY(-50%); width: 18rpx; height: 18rpx; border-radius: 6rpx;
  background: var(--pc);
}

/* 方案A：横向日期条
 * scroll-view scroll-x 下子元素必须用 inline-block。
 * 关键：scroll-view 内容 nowrap 会 shrink-to-fit 撑到内容宽，再撑大父级，
 * 而 width:100% 又回头取被撑大的父级宽 → 死循环锁死、无法滚动。
 * 解法：给一个不依赖父级也不依赖内容的确定宽度 = 视口 - container padding(40rpx) - calendar padding(72rpx)。 */
.cal-strip {
  display: block; box-sizing: border-box;
  width: calc(100vw - 112rpx); max-width: calc(100vw - 112rpx);
  white-space: nowrap; padding-top: 28rpx;
}
.cal-cell {
  display: inline-block; vertical-align: top; text-align: center;
  padding: 16rpx 12rpx 14rpx;
  width: 116rpx; margin-right: 14rpx; position: relative;
  background: var(--surface-2); border: 1rpx solid var(--border);
  border-top: 6rpx solid var(--pc); border-radius: 20rpx; color: var(--text);
}
.cal-cell text { display: block; }
.cal-md { font-size: 28rpx; font-weight: 700; }
.cal-wd { font-size: 20rpx; color: var(--text-dim); }
.cal-ph {
  display: inline-block;
  font-size: 18rpx; border: 1rpx solid var(--pc); color: var(--pc);
  border-radius: 8rpx; padding: 0 8rpx; margin: 2rpx auto;
}
.cal-cnt { font-size: 18rpx; color: var(--text-dim); line-height: 1.4; }
.cal-cell--nolist { opacity: .42; }

/* 方案B：月历网格 */
.cal-grid-wrap { display: flex; flex-direction: column; gap: 32rpx; }
.cal-month-title { font-size: 26rpx; font-weight: 700; color: var(--gold); margin-bottom: 16rpx; }
.cal-week-head { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; margin-bottom: 8rpx; }
.cal-week-head text { text-align: center; font-size: 20rpx; color: var(--text-faint); }
.cal-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; }
.cal-day {
  aspect-ratio: 1; min-height: 84rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 2rpx; border-radius: 16rpx;
  border: 1rpx solid var(--border); background: var(--surface-2);
  border-bottom: 6rpx solid var(--pc); color: var(--text); padding: 4rpx;
}
.cal-day-num { font-size: 26rpx; font-weight: 700; }
.cal-day-cnt { font-size: 18rpx; color: var(--text-dim); }
.cal-day-ph { font-size: 16rpx; color: var(--pc); font-weight: 700; }
.cal-day--empty { border: none; background: transparent; }
.cal-day--off {
  border: none; background: transparent; color: var(--text-faint);
  opacity: .3; font-size: 24rpx;
}
.cal-day--nolist { opacity: .42; }

/* 今天高亮：金色描边 + 脉冲 */
.cal-cell.cal-today, .cal-day.cal-today {
  border-color: var(--gold-bright);
  box-shadow: 0 0 0 2rpx var(--gold-bright), 0 0 24rpx rgba(255,217,138,0.45);
  animation: todayPulse 2s ease-in-out infinite;
}
@keyframes todayPulse {
  0%,100% { box-shadow: 0 0 0 2rpx var(--gold-bright), 0 0 20rpx rgba(255,217,138,0.35); }
  50% { box-shadow: 0 0 0 2rpx var(--gold-bright), 0 0 32rpx rgba(255,217,138,0.6); }
}
.cal-today-tag {
  position: absolute; top: -6rpx; left: 50%; transform: translateX(-50%);
  font-size: 18rpx; font-weight: 700; color: #1a1205;
  background: var(--gold-bright); border-radius: 10rpx; padding: 2rpx 12rpx;
  white-space: nowrap;
}
.cal-day.cal-today .cal-day-num { color: var(--gold-bright); }

/* ── 分组 ── */
.groups { display: block; }
.group { margin-bottom: 64rpx; }
.group-title {
  font-size: 28rpx; font-weight: 700; color: var(--text-dim);
  margin-bottom: 28rpx; padding-left: 8rpx;
  display: flex; align-items: center; gap: 20rpx;
}
.group-key { flex: 0 0 auto; }
.group-phase {
  font-size: 22rpx; font-weight: 700; color: var(--pc);
  border: 1rpx solid var(--pc); border-radius: 12rpx; padding: 4rpx 16rpx;
  background: rgba(255,255,255,0.04);
}
.group-count { font-size: 22rpx; font-weight: 600; color: var(--text-faint); }
.group-today {
  font-size: 22rpx; font-weight: 800; color: #1a1205;
  background: var(--gold-bright); border-radius: 12rpx; padding: 4rpx 18rpx;
}
.group--today .group-key { color: var(--gold-bright); }
/* 点击日历后高亮闪烁 */
.group.day-flash { animation: dayFlash 1.5s ease; }
@keyframes dayFlash {
  0%,100% { background: transparent; }
  20% { background: rgba(232,196,119,0.14); border-radius: var(--radius); }
}

/* ── 卡片 ── */
.cards { display: flex; flex-direction: column; gap: 28rpx; }
.card {
  background: var(--surface); border: 1rpx solid var(--border);
  border-radius: var(--radius); padding: 32rpx;
}
.card-head {
  display: flex; align-items: center; gap: 16rpx;
  font-size: 24rpx; color: var(--text-faint); margin-bottom: 24rpx;
}
.card-num { font-weight: 600; color: var(--text-dim); }
.card-group { padding: 2rpx 14rpx; background: var(--surface-2); border-radius: 12rpx; color: var(--text-dim); }
.card-time { margin-left: auto; }

.card-teams {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx; margin-bottom: 28rpx;
}
.team { display: flex; flex-direction: column; align-items: center; gap: 12rpx; flex: 1; min-width: 0; }
.team-logo {
  width: 88rpx; height: 88rpx; border-radius: 16rpx;
  background: rgba(255,255,255,0.06);
}
.team-logo--ph {
  display: flex; align-items: center; justify-content: center; font-size: 44rpx;
}
.team-name {
  font-size: 28rpx; font-weight: 600; text-align: center;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;
}
.vs { font-size: 24rpx; font-weight: 700; color: var(--text-faint); flex: 0 0 auto; }

/* 比分（已结束比赛，替代 VS 居中显示） */
.card-score {
  flex: 0 0 auto; display: flex; flex-wrap: wrap;
  align-items: center; justify-content: center;
  max-width: 192rpx;
}
.card-score-v {
  font-size: 52rpx; font-weight: 800; line-height: 1;
  color: var(--gold-bright); font-variant-numeric: tabular-nums;
}
.card-score-sep { color: var(--text-faint); font-size: 36rpx; margin: 0 8rpx; }
.card-score-half {
  flex-basis: 100%; text-align: center; margin-top: 8rpx;
  font-size: 20rpx; color: var(--text-faint); font-weight: 600; white-space: nowrap;
}

/* 完场状态徽章 */
.card-status { margin-left: auto; font-size: 22rpx; font-weight: 600; }
.card-status--done {
  color: var(--green); padding: 2rpx 16rpx;
  background: rgba(56, 211, 159, 0.12); border-radius: 12rpx;
}

/* 已结束卡片整体降调（赔率已成历史，弱化但仍可点看详情） */
.card--finished { opacity: 0.86; }
.card--finished .card-odds, .card--finished .card-hhad { opacity: 0.6; }

/* 胜平负三栏 */
.card-odds { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-bottom: 20rpx; }
.odd {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  padding: 16rpx 8rpx; background: var(--surface-2); border-radius: var(--radius-sm);
}
.odd-k { font-size: 22rpx; color: var(--text-faint); }
.odd-v { font-size: 32rpx; font-weight: 700; }
.card-odds--none {
  display: block; text-align: center; padding: 24rpx;
  color: var(--text-faint); font-size: 26rpx; margin-bottom: 20rpx;
}

/* 让球核心盘 */
.card-hhad {
  display: flex; align-items: center; gap: 16rpx;
  padding: 14rpx 20rpx; margin-bottom: 24rpx;
  background: rgba(79,140,255,0.06); border-radius: var(--radius-sm); font-size: 26rpx;
}
.hhad-label { color: var(--text-dim); font-weight: 600; }
.hhad-v { font-weight: 600; color: var(--text); }
.hhad-v:first-of-type { margin-left: auto; }

/* 底部：标签 + 方案徽章 */
.card-foot {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx; flex-wrap: wrap;
}
.card-plan-badge { font-size: 22rpx; color: var(--green); font-weight: 600; white-space: nowrap; }

/* 价值标签 */
.tags { display: flex; gap: 12rpx; flex-wrap: wrap; }
.tag {
  font-size: 22rpx; font-weight: 600; padding: 6rpx 18rpx;
  border-radius: 40rpx; border: 1rpx solid var(--border);
  background: var(--surface-2); white-space: nowrap; color: var(--text-dim);
}
.tag--hot { color: var(--hot); border-color: rgba(255,107,91,0.3); }
.tag--even { color: var(--cold); border-color: rgba(91,184,255,0.3); }
.tag--draw { color: var(--draw); border-color: rgba(184,144,255,0.3); }
.tag--under { color: var(--text-dim); }

/* 免责声明 */
.disclaimer {
  margin-top: 48rpx; padding: 28rpx 36rpx; text-align: center;
  font-size: 24rpx; color: var(--text-faint);
  background: var(--surface); border: 1rpx solid var(--border); border-radius: var(--radius-sm);
}

/* ── 返回顶部 ── */
.back-top {
  position: fixed; right: 32rpx; bottom: 64rpx; z-index: 30;
  width: 88rpx; height: 88rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface-2); border: 1rpx solid var(--border-hi);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.4);
  opacity: 0; transform: translateY(20rpx) scale(0.9);
  pointer-events: none; transition: opacity .25s ease, transform .25s ease;
}
.back-top.show {
  opacity: 1; transform: translateY(0) scale(1);
  pointer-events: auto;
}
.back-top-icon {
  font-size: 44rpx; font-weight: 700; color: var(--gold);
  line-height: 1;
}

/* ── 详情覆盖层：全屏滑入 ── */
.detail-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 40;
  background: rgba(0,0,0,0.6); opacity: 0; transition: opacity 0.26s;
}
.detail-mask.show { opacity: 1; }
.detail-panel {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 50;
  background: #0d1322; overflow-y: auto;
  transform: translateY(100%); transition: transform 0.28s cubic-bezier(.4,0,.2,1);
}
.detail-panel.show { transform: translateY(0); }
.detail-inner { padding: 40rpx 32rpx 80rpx; position: relative; }

/* 关闭按钮 */
.detail-close {
  position: fixed; top: 32rpx; right: 36rpx; z-index: 2;
  width: 68rpx; height: 68rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface-2); border: 1rpx solid var(--border);
  color: var(--text-dim); border-radius: 50%; font-size: 32rpx;
}

/* 对阵头 */
.detail-head { text-align: center; padding-bottom: 40rpx; border-bottom: 1rpx solid var(--border); }
.detail-meta { font-size: 24rpx; color: var(--text-faint); }
.detail-teams { display: flex; align-items: center; justify-content: center; gap: 48rpx; margin-top: 32rpx; }
.dteam { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.dteam .team-logo { width: 112rpx; height: 112rpx; }
.dteam text { font-size: 32rpx; font-weight: 700; }
.dvs { font-size: 26rpx; color: var(--text-faint); font-weight: 700; }

/* 详情正文：单栏堆叠 */
.detail-body { margin-top: 8rpx; }
.sec-title {
  font-size: 30rpx; font-weight: 700; margin-bottom: 24rpx;
  display: flex; align-items: baseline; gap: 16rpx;
}
.sec-note { font-size: 22rpx; font-weight: 400; color: var(--text-faint); }
.detail-analysis { padding: 36rpx 0; }
.detail-comment { padding: 36rpx 0; border-top: 1rpx solid var(--border); }
.detail-odds { padding: 36rpx 0; border-top: 1rpx solid var(--border); }

/* 去水概率三色条 */
.prob-bar {
  display: flex; height: 64rpx; border-radius: 16rpx; overflow: hidden;
  margin: 24rpx 0; font-size: 24rpx; font-weight: 600;
}
.prob-seg {
  display: flex; align-items: center; justify-content: center;
  color: #fff; white-space: nowrap; overflow: hidden; min-width: 0;
}
.prob-h { background: rgba(255,107,91,0.75); }
.prob-d { background: rgba(184,144,255,0.75); }
.prob-a { background: rgba(91,184,255,0.75); }
.na-hint { font-size: 26rpx; color: var(--text-faint); padding: 16rpx 0; display: block; }

/* 返还率徽章 */
.ret-badges { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.ret-badge { font-size: 22rpx; font-weight: 600; padding: 8rpx 20rpx; border-radius: 14rpx; border: 1rpx solid var(--border); }
.ret-high { color: var(--green); border-color: rgba(56,211,159,0.3); background: rgba(56,211,159,0.08); }
.ret-mid  { color: var(--yellow); border-color: rgba(242,193,78,0.3); background: rgba(242,193,78,0.08); }
.ret-low  { color: var(--red); border-color: rgba(255,107,91,0.3); background: rgba(255,107,91,0.08); }

/* 点评 */
.comment--empty { color: var(--text-faint); font-size: 26rpx; padding: 16rpx 0; }
.comment-summary { font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; display: block; }
.comment-value {
  font-size: 26rpx; color: var(--text-dim); line-height: 1.6;
  padding: 20rpx 24rpx; background: rgba(79,140,255,0.06);
  border-radius: var(--radius-sm); border-left: 4rpx solid var(--accent); display: block;
}

/* 购买方案 */
.plan {
  margin-top: 28rpx; padding: 28rpx; background: var(--surface);
  border: 1rpx solid var(--border); border-radius: var(--radius-sm);
}
.plan-head { font-size: 26rpx; font-weight: 700; color: var(--green); margin-bottom: 20rpx; }
.bet-list { display: flex; flex-direction: column; gap: 16rpx; }
.bet {
  display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap;
  font-size: 24rpx; padding: 16rpx 20rpx; background: var(--surface-2); border-radius: 16rpx;
}
.bet-market { font-weight: 700; }
.bet-odds { color: var(--accent); font-weight: 600; }
.bet-stake { color: var(--text-dim); margin-left: auto; }
.bet-potential { color: var(--green); font-weight: 600; }
.plan-note { font-size: 24rpx; color: var(--text-dim); margin-top: 20rpx; line-height: 1.6; display: block; }
.plan-warn {
  font-size: 22rpx; color: var(--red); margin-top: 20rpx;
  padding-top: 20rpx; border-top: 1rpx solid var(--border); display: block;
}

/* 玩法行 */
.orow { display: flex; gap: 24rpx; padding: 20rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.05); }
.orow-label { flex: 0 0 144rpx; font-size: 26rpx; font-weight: 600; color: var(--text-dim); padding-top: 4rpx; }
.orow-cells { display: flex; flex-wrap: wrap; gap: 12rpx; flex: 1; }
.orow-cell {
  display: inline-flex; flex-direction: column; align-items: center;
  gap: 2rpx; padding: 8rpx 16rpx; background: var(--surface-2);
  border-radius: 14rpx; min-width: 92rpx;
}
.orow-cell-i { font-size: 20rpx; color: var(--text-faint); }
.orow-cell-b { font-size: 26rpx; font-weight: 700; color: var(--text); }
/* 赔率色温 */
.orow-cell.heat-5 .orow-cell-b { color: #ff5b47; }
.orow-cell.heat-4 .orow-cell-b { color: #ff9d66; }
.orow-cell.heat-3 .orow-cell-b { color: var(--text); }
.orow-cell.heat-2 .orow-cell-b { color: #7fb8e8; }
.orow-cell.heat-1 .orow-cell-b { color: #5d7fa8; }
.orow-cell--hot { background: rgba(255,91,71,0.14); box-shadow: inset 0 0 0 2rpx rgba(255,91,71,0.35); }

/* 玩法区块（比分） */
.odds-block { padding: 32rpx 0 0; }
.odds-block-title { font-size: 26rpx; font-weight: 600; color: var(--text-dim); margin-bottom: 20rpx; }
.block-hint { font-size: 20rpx; font-weight: 400; color: var(--text-faint); margin-left: 12rpx; }

/* 比分热力矩阵 */
.matrix-scroll { width: 100%; }
.matrix { display: inline-flex; flex-direction: column; gap: 6rpx; }
.matrix-row { display: flex; gap: 6rpx; }
.matrix-head { margin-bottom: 2rpx; }
.matrix-th {
  font-size: 20rpx; font-weight: 600; color: var(--text-faint);
  width: 72rpx; text-align: center; display: flex; align-items: center; justify-content: center;
}
.matrix-corner { font-size: 18rpx; }
.matrix-td {
  font-size: 22rpx; font-weight: 700; text-align: center;
  width: 72rpx; height: 56rpx; line-height: 56rpx; border-radius: 10rpx;
  background: var(--surface-2); color: var(--text);
}
.matrix-td.cell--empty { background: transparent; color: var(--text-faint); font-weight: 400; }
.matrix-td.heat-5 { background: rgba(255,91,71,0.32); color: #fff; }
.matrix-td.heat-4 { background: rgba(255,140,90,0.22); }
.matrix-td.heat-3 { background: rgba(255,255,255,0.07); }
.matrix-td.heat-2 { background: rgba(91,160,230,0.14); color: #bbccdd; }
.matrix-td.heat-1 { background: rgba(70,110,160,0.12); color: #88aaaa; }
.matrix-td.cell--hot { box-shadow: inset 0 0 0 3rpx rgba(255,255,255,0.55); }

/* 比分"其它" */
.crs-others { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.crs-other {
  display: inline-flex; flex-direction: column; align-items: center; gap: 2rpx;
  padding: 8rpx 16rpx; background: var(--surface-2); border-radius: 14rpx;
}
.crs-other-i { font-size: 20rpx; color: var(--text-faint); }
.crs-other-b { font-size: 24rpx; font-weight: 700; }
.crs-other.heat-5 .crs-other-b { color: #ff5b47; }
.crs-other.heat-4 .crs-other-b { color: #ff9d66; }
.crs-other.heat-2 .crs-other-b { color: #7fb8e8; }
.crs-other.heat-1 .crs-other-b { color: #5d7fa8; }




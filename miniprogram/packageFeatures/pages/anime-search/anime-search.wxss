.page {
  min-height: 100vh;
  background: var(--td-bg-color-page, #f3f3f3);
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

/* t-search 独占整行，「搜索」用组件原生 action 内置在框右端（见 wxml），不再外挂按钮 */
.search-bar t-search {
  display: block;
}

.cache-flag {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder, #bbb);
  padding: 12rpx 8rpx 0;
}

.state-box {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 160rpx;
}

.result-list {
  margin-top: 16rpx;
}

.result-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: var(--td-bg-color-container, #fff);
  border-radius: 16rpx;
}

.cover {
  width: 96rpx;
  height: 128rpx; /* 3:4 海报比例，与两行内容高度协调 */
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--td-bg-color-component, #e7e7e7); /* 图未加载/失败时的灰块占位底 */
}

.info {
  flex: 1;
  min-width: 0; /* 让 title 能正常省略 */
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #000);
  /* 放两行再省略：JOJO 等系列靠「星尘斗士/埃及篇」后缀区分季度，单行截断会切掉选季关键信息 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  margin-top: 12rpx;
}

.meta {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
}

/* 评分行内化：与类型/年份/集数同一行，不再单独占行 */
.rating {
  font-size: 24rpx;
  color: var(--td-warning-color, #e37318);
}

.arrow {
  font-size: 40rpx;
  color: var(--td-text-color-placeholder, #ccc);
  flex-shrink: 0;
}

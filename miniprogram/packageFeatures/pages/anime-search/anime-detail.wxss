.page {
  min-height: 100vh;
  background: var(--td-bg-color-page, #f3f3f3);
  padding: 24rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: var(--td-bg-color-container, #fff);
  border-radius: 20rpx;
}

.cover-wrap {
  position: relative;
  width: 200rpx;
  height: 280rpx;
  flex-shrink: 0;
}

.hero .cover {
  width: 200rpx;
  height: 280rpx;
  border-radius: 16rpx;
  background: var(--td-bg-color-component, #e7e7e7);
}

/* 右下角放大提示图标：告诉用户封面可点看大图 */
.cover-zoom {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 8rpx;
}

.hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--td-text-color-primary, #000);
}

.ep {
  font-size: 26rpx;
  color: var(--td-text-color-secondary, #888);
}

.rating {
  font-size: 26rpx;
  color: var(--td-warning-color, #e37318);
}

.air-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.air-day {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
}

.loading-box,
.error-box {
  display: flex;
  justify-content: center;
  padding: 60rpx;
}

.error-box {
  font-size: 26rpx;
  color: var(--td-text-color-placeholder, #bbb);
}

.section {
  margin-top: 24rpx;
}

.section-block {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--td-bg-color-container, #fff);
  border-radius: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--td-text-color-primary, #000);
  margin-bottom: 12rpx;
}

.summary {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--td-text-color-secondary, #555);
}

.meta-line {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
  margin-top: 8rpx;
}

/* 类型 · 年份行 */
.type-line {
  font-size: 26rpx;
  color: var(--td-text-color-secondary, #888);
}

/* 首播日期行 */
.air-date-line {
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #888);
}

/* 标签气泡容器 */
.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  margin: 0;
}

/* 分集标题逐行 */
.ep-title {
  font-size: 26rpx;
  line-height: 1.9;
  color: var(--td-text-color-secondary, #555);
}

/* 相关/相似 横滑卡 */
.ref-scroll {
  white-space: nowrap;
  width: 100%;
}

.ref-card {
  display: inline-block;
  width: 180rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.ref-card:last-child {
  margin-right: 0;
}

.ref-cover {
  width: 180rpx;
  height: 252rpx;
  border-radius: 12rpx;
  background: var(--td-bg-color-component, #e7e7e7);
}

.ref-name {
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--td-text-color-primary, #000);
  margin-top: 8rpx;
  /* 番名最多两行，超出省略 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal;
}

.ref-rating {
  font-size: 22rpx;
  color: var(--td-warning-color, #e37318);
  margin-top: 4rpx;
}

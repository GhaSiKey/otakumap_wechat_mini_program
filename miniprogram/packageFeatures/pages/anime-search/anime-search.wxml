<view class="page">
  <!-- 搜索框：用组件原生 action 把「搜索」放进框右端，只占文案宽度不与输入框平分屏幕。
       回车/键盘搜索键走 submit，点右端「搜索」走 action-click，两条路径都发起查询 -->
  <view class="search-bar">
    <t-search
      value="{{keyword}}"
      placeholder="输入番名，如 葬送的芙莉莲"
      action="搜索"
      bind:change="onSearchChange"
      bind:submit="onSearch"
      bind:action-click="onSearch"
    />
  </view>

  <!-- pick 模式引导条：明确「点一部就选中带回」，区别于 normal 模式的「点进详情」 -->
  <view wx:if="{{isPick && animes.length}}" class="pick-hint">
    <t-icon name="check-circle" size="32rpx" />
    <text>{{pickCopy.TOP_HINT}}</text>
  </view>

  <!-- 命中缓存提示（验收期观察缓存用，接入正式流程后可撤） -->
  <view wx:if="{{fromCache && animes.length}}" class="cache-flag">已命中缓存（6h 内不重复请求上游）</view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="state-box">
    <t-loading theme="circular" size="40rpx" text="{{hint}}" />
  </view>

  <!-- 空态 / 错误提示 -->
  <view wx:elif="{{!animes.length}}" class="state-box">
    <t-empty description="{{hint}}" />
  </view>

  <!-- 结果列表 -->
  <view wx:else class="result-list">
    <view
      wx:for="{{animes}}"
      wx:key="sourceId"
      class="result-item"
      data-id="{{item.sourceId}}"
      data-name="{{item.name}}"
      data-cover="{{item.cover}}"
      data-totalep="{{item.totalEp}}"
      data-typedesc="{{item.typeDesc}}"
      data-year="{{item.year}}"
      data-startdate="{{item.startDate}}"
      bind:tap="onTapItem"
    >
      <image class="cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
      <view class="info">
        <view class="title">{{item.name}}</view>
        <!-- 类型/年份/集数/评分并作一行：卡片从三行压到两行更紧凑，评分不再单独占行 -->
        <view class="tags">
          <t-tag wx:if="{{item.typeDesc}}" size="small" variant="light" theme="primary">{{item.typeDesc}}</t-tag>
          <text wx:if="{{item.year}}" class="meta">{{item.year}}</text>
          <text class="meta">{{item.totalEp ? item.totalEp + ' 集' : epUnknownLabel}}</text>
          <text wx:if="{{item.rating}}" class="rating">★ {{item.rating}}</text>
        </view>
      </view>
      <!-- 右侧动作：pick 模式显示「选择」标签（点了就带回），normal 模式显示 › 进详情 -->
      <view wx:if="{{isPick}}" class="pick-action">{{pickCopy.ACTION}}</view>
      <text wx:else class="arrow">›</text>
    </view>
  </view>
</view>

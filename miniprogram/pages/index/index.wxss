page {
  background-color: #f3f3f3;
}

@media (prefers-color-scheme: dark) {
  page {
    background-color: #181818;
  }
}

.page {
  min-height: 100vh;
  padding: 0 32rpx;
}

/* ─── 头部 ─── */
.header {
  padding: 80rpx 0 48rpx;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: rgba(0, 0, 0, 0.9);
  line-height: 1.3;
}

.header-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.6);
  margin-top: 8rpx;
}

@media (prefers-color-scheme: dark) {
  .header-title {
    color: rgba(255, 255, 255, 0.9);
  }
  .header-subtitle {
    color: rgba(255, 255, 255, 0.55);
  }
}

/* ─── 功能卡片 ─── */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  transition: transform 0.15s ease;
}

.feature-card:active {
  transform: scale(0.98);
}

@media (prefers-color-scheme: dark) {
  .feature-card {
    background-color: #242424;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }
}

.feature-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background-color: #f2f3ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

@media (prefers-color-scheme: dark) {
  .feature-icon-wrap {
    background-color: #1b2f51;
  }
}

.feature-icon-text {
  font-size: 40rpx;
}

.feature-info {
  flex: 1;
  margin: 0 16rpx;
}

.feature-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
  line-height: 1.4;
}

.feature-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.6);
  margin-top: 4rpx;
  line-height: 1.4;
}

.feature-arrow {
  font-size: 40rpx;
  color: rgba(0, 0, 0, 0.26);
  flex-shrink: 0;
}

@media (prefers-color-scheme: dark) {
  .feature-title {
    color: rgba(255, 255, 255, 0.9);
  }
  .feature-desc {
    color: rgba(255, 255, 255, 0.55);
  }
  .feature-arrow {
    color: rgba(255, 255, 255, 0.35);
  }
}

/* 首页视觉 tokens：轻纸张底、深蓝墨色、少量珊瑚色点缀。 */
page {
  height: 100%;
  overflow: hidden;
  background-color: #faf9f5;
  color: #11295c;
}

.page {
  position: relative;
  box-sizing: border-box;
  height: 100%;
  min-height: 0;
  --index-motion-card-fade: 0.56s;
  --index-motion-card-rise: 0.68s;
  --index-motion-header: 0.62s;
  --index-motion-wordmark: 0.72s;
  --index-motion-sticker-left: 6.8s;
  --index-motion-sticker-right: 7.4s;
  --index-motion-spark: 3.8s;
  --index-motion-sticker-left-delay: 0.15s;
  --index-motion-sticker-right-delay: 0.35s;
  --index-motion-spark-delay-1: 0.2s;
  --index-motion-spark-delay-2: 1.2s;
  --index-motion-spark-delay-3: 2s;
  --index-motion-spark-delay-4: 2.8s;
  --index-motion-card-delay-1: 0.06s;
  --index-motion-card-delay-2: 0.14s;
  --index-motion-card-delay-3: 0.22s;
  --index-motion-card-delay-4: 0.30s;
  --index-motion-card-delay-5: 0.40s;
  padding: 0 32rpx 88rpx;
  padding-bottom: calc(88rpx + env(safe-area-inset-bottom, 0px));
  overflow: hidden;
}

/* ─── 透明自绘导航栏 ───
   navigationStyle=custom 后页面会铺到物理屏幕顶部，标题只占文字像素，
   背后的纸片、网格和状态栏底色可以自然透出来；右上角胶囊仍由微信绘制。 */
.index-navbar {
  position: absolute;
  z-index: 3;
  top: 0;
  right: 0;
  left: 0;
  pointer-events: none;
}

.index-navbar__title {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  display: block;
  overflow: hidden;
  color: rgba(17, 17, 17, 0.92);
  font-family: PingFang SC, Microsoft YaHei, sans-serif;
  font-size: 34rpx;
  font-weight: 500;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ─── 顶部纸张氛围层 ───
   装饰全部绝对定位，不参与页面高度计算；这样短屏仍能保持首屏不滚动。 */
.header-ambient {
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  left: 0;
  /* 自定义导航栏占用顶部空间后，保持素材覆盖原先完整的头部区域。 */
  height: calc(500rpx + var(--index-navbar-height, 0px));
  overflow: hidden;
  pointer-events: none;
}

.header-banner {
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 500rpx;
  opacity: 0.82;
  transform-origin: center top;
  animation: indexBannerDrift 10s ease-in-out infinite alternate;
}

.header-ambient__wash,
.header-ambient__grid {
  position: absolute;
  z-index: 1;
  top: -24rpx;
  right: -16rpx;
  bottom: 0;
  left: -16rpx;
  pointer-events: none;
}

.header-ambient__wash {
  background:
    radial-gradient(circle at 18% 18%, rgba(71, 123, 217, 0.15), transparent 31%),
    radial-gradient(circle at 84% 16%, rgba(242, 118, 112, 0.12), transparent 33%);
  animation: indexAmbientBreath 7s ease-in-out infinite alternate;
}

.header-ambient__grid {
  top: -18rpx;
  height: 500rpx;
  /* banner 已内置连续纸张网格，这层只负责轻微漂移动效，避免双层网格过重。 */
  opacity: 0.08;
  background-image:
    linear-gradient(rgba(71, 123, 217, 0.18) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(71, 123, 217, 0.18) 1rpx, transparent 1rpx);
  background-size: 34rpx 34rpx;
  transform: rotate(-2deg) scale(1.12);
  transform-origin: center top;
  animation: indexGridDrift 10s ease-in-out infinite alternate;
}

.header-sticker {
  position: absolute;
  display: block;
  height: 300rpx;
  opacity: 0.76;
  pointer-events: none;
}

.header-sticker--left {
  top: -22rpx;
  left: -18rpx;
  width: 186rpx;
  animation: indexStickerLeft var(--index-motion-sticker-left) ease-in-out var(--index-motion-sticker-left-delay) infinite alternate;
}

.header-sticker--right {
  top: -26rpx;
  right: -14rpx;
  width: 150rpx;
  animation: indexStickerRight var(--index-motion-sticker-right) ease-in-out var(--index-motion-sticker-right-delay) infinite alternate;
}

.header-spark {
  position: absolute;
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  text-shadow: 0 3rpx 8rpx rgba(17, 41, 92, 0.12);
  transform-origin: center;
  animation: indexSparkTwinkle var(--index-motion-spark) ease-in-out infinite;
}

.header-spark--blue {
  color: #477bd9;
}

.header-spark--coral {
  color: #f27670;
}

.header-spark--yellow {
  color: #f2b638;
}

.header-spark--one {
  top: 108rpx;
  left: 86rpx;
  animation-delay: var(--index-motion-spark-delay-1);
}

.header-spark--two {
  top: 82rpx;
  right: 92rpx;
  font-size: 28rpx;
  animation-delay: var(--index-motion-spark-delay-2);
}

.header-spark--three {
  top: 218rpx;
  left: 214rpx;
  font-size: 24rpx;
  animation-delay: var(--index-motion-spark-delay-3);
}

.header-spark--four {
  top: 248rpx;
  right: 72rpx;
  font-size: 24rpx;
  animation-delay: var(--index-motion-spark-delay-4);
}

@keyframes indexAmbientBreath {
  0% {
    opacity: 0.72;
    transform: scale(0.98);
  }
  100% {
    opacity: 1;
    transform: scale(1.04);
  }
}

@keyframes indexGridDrift {
  0% { transform: rotate(-2deg) translateX(-8rpx) scale(1.12); }
  100% { transform: rotate(-1deg) translateX(8rpx) scale(1.12); }
}

@keyframes indexBannerDrift {
  0% { transform: translateY(-1rpx) scale(1.015); }
  100% { transform: translateY(3rpx) scale(1.035); }
}

@keyframes indexStickerLeft {
  0% { transform: translateY(-1rpx) rotate(-2.4deg); }
  100% { transform: translateY(6rpx) rotate(-0.8deg); }
}

@keyframes indexStickerRight {
  0% { transform: translateY(4rpx) rotate(2.2deg); }
  100% { transform: translateY(-2rpx) rotate(0.6deg); }
}

@keyframes indexSparkTwinkle {
  0%, 100% {
    opacity: 0.55;
    transform: scale(0.86) rotate(-8deg);
  }
  50% {
    opacity: 1;
    transform: scale(1.12) rotate(8deg);
  }
}

@keyframes indexHeaderIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes indexWordmarkIn {
  0% {
    opacity: 0;
    transform: translateY(-8rpx) scale(0.96);
  }
  70% {
    opacity: 1;
    transform: translateY(1rpx) scale(1.015);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ─── 可爱风品牌头部 ─── */
.header {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 34rpx;
  animation: indexHeaderIn var(--index-motion-header) cubic-bezier(0.22, 0.82, 0.24, 1) both;
}

.wordmark {
  display: block;
  width: 510rpx;
  height: 192rpx;
  animation: indexWordmarkIn var(--index-motion-wordmark) cubic-bezier(0.22, 0.82, 0.24, 1) 0.04s both;
}

.header-subtitle {
  display: block;
  margin-top: -8rpx;
  color: #17345c;
  font-family: PingFang SC, Microsoft YaHei, sans-serif;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  line-height: 1.35;
  text-indent: 8rpx;
}

.header-rule {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 210rpx;
  margin-top: 22rpx;
}

.header-rule__line {
  height: 4rpx;
  border-radius: 999px;
  flex: 1;
}

.header-rule__line--blue {
  background-color: #477bd9;
}

.header-rule__line--coral {
  background-color: #f27670;
}

/* ─── 图片卡片网格 ─── */
.feature-grid {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  row-gap: 22rpx;
}

.feature-card {
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  background-color: #ffffff;
  border: 2rpx solid rgba(17, 41, 92, 0.09);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(17, 41, 92, 0.09);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.feature-card--grid {
  width: calc((100% - 20rpx) / 2);
}

.feature-card--pressed {
  box-shadow: 0 3rpx 9rpx rgba(17, 41, 92, 0.08);
  transform: scale(0.985);
}

/* ─── 首屏卡片入场 ───
   外层只淡入，内容层负责上浮，避免和卡片 hover-class 的缩放互相覆盖。 */
.feature-card--enter {
  animation: indexCardFadeIn var(--index-motion-card-fade) ease-out both;
}

.feature-card--enter-1 { animation-delay: var(--index-motion-card-delay-1); }
.feature-card--enter-2 { animation-delay: var(--index-motion-card-delay-2); }
.feature-card--enter-3 { animation-delay: var(--index-motion-card-delay-3); }
.feature-card--enter-4 { animation-delay: var(--index-motion-card-delay-4); }
.feature-card--enter-5 { animation-delay: var(--index-motion-card-delay-5); }

.feature-card__motion {
  animation: indexCardRiseIn var(--index-motion-card-rise) cubic-bezier(0.22, 0.82, 0.24, 1) both;
}

.feature-card--enter-1 .feature-card__motion {
  animation-delay: var(--index-motion-card-delay-1);
}

.feature-card--enter-2 .feature-card__motion {
  animation-delay: var(--index-motion-card-delay-2);
}

.feature-card--enter-3 .feature-card__motion {
  animation-delay: var(--index-motion-card-delay-3);
}

.feature-card--enter-4 .feature-card__motion {
  animation-delay: var(--index-motion-card-delay-4);
}

.feature-card--enter-5 .feature-card__motion {
  animation-delay: var(--index-motion-card-delay-5);
}

@keyframes indexCardFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes indexCardRiseIn {
  0% {
    opacity: 0;
    transform: translateY(24rpx) scale(0.975);
  }
  70% {
    opacity: 1;
    transform: translateY(-2rpx) scale(1.005);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.feature-media {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 218rpx;
  padding: 14rpx 14rpx 4rpx;
}

.feature-media--blue {
  background-color: #eef4ff;
}

.feature-media--coral {
  background-color: #fff1ef;
}

.feature-media--yellow {
  background-color: #fff8e8;
}

.feature-media--mint {
  background-color: #eff8f1;
}

.feature-image {
  display: block;
  width: 100%;
  height: 100%;
}

.feature-body {
  box-sizing: border-box;
  min-height: 166rpx;
  padding: 22rpx 26rpx 24rpx;
}

.feature-title,
.feature-desc {
  display: block;
  overflow: hidden;
  padding-right: 64rpx;
  text-overflow: ellipsis;
}

.feature-title {
  color: #11295c;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  white-space: nowrap;
}

.feature-desc {
  display: -webkit-box;
  height: 70rpx;
  margin-top: 8rpx;
  color: rgba(17, 41, 92, 0.66);
  font-size: 24rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.feature-arrow {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #477bd9;
  box-shadow: 0 4rpx 10rpx rgba(71, 123, 217, 0.28);
}

.feature-card--coral .feature-arrow {
  background-color: #f27670;
  box-shadow: 0 4rpx 10rpx rgba(242, 118, 112, 0.24);
}

.feature-card--yellow .feature-arrow {
  background-color: #f2b638;
  box-shadow: 0 4rpx 10rpx rgba(242, 182, 56, 0.24);
}

.feature-card--mint .feature-arrow {
  background-color: #69a982;
  box-shadow: 0 4rpx 10rpx rgba(105, 169, 130, 0.24);
}

.feature-arrow__chevron {
  width: 18rpx;
  height: 18rpx;
  margin-left: -6rpx;
  border-top: 5rpx solid #ffffff;
  border-right: 5rpx solid #ffffff;
  transform: rotate(45deg);
}

/* ─── 共享追番板横向大卡 ─── */
.wide-list {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
}

.feature-card--wide {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 272rpx;
  padding: 18rpx 24rpx 18rpx 18rpx;
}

.feature-card--wide > .feature-card__motion {
  display: flex;
  align-items: center;
  flex: 1;
  width: 100%;
  min-width: 0;
}

.wide-media {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 42%;
  height: 232rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.wide-body {
  box-sizing: border-box;
  min-width: 0;
  flex: 1;
  padding: 4rpx 58rpx 4rpx 24rpx;
}

.feature-card--wide .feature-title {
  font-size: 36rpx;
}

.feature-card--wide .feature-desc {
  height: 72rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
}

.feature-card--wide .feature-arrow {
  right: 24rpx;
  bottom: 50%;
  transform: translateY(50%);
}

@media (prefers-color-scheme: dark) {
  page,
  .page {
    /* 与 theme.json / app.wxss 的深色页面底色保持一致，避免顶部导航栏色差。 */
    background-color: #181818;
    color: rgba(255, 255, 255, 0.9);
  }

  .header-subtitle {
    color: #d7e8ff;
  }

  .index-navbar__title {
    color: rgba(255, 255, 255, 0.92);
  }

  .header-rule__line--blue {
    background-color: #699ef5;
  }

  .header-rule__line--coral {
    background-color: #ff9285;
  }

  .feature-card {
    background-color: #242a3b;
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.24);
  }

  .feature-media--blue {
    background-color: #1d355d;
  }

  .feature-media--coral {
    background-color: #4a2c35;
  }

  .feature-media--yellow {
    background-color: #4a3b28;
  }

  .feature-media--mint {
    background-color: #274238;
  }

  .feature-title {
    color: rgba(255, 255, 255, 0.94);
  }

  .feature-desc {
    color: rgba(255, 255, 255, 0.62);
  }

  .header-ambient__wash {
    background:
      radial-gradient(circle at 18% 18%, rgba(105, 158, 245, 0.14), transparent 31%),
      radial-gradient(circle at 84% 16%, rgba(255, 146, 133, 0.1), transparent 33%);
  }

  .header-banner {
    opacity: 0.1;
  }

  .header-ambient__grid {
    opacity: 0.1;
    background-image:
      linear-gradient(rgba(105, 158, 245, 0.24) 1rpx, transparent 1rpx),
      linear-gradient(90deg, rgba(105, 158, 245, 0.24) 1rpx, transparent 1rpx);
  }

  .header-sticker {
    opacity: 0.08;
  }

  .header-spark {
    text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.32);
  }

  .header-spark--blue {
    color: #8cb8ff;
  }

  .header-spark--coral {
    color: #ff9c91;
  }

  .header-spark--yellow {
    color: #ffd16a;
  }
}

@media (max-width: 340px) {
  .page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .feature-card--grid {
    width: calc((100% - 16rpx) / 2);
  }

  .feature-media {
    height: 198rpx;
    padding-right: 8rpx;
    padding-left: 8rpx;
  }

  .feature-body {
    padding-right: 18rpx;
    padding-left: 18rpx;
  }

  .feature-title,
  .feature-desc {
    padding-right: 50rpx;
  }

  .feature-title {
    font-size: 30rpx;
  }

  .feature-card--wide .feature-title {
    font-size: 32rpx;
  }
}

/* JS 读取到窗口高度时直接使用 class，避免依赖不同基础库对 vh/media query 的口径。 */
.page.page--compact {
  padding-bottom: 56rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom, 0px));
}

.page.page--compact .header {
  padding-top: 24rpx;
  padding-bottom: 22rpx;
}

.page.page--compact .wordmark {
  height: 164rpx;
}

.page.page--compact .header-rule {
  margin-top: 14rpx;
}

.page.page--compact .feature-grid,
.page.page--compact .wide-list {
  row-gap: 14rpx;
}

.page.page--compact .feature-media {
  height: 198rpx;
}

.page.page--compact .feature-body {
  min-height: 146rpx;
  padding-top: 16rpx;
  padding-bottom: 18rpx;
}

.page.page--compact .feature-desc {
  height: 64rpx;
  margin-top: 6rpx;
}

.page.page--compact .wide-list {
  margin-top: 14rpx;
}

.page.page--compact .feature-card--wide {
  min-height: 240rpx;
  padding-top: 14rpx;
  padding-bottom: 14rpx;
}

.page.page--compact .wide-media {
  height: 204rpx;
}

.page.page--tiny {
  padding-right: 24rpx;
  padding-bottom: 36rpx;
  padding-left: 24rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom, 0px));
}

.page.page--tiny .header {
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}

.page.page--tiny .wordmark {
  width: 440rpx;
  height: 132rpx;
}

.page.page--tiny .header-subtitle {
  font-size: 28rpx;
}

.page.page--tiny .header-rule {
  width: 180rpx;
  margin-top: 10rpx;
}

.page.page--tiny .feature-grid,
.page.page--tiny .wide-list {
  row-gap: 8rpx;
}

.page.page--tiny .feature-media {
  height: 164rpx;
  padding-top: 8rpx;
}

.page.page--tiny .feature-body {
  min-height: 112rpx;
  padding: 12rpx 16rpx 12rpx;
}

.page.page--tiny .feature-title {
  font-size: 28rpx;
}

.page.page--tiny .feature-desc {
  height: 52rpx;
  margin-top: 4rpx;
  font-size: 22rpx;
}

.page.page--tiny .feature-arrow {
  right: 16rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
}

.page.page--tiny .feature-card--wide .feature-arrow {
  right: 16rpx;
  bottom: 50%;
  transform: translateY(50%);
}

.page.page--tiny .wide-list {
  margin-top: 8rpx;
}

.page.page--tiny .feature-card--wide {
  min-height: 180rpx;
  padding: 10rpx 16rpx 10rpx 12rpx;
}

.page.page--tiny .wide-media {
  height: 160rpx;
}

.page.page--tiny .wide-body {
  padding-right: 48rpx;
  padding-left: 16rpx;
}

.page.page--tiny .feature-card--wide .feature-title {
  font-size: 30rpx;
}

.page.page--tiny .feature-card--wide .feature-desc {
  height: 52rpx;
  font-size: 22rpx;
}

/* 尊重系统“减少动态”：保留最终布局和内容，关闭装饰循环与入场位移。 */
@media (prefers-reduced-motion: reduce) {
  .header,
  .wordmark,
  .feature-card--enter,
  .feature-card__motion {
    animation: none;
    opacity: 1;
    transform: none;
  }

  .header-ambient__wash,
  .header-ambient__grid,
  .header-banner,
  .header-sticker,
  .header-spark {
    animation: none;
    transform: none;
  }

  .feature-card {
    transition: none;
  }

}
